# --- Terminal Color & Styling Utilities ---

class Ansi:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    UNDERLINE = "\033[4m"

    # Standard Colors
    BLACK = "\033[30m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"

    # Bright Colors
    BRIGHT_BLACK = "\033[90m"
    BRIGHT_RED = "\033[91m"
    BRIGHT_GREEN = "\033[92m"
    BRIGHT_YELLOW = "\033[93m"
    BRIGHT_BLUE = "\033[94m"
    BRIGHT_MAGENTA = "\033[95m"
    BRIGHT_CYAN = "\033[96m"
    BRIGHT_WHITE = "\033[97m"

    # Cursor & Screen Controls
    CURSOR_HIDE = "\033[?25l"
    CURSOR_SHOW = "\033[?25h"
    CLEAR_SCREEN = "\033[2J"
    CLEAR_LINE = "\033[K"
    CLEAR_TO_END = "\033[J"
    ENTER_ALT_SCREEN = "\033[?1049h"
    EXIT_ALT_SCREEN = "\033[?1049l"
    HOME = "\033[H"

COLOR_ENABLED = sys.stdout.isatty() and "NO_COLOR" not in os.environ

def c(text: str, *styles: str) -> str:
    """Wraps text in ANSI styles if color is enabled."""
    if not COLOR_ENABLED or not styles:
        return text
    prefix = "".join(styles)
    return f"{prefix}{text}{Ansi.RESET}"

ANSI_REGEX = re.compile(r'\x1b\[[0-9;?]*[a-zA-Z]')

def strip_ansi(text: str) -> str:
    """Strips ANSI escape sequences to obtain raw text."""
    return ANSI_REGEX.sub('', text)

def visible_width(text: str) -> int:
    """Calculates true character cell width in a monospaced terminal."""
    plain = strip_ansi(text)
    return sum(2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1 for ch in plain)

def fit_cell(text: str, width: int, align: str = "<") -> str:
    """Pads, aligns, or truncates text to exact visual cell width, accounting for ANSI escape sequences."""
    vlen = visible_width(text)
    if vlen > width:
        clean = re.sub(r'\x1b\[[0-9;]*m', '', text)
        if len(clean) == len(text):
            return text[:width - 1] + "…" if width > 1 else text[:width]
        else:
            cur_w = 0
            res = []
            tokens = re.split(r'(\x1b\[[0-9;]*m)', text)
            for token in tokens:
                if not token:
                    continue
                if token.startswith('\x1b['):
                    res.append(token)
                else:
                    for ch in token:
                        ch_w = 2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1
                        if cur_w + ch_w > width - 1:
                            res.append('…')
                            res.append(Ansi.RESET)
                            cur_w += 1
                            break
                        res.append(ch)
                        cur_w += ch_w
                    if cur_w >= width:
                        break
            pad = max(0, width - cur_w)
            return "".join(res) + (" " * pad)

    pad = max(0, width - vlen)
    if align == ">":
        return (" " * pad) + text
    elif align == "^":
        pad_l = pad // 2
        pad_r = pad - pad_l
        return (" " * pad_l) + text + (" " * pad_r)
    else:
        return text + (" " * pad)

def pct_color(percent: float) -> str:
    """Returns an adaptive ANSI color based on workload saturation."""
    if percent >= 85.0:
        return Ansi.BRIGHT_RED
    if percent >= 70.0:
        return Ansi.BRIGHT_YELLOW
    if percent >= 50.0:
        return Ansi.BRIGHT_CYAN
    return Ansi.BRIGHT_GREEN

def make_bar(percent: float, width: int = 10, color_override: Optional[str] = None) -> str:
    """Creates a high-contrast progress bar with a visible dim track."""
    percent = max(0.0, min(100.0, percent))
    filled_len = int(round(width * (percent / 100.0)))
    if percent > 0.5 and filled_len == 0:
        filled_len = 1
    empty_len = max(0, width - filled_len)
    bar_color = color_override or pct_color(percent)

    filled = "▰" * filled_len
    empty = "▱" * empty_len
    if COLOR_ENABLED:
        return f"{bar_color}{filled}{Ansi.RESET}{Ansi.DIM}{empty}{Ansi.RESET}"
    return f"{filled}{empty}"


SPARK_CHARS = "▁▂▃▄▅▆▇█"
_BRAILLE_LEFT = (0x00, 0x40, 0x44, 0x46, 0x47)
_BRAILLE_RIGHT = (0x00, 0x80, 0xA0, 0xB0, 0xB8)


def make_trend_visual(
    values: List[float],
    low: float,
    high: float,
    width: int = 10,
    color_style: str = Ansi.BRIGHT_GREEN,
    watch_mode: bool = False,
    graph_mode: str = "spark",
    adaptive_mode: str = "power",
    min_span: float = 10.0,
    color_fn=None,
) -> str:
    """
    Renders a real-time trend visual of exact visual cell width `width`:
    - snapshot mode (`not watch_mode` and <=1 sample): segmented progress bar (`make_bar`)
    - watch mode `spark` (default): adaptive-windowed block sparkline (`▁▂▃▄▅▆▇█`) + recency shading + trend arrow
    - watch mode `braille`: high-density 2-point-per-cell Braille waveform + recency shading + trend arrow
    - watch mode `gauge`: segmented capacity gauge bar + trend arrow
    """
    clean_vals = [float(v) for v in values if v is not None]
    if not clean_vals:
        return c("·" * width, Ansi.DIM)

    span = max(1.0, high - low)
    cur = clean_vals[-1]
    pct = max(0.0, min(100.0, ((cur - low) / span) * 100.0))

    if not watch_mode and len(clean_vals) <= 1:
        return make_bar(pct, width=width, color_override=color_style)

    show_trend = watch_mode and width >= 8
    plot_w = width - 1 if show_trend else width
    if show_trend:
        ref_idx = max(0, len(clean_vals) - 9)
        delta = cur - clean_vals[ref_idx]
        thresh = max(0.4, span * 0.015)
        if delta >= thresh:
            trend = c("↑", Ansi.BOLD, Ansi.BRIGHT_YELLOW)
        elif delta <= -thresh:
            trend = c("↓", Ansi.BOLD, Ansi.BRIGHT_CYAN)
        else:
            trend = " "
    else:
        trend = ""

    if graph_mode == "gauge":
        return f"{make_bar(pct, width=plot_w, color_override=color_style)}{trend}"

    def _scale_window(tail_vals: List[float]) -> Tuple[Optional[float], Optional[float]]:
        if adaptive_mode == "temp":
            v_min = min(tail_vals)
            v_max = max(tail_vals)
            spread = v_max - v_min
            if spread < 0.8:
                return None, None
            eff_span = max(min_span, spread + 2.0)
            v_lo = v_min - (eff_span - spread) * 0.35
            v_lo = max(low, min(v_lo, max(low, high - eff_span)))
            v_hi = v_lo + eff_span
            return v_lo, v_hi
        else:
            v_lo = low
            v_hi = min(high, max(min_span, max(tail_vals) * 1.25))
            if v_hi <= v_lo:
                v_hi = v_lo + max(1.0, min_span)
            return v_lo, v_hi

    if graph_mode == "braille":
        max_pts = plot_w * 2
        tail = clean_vals[-max_pts:]
        v_lo, v_hi = _scale_window(tail)
        slots: List[Optional[float]] = [None] * (max_pts - len(tail)) + tail
        raw_cells: List[Tuple[Optional[str], Optional[float]]] = []
        filled_indices: List[int] = []
        for ci in range(plot_w):
            p_l = slots[ci * 2]
            p_r = slots[ci * 2 + 1]
            if p_l is None and p_r is None:
                raw_cells.append((None, None))
            else:
                def _lvl(val: Optional[float]) -> int:
                    if val is None:
                        return 0
                    if v_lo is None or v_hi is None:
                        return 1
                    norm = max(0.0, min(1.0, (val - v_lo) / max(1e-6, v_hi - v_lo)))
                    return 1 + min(3, int(round(norm * 3.0)))

                ch = chr(0x2800 | _BRAILLE_LEFT[_lvl(p_l)] | _BRAILLE_RIGHT[_lvl(p_r)])
                rep_v = p_r if p_r is not None else p_l
                filled_indices.append(ci)
                raw_cells.append((ch, rep_v))

        out_parts: List[str] = []
        n_filled = len(filled_indices)
        first_filled = filled_indices[0] if filled_indices else plot_w
        dim_cutoff = first_filled + int(n_filled * 0.4) if n_filled >= 4 else -1
        last_filled = filled_indices[-1] if filled_indices else -1
        for ci, (ch, rep_v) in enumerate(raw_cells):
            if ch is None or rep_v is None:
                out_parts.append(c("·", Ansi.DIM))
            else:
                s_col = color_fn(rep_v) if color_fn else color_style
                if ci < dim_cutoff:
                    out_parts.append(c(ch, Ansi.DIM, s_col))
                elif ci == last_filled:
                    out_parts.append(c(ch, Ansi.BOLD, s_col))
                else:
                    out_parts.append(c(ch, s_col))
        return "".join(out_parts) + trend

    # Default: "spark" (adaptive block sparkline)
    tail = clean_vals[-plot_w:]
    pad_len = max(0, plot_w - len(tail))
    v_lo, v_hi = _scale_window(tail)
    styled_bars: List[str] = []
    n_tail = len(tail)
    for i, v in enumerate(tail):
        if v_lo is None or v_hi is None:
            norm_abs = max(0.0, min(1.0, (v - low) / span))
            idx = min(2, int(round(norm_abs * 3.0)))
        else:
            norm = max(0.0, min(1.0, (v - v_lo) / max(1e-6, v_hi - v_lo)))
            idx = min(len(SPARK_CHARS) - 1, int(round(norm * (len(SPARK_CHARS) - 1))))
        ch = SPARK_CHARS[idx]
        s_col = color_fn(v) if color_fn else color_style
        if n_tail >= 4 and i < n_tail * 0.4:
            styled_bars.append(c(ch, Ansi.DIM, s_col))
        elif i == n_tail - 1:
            styled_bars.append(c(ch, Ansi.BOLD, s_col))
        else:
            styled_bars.append(c(ch, s_col))

    pad_str = c("·" * pad_len, Ansi.DIM) if pad_len > 0 else ""
    return f"{pad_str}{''.join(styled_bars)}{trend}"

def temp_color(t: float, comp: str = "cpu") -> str:
    """Returns an adaptive ANSI color string based on hardware thermal limits."""
    if comp == "gpu":
        # RTX 5090 Laptop: throttles at 87°C
        if t >= 80.0:
            return Ansi.BRIGHT_RED
        if t >= 65.0:
            return Ansi.BRIGHT_YELLOW
        return Ansi.BRIGHT_GREEN
    elif comp == "ram":
        # DDR5 SPD limit: 85°C
        if t >= 70.0:
            return Ansi.BRIGHT_RED
        if t >= 55.0:
            return Ansi.BRIGHT_YELLOW
        return Ansi.BRIGHT_GREEN
    elif comp == "nvme":
        # NVMe SSD throttles at 70°C
        if t >= 65.0:
            return Ansi.BRIGHT_RED
        if t >= 50.0:
            return Ansi.BRIGHT_YELLOW
        return Ansi.BRIGHT_GREEN
    else:
        # Intel Core Ultra 9 275HX: Tjmax 105°C
        if t >= 85.0:
            return Ansi.BRIGHT_RED
        if t >= 70.0:
            return Ansi.BRIGHT_YELLOW
        return Ansi.BRIGHT_GREEN


# --- High-Level Telemetry Aggregator ---

class TelemetryCollector:
    """Aggregates CPU, GPU, memory, power, thermals, and display telemetry."""

    def __init__(self):
        self._last_rapl_energy: Optional[int] = None
        self._last_rapl_time: Optional[float] = None
        self._rapl_max_energy: int = 262143328850
        self._last_cpu_ticks: Optional[tuple] = None
        self._cpu_model: str = "Intel Processor"
        self._logical_cores: int = 0
        self._freq_nodes: List[str] = sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq"))
        self.history: Dict[str, Deque[float]] = {
            "cpu_temp": deque(maxlen=24),
            "gpu_temp": deque(maxlen=24),
            "dimm_temp": deque(maxlen=24),
            "ssd1_temp": deque(maxlen=24),
            "ssd2_temp": deque(maxlen=24),
            "cpu_power": deque(maxlen=24),
            "gpu_power": deque(maxlen=24),
            "igpu_power": deque(maxlen=24),
            "cpu_load": deque(maxlen=24),
            "gpu_util": deque(maxlen=24),
            "igpu_util": deque(maxlen=24),
        }
        try:
            with open("/proc/cpuinfo", "r") as f:
                for line in f:
                    if line.startswith("model name") and self._cpu_model == "Intel Processor":
                        self._cpu_model = line.split(":", 1)[1].strip().replace("Intel(R) Core(TM) ", "").replace(" CPU", "")
                    elif line.startswith("processor"):
                        self._logical_cores += 1
        except Exception:
            pass
        # Prime baseline counters before NVML init so frame 1 has an elapsed measurement window
        max_rapl_node = os.path.join(os.path.dirname(RAPL_ENERGY_NODE), "max_energy_range_uj")
        if os.path.isfile(max_rapl_node):
            try:
                with open(max_rapl_node, "r") as f:
                    val = int(f.read().strip())
                    if val > 0:
                        self._rapl_max_energy = val
            except Exception:
                pass
        if os.path.isfile(RAPL_ENERGY_NODE):
            try:
                with open(RAPL_ENERGY_NODE, "r") as f:
                    self._last_rapl_energy = int(f.read().strip())
                self._last_rapl_time = time.monotonic()
            except Exception:
                pass
        try:
            with open("/proc/stat", "r") as sf:
                parts = [float(x) for x in sf.readline().split()[1:]]
            self._last_cpu_ticks = (sum(parts), parts[3] + parts[4])
        except Exception:
            pass
        self.igpu = IntelIgpuTelemetry()
        self.nvml = NvmlTelemetry()

    def get_cpu_info(self, sample_interval: float = 0.05) -> Dict[str, Any]:
        """Reads CPU model, cores, frequencies, load, coretemp, and live RAPL power."""
        mmio = get_rapl_mmio_limits()
        res = {
            "model": self._cpu_model,
            "logical_cores": self._logical_cores,
            "avg_frequency_mhz": None,
            "max_frequency_mhz": None,
            "load_avg": list(os.getloadavg()),
            "temperature_c": get_cpu_package_temp(),
            "package_power_w": None,
            "power_limit_pl1_w": mmio.get("pl1_w"),
            "power_limit_pl2_w": mmio.get("pl2_w"),
        }

        # CPU Frequencies
        freqs: List[int] = []
        for fpath in self._freq_nodes:
            try:
                with open(fpath, "r") as fp:
                    freqs.append(int(fp.read().strip()))
            except Exception:
                pass
        if freqs:
            res["avg_frequency_mhz"] = round(sum(freqs) / len(freqs) / 1000.0)
            res["max_frequency_mhz"] = round(max(freqs) / 1000.0)

        # Intel RAPL Live Power & CPU Utilization %
        def _read_cpu_ticks():
            try:
                with open("/proc/stat", "r") as sf:
                    line = sf.readline()
                parts = [float(x) for x in line.split()[1:]]
                idle = parts[3] + parts[4]
                total = sum(parts)
                return total, idle
            except Exception:
                return 0.0, 0.0

        c_stat1 = _read_cpu_ticks()
        if self._last_cpu_ticks is None:
            self._last_cpu_ticks = c_stat1

        if os.path.isfile(RAPL_ENERGY_NODE):
            try:
                with open(RAPL_ENERGY_NODE, "r") as f:
                    e1 = int(f.read().strip())
                t1 = time.monotonic()

                used_prev = False
                if self._last_rapl_energy is not None and self._last_rapl_time is not None:
                    dt = t1 - self._last_rapl_time
                    de = e1 - self._last_rapl_energy
                    if de < 0 and self._rapl_max_energy > 0:
                        de += self._rapl_max_energy
                    if dt >= 0.04 and de >= 0:
                        res["package_power_w"] = round(de / (dt * 1e6), 1)
                        used_prev = True
                if not used_prev:
                    wait_s = sample_interval if sample_interval > 0 else 0.04
                    time.sleep(wait_s)
                    with open(RAPL_ENERGY_NODE, "r") as f:
                        e2 = int(f.read().strip())
                    t2 = time.monotonic()
                    dt = t2 - t1
                    de = e2 - e1
                    if de < 0 and self._rapl_max_energy > 0:
                        de += self._rapl_max_energy
                    if dt > 0 and de >= 0:
                        res["package_power_w"] = round(de / (dt * 1e6), 1)
                    e1, t1 = e2, t2
                    c_stat1 = _read_cpu_ticks()

                self._last_rapl_energy = e1
                self._last_rapl_time = t1
            except Exception:
                pass
        elif c_stat1 == self._last_cpu_ticks and sample_interval > 0:
            time.sleep(sample_interval)
            c_stat1 = _read_cpu_ticks()

        dt_tot = c_stat1[0] - self._last_cpu_ticks[0]
        di_idle = c_stat1[1] - self._last_cpu_ticks[1]
        res["usage_percent"] = round(100.0 * (dt_tot - di_idle) / dt_tot, 1) if dt_tot > 0 else 0.0
        self._last_cpu_ticks = c_stat1

        return res

    def get_memory_info(self, ttl: float = 0.0) -> Dict[str, Any]:
        """Reads system RAM, SPD temperatures, and SMBIOS Type 17 DIMM hardware metadata."""
        hw = get_memory_hardware_info()
        res = {
            "total_gib": 0.0,
            "used_gib": 0.0,
            "available_gib": 0.0,
            "percent": 0.0,
            "spd_temps_c": get_spd_ram_temps(ttl=ttl),
            "hardware": hw,
        }
        try:
            mem = {}
            with open("/proc/meminfo", "r") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        mem[parts[0].strip()] = int(parts[1].strip().split()[0])
            total = mem.get("MemTotal", 0) / (1024**2)
            avail = mem.get("MemAvailable", 0) / (1024**2)
            used = total - avail
            res["total_gib"] = round(total, 1)
            res["available_gib"] = round(avail, 1)
            res["used_gib"] = round(used, 1)
            if total > 0:
                res["percent"] = round((used / total) * 100.0, 1)
        except Exception:
            pass
        return res

    def get_display_info(self, ttl: float = 0.0) -> Dict[str, Any]:
        """Reads display panel ID, refresh rate, and matches active color profiles for all displays."""
        disp_info = get_active_display_info(ttl=ttl)

        def _resolve_profile(icc_path: str, is_int: bool):
            if not icc_path:
                return "unknown", "Default / Native" if is_int else "Standard / Uncalibrated"
            base_file = os.path.basename(icc_path)
            for p in COLOR_PROFILES:
                if p["file"] == base_file or p["id"] in base_file.lower():
                    return p["id"], p["title"]
            return "unknown", base_file

        prof_id, prof_title = _resolve_profile(disp_info.get("icc_profile_path", ""), disp_info.get("is_internal", True))

        all_displays = []
        for d in disp_info.get("displays", []):
            d_copy = dict(d)
            d_prof_id, d_prof_title = _resolve_profile(d.get("icc_profile_path", ""), d.get("is_internal", True))
            d_copy["color_profile_id"] = d_prof_id
            d_copy["color_profile_title"] = d_prof_title
            all_displays.append(d_copy)

        res = {
            "output_name": disp_info.get("output_name", "eDP-1"),
            "is_internal": disp_info.get("is_internal", True),
            "vendor": disp_info.get("vendor", "Samsung"),
            "model": disp_info.get("model", EXPECTED_PANEL_ID),
            "hw_id": disp_info.get("hw_id", EXPECTED_PANEL_ID),
            "panel_id": disp_info.get("hw_id", EXPECTED_PANEL_ID),
            "display_title": disp_info.get("display_title", f"Samsung {EXPECTED_PANEL_ID}"),
            "resolution": disp_info.get("resolution", "2560x1600"),
            "refresh_rate_hz": disp_info.get("refresh_rate_hz", 240.0),
            "scale": disp_info.get("scale", 1.5),
            "color_profile_id": prof_id,
            "color_profile_title": prof_title,
            "display_mode": disp_info.get("display_mode", "single"),
            "count": disp_info.get("count", len(all_displays) or 1),
            "displays": all_displays,
        }

        return res

    def collect_all(self, sample_interval: float = 0.05, force_display: bool = False) -> Dict[str, Any]:
        """Aggregates full system metrics tree and records rolling history."""
        is_watch = sample_interval == 0.0
        display_ttl = 0.0 if (force_display or not is_watch) else 2.0
        slow_sensor_ttl = 2.0 if is_watch else 0.0
        bat_ttl = 4.0 if is_watch else 0.0
        cpu_info = self.get_cpu_info(sample_interval=sample_interval)
        gpu_info = self.nvml.query()
        igpu_info = self.igpu.query()
        mem_info = self.get_memory_info(ttl=slow_sensor_ttl)
        nvme_drives = get_nvme_drives(ttl=slow_sensor_ttl)
        nvme_temps = [d["composite_c"] for d in nvme_drives if d.get("composite_c") is not None] or get_nvme_temps()
        bat_info = get_battery_info(ttl=bat_ttl)
        bat_info["ac_online"] = is_ac_online()

        if cpu_info.get("temperature_c") is not None:
            self.history["cpu_temp"].append(float(cpu_info["temperature_c"]))
        if gpu_info.get("state") == "suspended":
            self.history["gpu_temp"].clear()
        elif gpu_info.get("temperature_c") is not None:
            self.history["gpu_temp"].append(float(gpu_info["temperature_c"]))
        if mem_info.get("spd_temps_c"):
            self.history["dimm_temp"].append(float(max(mem_info["spd_temps_c"])))
        if len(nvme_drives) >= 1 and nvme_drives[0].get("composite_c") is not None:
            self.history["ssd1_temp"].append(float(nvme_drives[0]["composite_c"]))
        elif nvme_temps:
            self.history["ssd1_temp"].append(float(nvme_temps[0]))
        if len(nvme_drives) >= 2 and nvme_drives[1].get("composite_c") is not None:
            self.history["ssd2_temp"].append(float(nvme_drives[1]["composite_c"]))
        elif len(nvme_temps) >= 2:
            self.history["ssd2_temp"].append(float(nvme_temps[1]))
        if cpu_info.get("package_power_w") is not None:
            self.history["cpu_power"].append(float(cpu_info["package_power_w"]))
        if gpu_info.get("power_draw_w") is not None:
            self.history["gpu_power"].append(float(gpu_info["power_draw_w"]))
        if igpu_info.get("power_draw_w") is not None:
            self.history["igpu_power"].append(float(igpu_info["power_draw_w"]))
        if cpu_info.get("usage_percent") is not None:
            self.history["cpu_load"].append(float(cpu_info["usage_percent"]))
        if gpu_info.get("utilization_gpu") is not None:
            self.history["gpu_util"].append(float(gpu_info["utilization_gpu"]))
        if igpu_info.get("utilization_pct") is not None:
            self.history["igpu_util"].append(float(igpu_info["utilization_pct"]))

        return {
            "timestamp": time.time(),
            "system_model": get_system_model(),
            "platform_profile": get_platform_profile(),
            "daemon": get_daemon_status(),
            "fans": get_cooling_fans(),
            "cpu": cpu_info,
            "gpu": gpu_info,
            "igpu": igpu_info,
            "memory": mem_info,
            "storage": {"nvme_temps_c": nvme_temps, "drives": nvme_drives},
            "power_battery": bat_info,
            "display": self.get_display_info(ttl=display_ttl),
        }

    def close(self):
        """Releases NVML and iGPU PMU descriptors."""
        self.nvml.close()
        self.igpu.close()


# --- TUI Dashboard Renderer ---

class DashboardRenderer:
    """Formats telemetry data into a responsive 2x2 card grid (or compact 1-column fallback on narrow panes)."""

    @staticmethod
    def _build_card(title: str, rows: List[str], card_w: int, right_title: str = "") -> List[str]:
        inner_w = card_w - 4
        t_str = f" {title} "
        if right_title:
            rt_plain = f" {strip_ansi(right_title)} "
            if len(t_str) + len(rt_plain) + 3 <= inner_w + 2:
                dashes = max(1, inner_w + 2 - len(t_str) - len(rt_plain) - 2)
                top = (
                    f"{c('╭─', Ansi.DIM)}{c(t_str, Ansi.BOLD, Ansi.WHITE)}"
                    f"{c('─' * dashes, Ansi.DIM)} {right_title} {c('─╮', Ansi.DIM)}"
                )
            else:
                dashes = max(0, inner_w + 2 - len(t_str) - 1)
                top = f"{c('╭─', Ansi.DIM)}{c(t_str, Ansi.BOLD, Ansi.WHITE)}{c('─' * dashes + '╮', Ansi.DIM)}"
        else:
            dashes = max(0, inner_w + 2 - len(t_str) - 1)
            top = f"{c('╭─', Ansi.DIM)}{c(t_str, Ansi.BOLD, Ansi.WHITE)}{c('─' * dashes + '╮', Ansi.DIM)}"
        bot = c(f"╰{'─' * (card_w - 2)}╯", Ansi.DIM)
        b_l = c("│", Ansi.DIM)
        b_r = c("│", Ansi.DIM)
        out = [top]
        for r in rows:
            cell = fit_cell(r, inner_w)
            out.append(f"{b_l} {cell} {b_r}")
        out.append(bot)
        return out

    @staticmethod
    def render(
        data: Dict[str, Any],
        width: int = 100,
        height: int = 28,
        history: Optional[Dict[str, Deque[float]]] = None,
        watch_mode: bool = False,
        status_msg: str = "",
        graph_mode: str = "spark",
    ) -> str:
        hist = history or {}
        # Prefer 2x2 side-by-side grid at >= 86 cols (or >= 76 cols when terminal height < 28 rows)
        two_col = width >= 86 or (width >= 76 and height < 28)
        if two_col:
            total_w = max(76, min(width, 136))
            if total_w % 2 != 0:
                total_w -= 1
            card_w = (total_w - 2) // 2
        else:
            total_w = max(56, min(width, 86))
            card_w = total_w

        inner_w = card_w - 4
        if inner_w >= 46:
            spark_w = 10
        elif inner_w >= 38:
            spark_w = 8
        else:
            spark_w = 6
        val_w = 7
        gap_after_bar = "  " if inner_w >= 42 else " "
        right_w = max(12, inner_w - (4 + 1 + val_w + 1 + spark_w + len(gap_after_bar)))

        def metric_row(label: str, val_plain: str, val_color: Optional[str], visual: str, detail: str) -> str:
            lbl_cell = fit_cell(c(label, Ansi.BOLD, Ansi.WHITE), 4)
            val_pad = fit_cell(val_plain, val_w, align=">")
            val_cell = c(val_pad, Ansi.BOLD, val_color) if val_color else c(val_pad, Ansi.DIM)
            det_cell = fit_cell(detail, right_w)
            return f"{lbl_cell} {val_cell} {visual}{gap_after_bar}{det_cell}"

        # ── Header Bar ────────────────────────────────────────────────────────
        sys_model = data.get("system_model") or get_system_model()
        prof = data["platform_profile"]
        led_color = prof.get("led_color_code", Ansi.WHITE)
        plat_title = prof["title"].replace(" Mode", "")
        if total_w >= 82:
            prof_badge = c(f"● {plat_title} ({prof['led']})", Ansi.BOLD, led_color)
        else:
            prof_badge = c(f"● {plat_title}", Ansi.BOLD, led_color)

        daemon = data["daemon"]
        if daemon["active"]:
            d_rss = f" {daemon['rss_mib']}M" if (daemon.get("rss_mib") and total_w >= 76) else ""
            daemon_badge = f"{c('● Daemon OK', Ansi.BRIGHT_GREEN)}{c(d_rss, Ansi.DIM)}"
        else:
            daemon_badge = c("○ Daemon Off", Ansi.BRIGHT_YELLOW)

        if total_w >= 78:
            hdr_left = f" {c('LEGION LINUX TOOLKIT', Ansi.BOLD, Ansi.BRIGHT_CYAN)} {c('· ' + sys_model, Ansi.DIM)}"
        else:
            hdr_left = f" {c('LEGION ' + sys_model.split()[0].upper(), Ansi.BOLD, Ansi.BRIGHT_CYAN)}"
        hdr_right = f"{prof_badge}  {c('·', Ansi.DIM)}  {daemon_badge} "
        hdr_pad = max(1, total_w - visible_width(hdr_left) - visible_width(hdr_right))
        header_line = f"{hdr_left}{' ' * hdr_pad}{hdr_right}"

        # ── Card 1: THERMAL & COOLING (5 rows + Aux Fan in top border) ────────
        cpu = data["cpu"]
        gpu = data["gpu"]
        igpu = data.get("igpu") or {}
        fans = data["fans"]
        cpu_f = fans["cpu_fan"]
        gpu_f = fans["gpu_fan"]
        aux_f = fans["aux_fan"]
        mem_info = data["memory"]
        spd_t = mem_info["spd_temps_c"]
        mem_hw = mem_info.get("hardware") or get_memory_hardware_info()
        nvme_drives = data["storage"].get("drives") or []
        nvme_t = data["storage"]["nvme_temps_c"]

        # Clean dynamic dGPU short name (e.g. "RTX 5090", "RTX 4070", "RTX 4060") & firmware
        raw_gpu_name = (gpu.get("name") or "dGPU").replace("NVIDIA ", "").replace("GeForce ", "").replace(" Laptop GPU", "").strip()
        short_gpu_name = raw_gpu_name if len(raw_gpu_name) <= 12 else " ".join(raw_gpu_name.split()[:2])
        gpu_nbr = short_gpu_name.split()[-1] if short_gpu_name else "dGPU"
        gpu_fw = gpu.get("firmware") or (gpu.get("driver") if gpu.get("driver") not in (None, "", "N/A") else "")

        def _pick_fit(candidates: List[str]) -> str:
            for cand in candidates:
                if len(cand) <= right_w:
                    return cand
            return candidates[-1]

        cpu_t = cpu.get("temperature_c")
        cpu_t_col = temp_color(cpu_t, "cpu") if cpu_t is not None else None
        cpu_t_str = f"{cpu_t:.1f}°C" if cpu_t is not None else "N/A"
        cpu_t_bar = make_trend_visual(
            list(hist.get("cpu_temp", [cpu_t] if cpu_t else [])),
            35.0, 95.0, spark_w, cpu_t_col or Ansi.DIM, watch_mode,
            graph_mode=graph_mode, adaptive_mode="temp", min_span=8.0,
            color_fn=lambda v: temp_color(v, "cpu"),
        )
        cpu_fan_det = (
            f"CPU Fan {cpu_f['rpm']:4d} rpm ({cpu_f['percent']:2.0f}%)"
            if right_w >= 22 else (f"{cpu_f['rpm']:4d} rpm ({cpu_f['percent']:2.0f}%)" if right_w >= 14 else f"{cpu_f['rpm']:4d}rpm ({cpu_f['percent']:2.0f}%)")
        )

        gpu_t = gpu.get("temperature_c")
        gpu_state = gpu.get("state")
        gpu_asleep = gpu_state == "suspended"
        gpu_idling = gpu_state == "idling"
        if gpu_t is not None:
            gpu_t_col = temp_color(gpu_t, "gpu")
            gpu_t_str = f"{gpu_t:.1f}°C" if gpu_t < 100 else f"{gpu_t:.0f}°C"
            gpu_t_bar = make_trend_visual(
                list(hist.get("gpu_temp", [gpu_t])),
                32.0, 87.0, spark_w, gpu_t_col, watch_mode,
                graph_mode=graph_mode, adaptive_mode="temp", min_span=8.0,
                color_fn=lambda v: temp_color(v, "gpu"),
            )
        else:
            gpu_t_col = None
            gpu_t_str = "Sleep" if gpu_asleep else ("Idle" if gpu_idling else "N/A")
            gpu_t_bar = c("·" * spark_w, Ansi.DIM)
        gpu_fan_det = (
            f"GPU Fan {gpu_f['rpm']:4d} rpm ({gpu_f['percent']:2.0f}%)"
            if right_w >= 22 else (f"{gpu_f['rpm']:4d} rpm ({gpu_f['percent']:2.0f}%)" if right_w >= 14 else f"{gpu_f['rpm']:4d}rpm ({gpu_f['percent']:2.0f}%)")
        )

        if spd_t:
            dimm_max = max(spd_t)
            dimm_col = temp_color(dimm_max, "ram")
            dimm_str = "/".join(f"{t:.0f}" for t in spd_t[:2]) + "°C"
            dimm_bar = make_trend_visual(
                list(hist.get("dimm_temp", [dimm_max])),
                30.0, 75.0, spark_w, dimm_col, watch_mode,
                graph_mode=graph_mode, adaptive_mode="temp", min_span=4.0,
                color_fn=lambda v: temp_color(v, "ram"),
            )
        else:
            dimm_col = None
            dimm_str = "N/A"
            dimm_bar = c("·" * spark_w, Ansi.DIM)

        # Show real memory bus speed & topology (e.g. "DDR5-6400 (2x32GB Micron)") instead of generic slot text
        full_mem_sum = mem_hw.get("summary", "DDR5 SODIMM")
        short_mem_sum = mem_hw.get("short_summary", "DDR5")
        type_spd = mem_hw.get("type_speed", "DDR5")
        if len(full_mem_sum) <= right_w:
            dimm_det = full_mem_sum
        elif len(short_mem_sum) <= right_w:
            dimm_det = short_mem_sum
        else:
            dimm_det = type_spd

        def _build_ssd_row(slot_idx: int, hist_key: str) -> str:
            lbl = f"SSD{slot_idx + 1}"
            if slot_idx < len(nvme_drives):
                drv = nvme_drives[slot_idx]
                t_comp = drv.get("composite_c")
                s_mod = drv.get("short_model", f"NVMe {slot_idx + 1}")
                pcie_tag = drv.get("pcie_tag", "")
                if t_comp is not None:
                    s_col = temp_color(t_comp, "nvme")
                    s_str = f"{t_comp:.1f}°C"
                    s_bar = make_trend_visual(
                        list(hist.get(hist_key, [t_comp])),
                        28.0, 70.0, spark_w, s_col, watch_mode,
                        graph_mode=graph_mode, adaptive_mode="temp", min_span=4.0,
                        color_fn=lambda v: temp_color(v, "nvme"),
                    )
                else:
                    s_col = None
                    s_str = "N/A"
                    s_bar = c("·" * spark_w, Ansi.DIM)
                full_ssd = f"{s_mod} ({pcie_tag})" if pcie_tag else s_mod
                s_det = full_ssd if len(full_ssd) <= right_w else s_mod
                return metric_row(lbl, s_str, s_col, s_bar, s_det)
            elif slot_idx < len(nvme_t):
                t_val = nvme_t[slot_idx]
                s_col = temp_color(t_val, "nvme")
                s_bar = make_trend_visual(
                    list(hist.get(hist_key, [t_val])),
                    28.0, 70.0, spark_w, s_col, watch_mode,
                    graph_mode=graph_mode, adaptive_mode="temp", min_span=4.0,
                    color_fn=lambda v: temp_color(v, "nvme"),
                )
                return metric_row(lbl, f"{t_val:.1f}°C", s_col, s_bar, f"NVMe Drive {slot_idx + 1}")
            else:
                return metric_row(lbl, "Empty", None, c("·" * spark_w, Ansi.DIM), "M.2 Slot Empty")

        aux_hdr = ""
        if aux_f.get("present", True) and aux_f.get("max_rpm", 0) > 0:
            aux_rpm = aux_f["rpm"]
            aux_pct = aux_f["percent"]
            aux_hdr = (
                f"{c('Aux Fan', Ansi.DIM)} {c(f'{aux_rpm} rpm ({aux_pct:.0f}%)', Ansi.BRIGHT_CYAN)}"
                if inner_w >= 42 else f"{c(f'Aux {aux_rpm}rpm', Ansi.BRIGHT_CYAN)}"
            )
        thermal_title = "THERMAL & COOLING" if inner_w >= 44 else "THERMAL"
        thermal_rows = [
            metric_row("CPU", cpu_t_str, cpu_t_col, cpu_t_bar, cpu_fan_det),
            metric_row("dGPU", gpu_t_str, gpu_t_col, gpu_t_bar, gpu_fan_det),
            metric_row("DIMM", dimm_str, dimm_col, dimm_bar, dimm_det),
        ]
        # Dynamically render detected NVMe drives (supports 1, 2, or more SSDs; pads to 5 rows for 2x2 grid symmetry)
        num_ssd_rows = max(2, min(3, len(nvme_drives))) if not two_col else 2
        for s_idx in range(num_ssd_rows):
            thermal_rows.append(_build_ssd_row(s_idx, f"ssd{s_idx + 1}_temp"))
        card_thermal = DashboardRenderer._build_card(thermal_title, thermal_rows, card_w, right_title=aux_hdr)

        # ── Card 2: POWER & BATTERY (5 rows) ──────────────────────────────────
        c_p = cpu.get("package_power_w")
        pl1_w = cpu.get("power_limit_pl1_w")
        pl2_w = cpu.get("power_limit_pl2_w")
        if pl1_w is not None and pl2_w is not None:
            if pl2_w < pl1_w:
                eff_pl = pl2_w
                pl_tag = "Clamp"
            elif c_p is not None and c_p > pl1_w:
                eff_pl = pl2_w
                pl_tag = "PL2"
            else:
                eff_pl = pl1_w
                pl_tag = "PL1"
        else:
            eff_pl = pl1_w or pl2_w or 55.0
            pl_tag = "PL1"

        if c_p is not None:
            c_p_pct = (c_p / eff_pl * 100.0) if eff_pl > 0 else 0.0
            c_p_col = pct_color(c_p_pct)
            c_p_str = f"{c_p:.1f} W" if c_p < 100 else f"{c_p:.0f} W"
            c_p_bar = make_trend_visual(
                list(hist.get("cpu_power", [c_p])),
                0.0, max(eff_pl, pl2_w or 65.0), spark_w, c_p_col, watch_mode,
                graph_mode=graph_mode, adaptive_mode="power", min_span=max(25.0, eff_pl * 0.55),
                color_fn=lambda v: pct_color((v / eff_pl * 100.0) if eff_pl > 0 else 0.0),
            )
            c_p_det = f"of {eff_pl:.0f}W {pl_tag} ({c_p_pct:.0f}%)" if right_w >= 17 else f"{eff_pl:.0f}W {pl_tag} ({c_p_pct:.0f}%)"
        else:
            c_p_col = None
            c_p_str = "N/A"
            c_p_bar = c("·" * spark_w, Ansi.DIM)
            c_p_det = f"Limit {eff_pl:.0f}W"

        g_p = gpu.get("power_draw_w")
        g_lim = gpu.get("power_limit_w") or 150.0
        if not gpu_asleep and not gpu_idling and g_p is not None:
            g_p_pct = (g_p / g_lim * 100.0) if g_lim > 0 else 0.0
            g_p_col = pct_color(g_p_pct)
            g_p_str = f"{g_p:.1f} W" if g_p < 100 else f"{g_p:.0f} W"
            g_p_bar = make_trend_visual(
                list(hist.get("gpu_power", [g_p])),
                0.0, g_lim, spark_w, g_p_col, watch_mode,
                graph_mode=graph_mode, adaptive_mode="power", min_span=max(30.0, g_lim * 0.25),
                color_fn=lambda v: pct_color((v / g_lim * 100.0) if g_lim > 0 else 0.0),
            )
            if right_w >= 18:
                g_p_det = f"of {g_lim:.0f}W TGP ({g_p_pct:.0f}%)"
            elif right_w >= 15:
                g_p_det = f"{g_lim:.0f}W TGP ({g_p_pct:.0f}%)"
            else:
                g_p_det = f"{g_lim:.0f}W ({g_p_pct:.0f}%)"
        else:
            g_p_col = None
            if gpu_asleep:
                g_p_str = "0.0 W"
                g_p_det = "PCIe D3cold Sleep" if right_w >= 17 else "D3cold Sleep"
            elif gpu_idling:
                g_p_str = "Idle"
                g_p_det = "Waiting D3cold" if right_w >= 14 else "Idle (D3)"
            else:
                g_p_str = "N/A"
                g_p_det = "N/A"
            g_p_bar = c("·" * spark_w, Ansi.DIM)

        ig_p = igpu.get("power_draw_w")
        ig_name = igpu.get("name", "Intel Graphics")
        if ig_p is not None:
            ig_p_col = pct_color((ig_p / 25.0) * 100.0)
            ig_p_str = f"{ig_p:.1f} W"
            ig_p_bar = make_trend_visual(
                list(hist.get("igpu_power", [ig_p])),
                0.0, 20.0, spark_w, ig_p_col, watch_mode,
                graph_mode=graph_mode, adaptive_mode="power", min_span=5.0,
                color_fn=lambda v: pct_color((v / 25.0) * 100.0),
            )
        else:
            ig_p_col = Ansi.BRIGHT_GREEN
            ig_p_str = "0.0 W"
            ig_p_bar = make_bar(0.0, width=spark_w, color_override=Ansi.BRIGHT_GREEN)
        ig_p_det = f"{ig_name} (RAPL)" if right_w >= len(ig_name) + 7 else (ig_name if right_w >= len(ig_name) else f"{igpu.get('vendor', 'Intel')} iGPU")

        bat = data["power_battery"]
        ac_on = bat.get("ac_online", True)
        pwr_src = "AC" if ac_on else "Bat"
        pl_pair = f"{pl1_w:.0f}/{pl2_w:.0f}W" if (pl1_w and pl2_w) else "N/A"
        pl_bar = make_bar((pl1_w / 90.0 * 100.0) if pl1_w else 50.0, width=spark_w, color_override=Ansi.BRIGHT_CYAN)
        lim_det = f"MMIO PL1/PL2 ({pwr_src} Mode)" if right_w >= 22 else f"PL1/PL2 ({pwr_src})"

        b_cap_num = float(bat.get("capacity_percent") or 0.0)
        b_cap_str = f"{int(b_cap_num)}%" if bat.get("capacity_percent") is not None else "N/A"
        b_col = Ansi.BRIGHT_GREEN if b_cap_num >= 40 else (Ansi.BRIGHT_YELLOW if b_cap_num >= 20 else Ansi.BRIGHT_RED)
        b_bar = make_bar(b_cap_num, width=spark_w, color_override=b_col)
        cap_tag = c("80% Cap", Ansi.BRIGHT_GREEN) if bat.get("conservation_mode") else c("100% Max", Ansi.BRIGHT_YELLOW)
        b_hlth = f"{bat['health_percent']}%" if bat.get("health_percent") else "N/A"
        b_cyc = f"{bat['cycle_count']}c" if bat.get("cycle_count") is not None else ""
        b_volt = f"{bat['voltage_v']:.1f}V" if bat.get("voltage_v") else ""
        if right_w >= 28:
            b_det = f"{cap_tag} · H:{b_hlth} {b_cyc} {b_volt}".strip()
        elif right_w >= 19:
            b_det = f"{cap_tag} · H:{b_hlth} {b_cyc}".strip()
        elif right_w >= 16:
            b_det = f"{cap_tag} · {b_hlth}"
        else:
            b_det = f"{cap_tag} {b_hlth}"

        power_rows = [
            metric_row("CPU", c_p_str, c_p_col, c_p_bar, c_p_det),
            metric_row("dGPU", g_p_str, g_p_col, g_p_bar, g_p_det),
            metric_row("iGPU", ig_p_str, ig_p_col, ig_p_bar, ig_p_det),
            metric_row("LIM", pl_pair, Ansi.BRIGHT_CYAN, pl_bar, lim_det),
            metric_row("BAT", b_cap_str, b_col, b_bar, b_det),
        ]
        card_power = DashboardRenderer._build_card("POWER & BATTERY", power_rows, card_w)

        # ── Card 3: COMPUTE & MEMORY (5 rows) ─────────────────────────────────
        cpu_pct = max(0.0, min(100.0, float(cpu.get("usage_percent") or 0.0)))
        cpu_l_col = pct_color(cpu_pct)
        cpu_l_bar = make_trend_visual(
            list(hist.get("cpu_load", [cpu_pct])),
            0.0, 100.0, spark_w, cpu_l_col, watch_mode,
            graph_mode=graph_mode, adaptive_mode="power", min_span=25.0,
            color_fn=pct_color,
        )
        avg_f = cpu.get("avg_frequency_mhz")
        max_f = cpu.get("max_frequency_mhz")
        if avg_f and max_f:
            cpu_clk_det = f"{avg_f:4d} MHz (Peak {max_f/1000:.1f} GHz)"
            if len(cpu_clk_det) > right_w:
                cpu_clk_det = f"{avg_f:4d} MHz ({max_f/1000:.1f}G)" if right_w >= 15 else f"{avg_f}M ({max_f/1000:.1f}G)"
        elif avg_f:
            cpu_clk_det = f"{avg_f:4d} MHz"
        else:
            cpu_clk_det = cpu.get("model", "Processor")

        if gpu_asleep:
            gpu_u_col = None
            gpu_u_str = "Sleep"
            gpu_u_bar = c("·" * spark_w, Ansi.DIM)
            cands = []
            if gpu_fw:
                cands.append(f"{short_gpu_name} {gpu_fw} (Sleep)")
            cands.extend([f"{short_gpu_name} (Suspended)", f"{short_gpu_name} (Sleep)", f"{short_gpu_name} (D3)"])
            gpu_clk_det = _pick_fit(cands)
        elif gpu_idling:
            gpu_u_col = None
            gpu_u_str = "Idle"
            gpu_u_bar = c("·" * spark_w, Ansi.DIM)
            cands = []
            if gpu_fw:
                cands.append(f"{short_gpu_name} {gpu_fw} (Idle)")
            cands.extend([f"{short_gpu_name} (Standby)", f"{short_gpu_name} (Idle)", f"{short_gpu_name} Idle"])
            gpu_clk_det = _pick_fit(cands)
        else:
            g_util = max(0.0, min(100.0, float(gpu.get("utilization_gpu") or 0.0)))
            gpu_u_col = pct_color(g_util)
            gpu_u_str = f"{g_util:.1f}%"
            gpu_u_bar = make_trend_visual(
                list(hist.get("gpu_util", [g_util])),
                0.0, 100.0, spark_w, gpu_u_col, watch_mode,
                graph_mode=graph_mode, adaptive_mode="power", min_span=25.0,
                color_fn=pct_color,
            )
            g_clk = gpu.get("clock_graphics_mhz")
            if g_clk is not None:
                cands = []
                if gpu_fw:
                    cands.extend([
                        f"{g_clk:4d} MHz ({short_gpu_name} {gpu_fw})",
                        f"{g_clk:4d} MHz ({gpu_nbr} {gpu_fw})",
                    ])
                cands.extend([
                    f"{g_clk:4d} MHz ({short_gpu_name})",
                    f"{g_clk:4d} MHz ({gpu_nbr})",
                    f"{g_clk}M ({gpu_nbr})",
                ])
                gpu_clk_det = _pick_fit(cands)
            else:
                cands = [f"{short_gpu_name} ({gpu_fw})"] if gpu_fw else []
                cands.append(short_gpu_name)
                gpu_clk_det = _pick_fit(cands)

        ig_util = max(0.0, min(100.0, float(igpu.get("utilization_pct") or 0.0)))
        ig_u_col = pct_color(ig_util)
        ig_u_str = f"{ig_util:.1f}%"
        ig_u_bar = make_trend_visual(
            list(hist.get("igpu_util", [ig_util])),
            0.0, 100.0, spark_w, ig_u_col, watch_mode,
            graph_mode=graph_mode, adaptive_mode="power", min_span=25.0,
            color_fn=pct_color,
        )
        ig_clk = igpu.get("clock_mhz")
        ig_max = igpu.get("max_clock_mhz") or 1900
        ig_vend = igpu.get("vendor", "Intel")
        if ig_clk is not None:
            if right_w >= 23:
                ig_clk_det = f"{ig_clk:4d} / {ig_max} MHz ({ig_vend})"
            elif right_w >= 16:
                ig_clk_det = f"{ig_clk:4d} MHz ({ig_vend})"
            else:
                ig_clk_det = f"{ig_clk}/{ig_max} MHz"
        else:
            ig_clk_det = ig_name

        mem = data["memory"]
        ram_pct = max(0.0, min(100.0, float(mem.get("percent") or 0.0)))
        ram_col = pct_color(ram_pct)
        ram_bar = make_bar(ram_pct, width=spark_w, color_override=ram_col)
        # Show useful free RAM headroom instead of repeating (DDR5)
        full_ram_det = f"{mem['used_gib']:.1f} / {mem['total_gib']:.1f} GiB ({mem['available_gib']:.1f}G Free)"
        mid_ram_det = f"{mem['used_gib']:.1f} / {mem['total_gib']:.1f} GiB"
        ram_det = full_ram_det if len(full_ram_det) <= right_w else (mid_ram_det if len(mid_ram_det) <= right_w else f"{mem['used_gib']:.1f}/{mem['total_gib']:.1f} GiB")

        v_used_mib = gpu.get("memory_used_mib")
        v_tot_mib = gpu.get("memory_total_mib")
        vram_pct = max(0.0, min(100.0, float(gpu.get("memory_percent") or 0.0)))
        if gpu_asleep or gpu_idling:
            vram_col = None
            vram_str = "0.0%"
            vram_bar = make_bar(0.0, width=spark_w)
            if v_tot_mib:
                v_tot_g = v_tot_mib / 1024.0
                full_v_sleep = f"0.0 / {v_tot_g:.1f} GiB ({v_tot_g:.1f}G Free)"
                mid_v_sleep = f"0.0 / {v_tot_g:.1f} GiB"
                vram_det = full_v_sleep if len(full_v_sleep) <= right_w else (mid_v_sleep if len(mid_v_sleep) <= right_w else f"0.0/{v_tot_g:.1f} GiB")
            else:
                vram_det = "0.0 GiB (Sleep)" if gpu_asleep else "0.0 GiB (Idle)"
        else:
            vram_col = pct_color(vram_pct)
            vram_str = f"{vram_pct:.1f}%"
            vram_bar = make_bar(vram_pct, width=spark_w, color_override=vram_col)
            v_used_gib = (v_used_mib / 1024.0) if v_used_mib is not None else 0.0
            v_tot_gib = (v_tot_mib / 1024.0) if v_tot_mib is not None else 23.9
            v_free_gib = max(0.0, v_tot_gib - v_used_gib)
            full_v_det = f"{v_used_gib:.1f} / {v_tot_gib:.1f} GiB ({v_free_gib:.1f}G Free)"
            mid_v_det = f"{v_used_gib:.1f} / {v_tot_gib:.1f} GiB"
            vram_det = full_v_det if len(full_v_det) <= right_w else (mid_v_det if len(mid_v_det) <= right_w else f"{v_used_gib:.1f}/{v_tot_gib:.1f} GiB")

        compute_rows = [
            metric_row("CPU", f"{cpu_pct:.1f}%", cpu_l_col, cpu_l_bar, cpu_clk_det),
            metric_row("dGPU", gpu_u_str, gpu_u_col, gpu_u_bar, gpu_clk_det),
            metric_row("iGPU", ig_u_str, ig_u_col, ig_u_bar, ig_clk_det),
            metric_row("RAM", f"{ram_pct:.1f}%", ram_col, ram_bar, ram_det),
            metric_row("VRAM", vram_str, vram_col, vram_bar, vram_det),
        ]
        card_compute = DashboardRenderer._build_card("COMPUTE & MEMORY", compute_rows, card_w)

        # ── Card 4: DISPLAYS & CALIBRATION (5 rows) ───────────────────────────
        disp = data["display"]
        d_count = disp.get("count", 1)
        d_mode = disp.get("display_mode", "single")
        displays = disp.get("displays", [disp])

        disp_rows: List[str] = []
        if d_count > 1 and len(displays) > 1:
            # Compute fixed column widths across all connected displays so resolution, scale, and Hz align vertically
            shown_disps = displays[:2]
            res_col_w = max(len(d.get("resolution", "")) for d in shown_disps)
            scale_strs = [f"@{d.get('scale', 1.0):g}x" for d in shown_disps]
            scale_col_w = max(len(s) for s in scale_strs)
            max_natural_name = max(len(d.get("display_title", "")) for d in shown_disps)

            for idx, d in enumerate(shown_disps, start=1):
                hz = d["refresh_rate_hz"]
                hz_col = Ansi.BRIGHT_GREEN if hz >= 120 else Ansi.BRIGHT_YELLOW
                res_pad = f"{d['resolution']:<{res_col_w}}"
                sc_pad = f"{scale_strs[idx - 1]:<{scale_col_w}}"
                if inner_w >= 48:
                    hz_str = c(f"{hz:6.2f} Hz", Ansi.BOLD, hz_col)
                    out_pad = f"{d['output_name']:<5}"
                    tag = c(f"[{idx}] {out_pad}", Ansi.BOLD, Ansi.WHITE)
                    spec = f"{res_pad} {sc_pad}"
                    sep_gap = "  "
                    avail_name_w = max(8, inner_w - visible_width(tag) - len(spec) - visible_width(hz_str) - len(sep_gap) - 2)
                    name_w = min(avail_name_w, max(15, max_natural_name + 1))
                elif inner_w >= 40:
                    hz_str = c(f"{hz:3.0f}Hz", Ansi.BOLD, hz_col)
                    out_pad = f"{d['output_name']:<5}"
                    tag = c(f"[{idx}]{out_pad}", Ansi.BOLD, Ansi.WHITE)
                    spec = f"{res_pad}{sc_pad}"
                    sep_gap = " "
                    avail_name_w = max(7, inner_w - visible_width(tag) - len(spec) - visible_width(hz_str) - len(sep_gap) - 2)
                    name_w = min(avail_name_w, max(12, max_natural_name))
                else:
                    hz_str = c(f"{hz:3.0f}Hz", Ansi.BOLD, hz_col)
                    tag = c(f"[{idx}]{d['output_name']}", Ansi.BOLD, Ansi.WHITE)
                    spec = res_pad
                    sep_gap = " "
                    name_w = max(7, inner_w - visible_width(tag) - len(spec) - visible_width(hz_str) - len(sep_gap) - 2)
                raw_name = d["display_title"]
                if len(raw_name) > name_w:
                    raw_name = raw_name.replace("Samsung ", "").replace("LG ", "")
                d_title = fit_cell(raw_name, name_w)
                disp_rows.append(f"{tag} {d_title} {c(spec, Ansi.DIM)}{sep_gap}{hz_str}")

            # Row 3: ICC calibration profile per display
            icc_parts: List[str] = []
            for idx, d in enumerate(shown_disps, start=1):
                p_title = d.get("color_profile_title", "Standard")
                if d.get("is_internal"):
                    p_col = Ansi.BRIGHT_CYAN if d.get("color_profile_id") != "unknown" else Ansi.WHITE
                    short_int = p_title if inner_w >= 50 else p_title.split(" (")[0]
                    icc_parts.append(f"[{idx}] {c(short_int, Ansi.BOLD, p_col)}")
                else:
                    short_ext = "Standard" if "Uncalibrated" in p_title or p_title in ("Default / Native", "unknown") else p_title
                    if inner_w < 36 and short_ext == "Standard":
                        short_ext = "Std"
                    icc_parts.append(f"[{idx}] {c(short_ext, Ansi.DIM)}")
            disp_rows.append(f"{c('ICC ', Ansi.BOLD, Ansi.WHITE)}  " + " · ".join(icc_parts))

            # Row 4: Multi-monitor topology summary
            mode_str = "Mirrored" if d_mode == "mirrored" else f"Extended {d_count}x"
            pri_out = next((d["output_name"] for d in displays if d.get("is_primary")), displays[0]["output_name"])
            if inner_w >= 44:
                mode_det = f"· Primary: {pri_out} (Wayland)"
            elif inner_w >= 36:
                mode_det = f"· Primary: {pri_out}"
            else:
                mode_det = f"· Pri: {pri_out}"
            disp_rows.append(
                f"{c('MODE', Ansi.BOLD, Ansi.WHITE)}  {c(mode_str, Ansi.BRIGHT_MAGENTA)} {c(mode_det, Ansi.DIM)}"
            )

            # Row 5: Per-connector GPU MUX source routing (dGPU vs iGPU)
            mux_parts: List[str] = []
            for idx, d in enumerate(shown_disps, start=1):
                g_src = d.get("gpu_source", "iGPU" if d.get("is_internal") else "dGPU")
                g_col = Ansi.BRIGHT_GREEN if g_src == "dGPU" else Ansi.BRIGHT_CYAN
                if inner_w >= 42:
                    mux_parts.append(f"[{idx}] {d['output_name']} ➔ {c(g_src, Ansi.BOLD, g_col)}")
                else:
                    mux_parts.append(f"{d['output_name']}➔{c(g_src, Ansi.BOLD, g_col)}")
            mux_sep = "  ·  " if inner_w >= 44 else " · "
            disp_rows.append(f"{c('MUX ', Ansi.BOLD, Ansi.WHITE)}  " + mux_sep.join(mux_parts))
        else:
            d0 = displays[0] if displays else disp
            hz = d0.get("refresh_rate_hz", 240.0)
            hz_col = Ansi.BRIGHT_GREEN if hz >= 120 else Ansi.BRIGHT_YELLOW
            is_int = d0.get("is_internal", True)
            p_col = Ansi.BRIGHT_CYAN if d0.get("color_profile_id") != "unknown" else Ansi.WHITE
            p_title = d0.get("color_profile_title", "Default / Native")
            panel_tag = "Internal OLED" if is_int else "External Monitor"
            g_src = d0.get("gpu_source", "iGPU" if is_int else "dGPU")
            g_col = Ansi.BRIGHT_GREEN if g_src == "dGPU" else Ansi.BRIGHT_CYAN
            hw_id = d0.get("hw_id", EXPECTED_PANEL_ID)

            # Adaptive non-truncating single-display lines based on exact inner_w
            out_full = f"{c('OUT ', Ansi.BOLD, Ansi.WHITE)}  {c(d0['output_name'], Ansi.BOLD, Ansi.BRIGHT_CYAN)}  ·  {d0['display_title']} ({panel_tag})  ·  EDID: {hw_id}"
            out_mid = f"{c('OUT ', Ansi.BOLD, Ansi.WHITE)}  {c(d0['output_name'], Ansi.BOLD, Ansi.BRIGHT_CYAN)}  ·  {d0['display_title']} ({panel_tag})"
            out_short = f"{c('OUT ', Ansi.BOLD, Ansi.WHITE)}  {c(d0['output_name'], Ansi.BOLD, Ansi.BRIGHT_CYAN)} · {d0['display_title']}"
            out_row = out_full if visible_width(out_full) <= inner_w else (out_mid if visible_width(out_mid) <= inner_w else out_short)

            mode_full = f"{c('MODE', Ansi.BOLD, Ansi.WHITE)}  {d0['resolution']} @ {c(f'{hz:.2f} Hz', Ansi.BOLD, hz_col)}  ·  Scale {d0['scale']:g}x  ·  Wayland Active"
            mode_mid = f"{c('MODE', Ansi.BOLD, Ansi.WHITE)}  {d0['resolution']} @ {c(f'{hz:.2f} Hz', Ansi.BOLD, hz_col)}  ·  Scale {d0['scale']:g}x"
            mode_short = f"{c('MODE', Ansi.BOLD, Ansi.WHITE)}  {d0['resolution']} @ {c(f'{hz:.0f} Hz', Ansi.BOLD, hz_col)} · {d0['scale']:g}x"
            mode_row = mode_full if visible_width(mode_full) <= inner_w else (mode_mid if visible_width(mode_mid) <= inner_w else mode_short)

            icc_full = f"{c('ICC ', Ansi.BOLD, Ansi.WHITE)}  {c(p_title, Ansi.BOLD, p_col)}  ·  {c('Factory Calibrated' if is_int else 'Standard Color', Ansi.DIM)}"
            icc_mid = f"{c('ICC ', Ansi.BOLD, Ansi.WHITE)}  {c(p_title, Ansi.BOLD, p_col)}"
            icc_short = f"{c('ICC ', Ansi.BOLD, Ansi.WHITE)}  {c(p_title.split(' (')[0], Ansi.BOLD, p_col)}"
            icc_row = icc_full if visible_width(icc_full) <= inner_w else (icc_mid if visible_width(icc_mid) <= inner_w else icc_short)

            mux_desc = f"Hybrid Optimus (eDP ➔ {igpu.get('vendor', 'Intel')} iGPU)" if g_src == "iGPU" else f"Direct Scanout ({short_gpu_name})"
            mux_full = f"{c('MUX ', Ansi.BOLD, Ansi.WHITE)}  Driven by {c(g_src, Ansi.BOLD, g_col)}  ·  {c(mux_desc, Ansi.DIM)}"
            mux_mid = f"{c('MUX ', Ansi.BOLD, Ansi.WHITE)}  Driven by {c(g_src, Ansi.BOLD, g_col)} ({panel_tag})"
            mux_short = f"{c('MUX ', Ansi.BOLD, Ansi.WHITE)}  Driven by {c(g_src, Ansi.BOLD, g_col)} ({'OLED' if is_int else 'Ext'})"
            mux_row = mux_full if visible_width(mux_full) <= inner_w else (mux_mid if visible_width(mux_mid) <= inner_w else mux_short)

            pipe_full = f"{c('PIPE', Ansi.BOLD, Ansi.WHITE)}  {c('KWin Wayland Color Management · EDID Verified', Ansi.DIM)}"
            pipe_mid = f"{c('PIPE', Ansi.BOLD, Ansi.WHITE)}  {c('KWin Wayland · EDID Verified', Ansi.DIM)}"
            pipe_short = f"{c('PIPE', Ansi.BOLD, Ansi.WHITE)}  {c('KWin Wayland · EDID OK', Ansi.DIM)}"
            pipe_row = pipe_full if visible_width(pipe_full) <= inner_w else (pipe_mid if visible_width(pipe_mid) <= inner_w else pipe_short)

            disp_rows = [out_row, mode_row, icc_row, mux_row, pipe_row]

        card_title_disp = f"DISPLAYS ({d_mode.upper()} {d_count}X)" if d_count > 1 else "DISPLAY & CALIBRATION"
        card_display = DashboardRenderer._build_card(card_title_disp, disp_rows, card_w)

        # ── Assemble Grid ─────────────────────────────────────────────────────
        lines: List[str] = [header_line]
        if two_col:
            for l_line, r_line in zip(card_thermal, card_power):
                lines.append(f"{l_line}  {r_line}")
            for l_line, r_line in zip(card_compute, card_display):
                lines.append(f"{l_line}  {r_line}")
        else:
            lines.extend(card_thermal)
            lines.extend(card_power)
            lines.extend(card_compute)
            lines.extend(card_display)

        # ── Footer / Interactive Controls Bar ─────────────────────────────────
        if watch_mode:
            has_internal_active = any(d.get("is_internal") for d in displays)
            r_label_wide = "240/60Hz" if has_internal_active else "Hz Cycle"
            if total_w >= 96:
                keys = [
                    ("[p]", "Profile"),
                    ("[1-4]", "Mode"),
                    ("[c]", "80% Cap"),
                    ("[r]", r_label_wide),
                    ("[l]", "Color"),
                    ("[g]", "Graph"),
                    ("[s]", "Shell"),
                    ("[q]", "Quit"),
                ]
                sep_k = "  "
            else:
                keys = [
                    ("[p]", "Prof"),
                    ("[1-4]", "Mode"),
                    ("[c]", "80%"),
                    ("[r]", "Hz"),
                    ("[l]", "ICC"),
                    ("[g]", "Grp"),
                    ("[s]", "Sh"),
                    ("[q]", "Quit"),
                ]
                sep_k = " "
            ctrl_left = " " + sep_k.join(f"{c(k, Ansi.BOLD, Ansi.BRIGHT_CYAN)} {c(v, Ansi.DIM)}" for k, v in keys)
            if status_msg:
                toast = f"{c('▸ ' + status_msg, Ansi.BOLD, Ansi.BRIGHT_GREEN)} "
                if visible_width(ctrl_left) + visible_width(toast) + 1 <= total_w:
                    pad_f = max(1, total_w - visible_width(ctrl_left) - visible_width(toast))
                    lines.append(f"{ctrl_left}{' ' * pad_f}{toast}")
                else:
                    lines.append(f" {toast}")
            else:
                lines.append(fit_cell(ctrl_left, total_w))
        else:
            footer_hint = (
                f" {c('Live TUI & Controls:', Ansi.DIM)} {c('lstats -w', Ansi.BOLD, Ansi.BRIGHT_CYAN)}   "
                f"{c('│', Ansi.DIM)}   {c('JSON:', Ansi.DIM)} {c('lstats -j', Ansi.WHITE)}   "
                f"{c('│', Ansi.DIM)}   {c('Compact:', Ansi.DIM)} {c('lstats -s', Ansi.WHITE)}"
            )
            lines.append(fit_cell(footer_hint, total_w))

        return "\n".join(lines)


# --- Short Single-Line Renderer ---

class ShortRenderer:
    """Formats telemetry data into a compact single-line summary string."""

    @staticmethod
    def render(data: Dict[str, Any]) -> str:
        prof = data["platform_profile"]["alias"].capitalize()
        fans = data["fans"]
        fan_str = f"{fans['cpu_fan']['rpm']}/{fans['gpu_fan']['rpm']}/{fans['aux_fan']['rpm']} RPM"

        cpu = data["cpu"]
        c_temp = f"{cpu['temperature_c']}°C" if cpu.get("temperature_c") else "N/A"
        c_pow = f" {cpu['package_power_w']:.0f}W" if cpu.get("package_power_w") is not None else ""

        gpu = data["gpu"]
        g_state = gpu.get("state")
        g_temp = (
            f"{gpu['temperature_c']}°C"
            if gpu.get("temperature_c") is not None
            else ("Sleep" if g_state == "suspended" else ("Idle" if g_state == "idling" else "N/A"))
        )
        g_pow = f" {gpu['power_draw_w']:.0f}W" if gpu.get("power_draw_w") is not None and gpu["power_draw_w"] > 0 else ""

        bat = data["power_battery"]
        b_str = f"{bat['capacity_percent']}%" if bat["capacity_percent"] is not None else "AC"
        if bat["conservation_mode"]:
            b_str += " (80% Cap)"

        disp = data["display"]
        d_count = disp.get("count", 1)
        d_mode = disp.get("display_mode", "single")

        if d_count > 1 and "displays" in disp and len(disp["displays"]) > 1:
            if d_mode == "mirrored":
                rates = " ⇄ ".join(f"{d['refresh_rate_hz']:.0f}Hz" for d in disp["displays"])
                disp_summary = f"{rates} (Mirror)"
            else:
                parts = []
                for d in disp["displays"]:
                    tag = d["output_name"]
                    parts.append(f"{d['refresh_rate_hz']:.0f}Hz ({tag})")
                disp_summary = " + ".join(parts)
        else:
            disp_str = f"{disp['refresh_rate_hz']:.0f}Hz"
            badge = disp["color_profile_id"].upper() if disp.get("is_internal", True) else disp.get("output_name", "EXT")
            disp_summary = f"{disp_str} ({badge})"

        return f"⚡ {prof} │ 🌀 {fan_str} │ 🧠 CPU {c_temp} {c_pow} │ 🎮 GPU {g_temp} {g_pow} │ 🔋 {b_str} │ 🖥️ {disp_summary}"


def get_user_shell() -> str:
    """
    Resolves the user's active shell preference adhering to system and terminal settings:
    1. Parent process shell: if lstats was launched inside an existing shell session (zsh, bash, fish, etc.)
    2. Terminal configuration: if running in Alacritty (~/.config/alacritty/alacritty.toml)
    3. User login shell: $SHELL / /etc/passwd
    """
    # 1. If launched from an interactive shell, return that exact shell
    try:
        ppid = os.getppid()
        if ppid > 1:
            pcomm = open(f"/proc/{ppid}/comm").read().strip().lower()
            if pcomm in ("zsh", "bash", "fish", "dash", "sh"):
                pexe = os.path.realpath(f"/proc/{ppid}/exe")
                if os.path.exists(pexe) and os.access(pexe, os.X_OK):
                    return pexe
    except Exception:
        pass

    # 2. Check terminal configuration (e.g. Alacritty custom shell)
    try:
        alacritty_cfg = os.path.expanduser("~/.config/alacritty/alacritty.toml")
        if os.path.exists(alacritty_cfg):
            with open(alacritty_cfg, "r", encoding="utf-8") as f:
                for line in f:
                    if "program" in line and "=" in line:
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if os.path.exists(val) and os.access(val, os.X_OK):
                            return val
    except Exception:
        pass

    # 3. Check environment $SHELL
    shell = os.environ.get("SHELL")
    if shell and os.path.exists(shell) and os.access(shell, os.X_OK):
        return shell

    # 4. Check user record in /etc/passwd
    try:
        import pwd
        pw_shell = pwd.getpwuid(os.getuid()).pw_shell
        if pw_shell and os.path.exists(pw_shell) and os.access(pw_shell, os.X_OK):
            return pw_shell
    except Exception:
        pass

    for fallback in ("/usr/bin/zsh", "/bin/zsh", "/usr/bin/fish", "/bin/fish", "/bin/bash", "/bin/sh"):
        if os.path.exists(fallback) and os.access(fallback, os.X_OK):
            return fallback
    return "/bin/sh"


def _dispatch_tui_action(key: bytes) -> Tuple[str, bool]:
    """
    Executes an interactive TUI hotkey action without leaving watch mode.
    Returns (status_toast_message, force_display_refresh).
    """
    try:
        if key in (b"p", b"P", b"1", b"2", b"3", b"4"):
            direct_map = {
                b"1": "low-power",
                b"2": "balanced",
                b"3": "performance",
                b"4": "max-power",
            }
            if key in direct_map:
                target = direct_map[key]
            else:
                cur = get_platform_profile().get("id", "balanced")
                cycle = ["low-power", "balanced", "performance"]
                target = cycle[(cycle.index(cur) + 1) % len(cycle)] if cur in cycle else "balanced"

            if os.path.isfile(PLATFORM_PROFILE_NODE) and os.access(PLATFORM_PROFILE_NODE, os.W_OK):
                with open(PLATFORM_PROFILE_NODE, "w") as f:
                    f.write(target)
                rapl_res = sync_rapl_mmio(profile_id=target)
                p_title = PLATFORM_PROFILES.get(target, {}).get("title", target)
                if rapl_res.get("applied"):
                    return f"{p_title} ({rapl_res['pl1_w']}/{rapl_res['pl2_w']}W)", False
                return f"Switched to {p_title}", False
            return "Profile node not writable", False

        if key in (b"c", b"C"):
            active, node = get_conservation_mode()
            new_val = "0" if active else "1"
            if os.path.isfile(node) and os.access(node, os.W_OK):
                with open(node, "w") as f:
                    f.write(new_val)
                label = "Conservation 80% ON" if new_val == "1" else "Full Charge 100% ON"
                return label, False
            return "Conservation node not writable", False

        if key in (b"r", b"R"):
            lhz_bin = os.path.join(SCRIPT_DIR, "lhz")
            if not os.path.isfile(lhz_bin):
                lhz_bin = shutil.which("lhz") or ""
            if lhz_bin:
                proc = subprocess.run([lhz_bin, "toggle"], capture_output=True, text=True, timeout=2)
                msg = strip_ansi(proc.stdout.strip()).splitlines()[-1] if proc.stdout.strip() else "Refresh rate toggled"
                return msg, True
            return "lhz not found", False

        if key in (b"l", b"L"):
            lcolor_bin = os.path.join(SCRIPT_DIR, "lcolor")
            if not os.path.isfile(lcolor_bin):
                lcolor_bin = shutil.which("lcolor") or ""
            if lcolor_bin:
                proc = subprocess.run([lcolor_bin, "cycle"], capture_output=True, text=True, timeout=2)
                first = strip_ansi(proc.stdout.strip()).splitlines()[0] if proc.stdout.strip() else "Color profile cycled"
                return first.replace("Applied Color Profile: ", ""), True
            return "lcolor not found", False
    except Exception as e:
        return f"Action error: {e}", False
    return "", False


# --- Interactive Live Watch Loop ---

def run_watch_mode(telemetry: TelemetryCollector, interval: float = 1.0, graph_mode: str = "spark"):
    """Runs a real-time terminal dashboard with flicker-free updates and clean screen isolation."""
    is_tty = sys.stdin.isatty() and sys.stdout.isatty()
    stdin_fd = sys.stdin.fileno() if is_tty else None
    old_term_settings = None
    old_sigwinch = None
    drop_shell = False
    resized = False
    force_display = False
    status_msg = ""
    status_until = 0.0
    graph_modes = ("spark", "braille", "gauge")
    graph_labels = {"spark": "Sparkline", "braille": "Braille", "gauge": "Gauge"}
    if graph_mode not in graph_modes:
        graph_mode = "spark"

    pipe_r = None
    pipe_w = None

    if is_tty and stdin_fd is not None:
        try:
            import tty
            import termios
            import signal

            pipe_r, pipe_w = os.pipe()
            os.set_blocking(pipe_r, False)
            os.set_blocking(pipe_w, False)

            def on_sigwinch(signum, frame):
                nonlocal resized
                resized = True
                if pipe_w is not None:
                    try:
                        os.write(pipe_w, b"\x00")
                    except Exception:
                        pass

            try:
                old_sigwinch = signal.signal(signal.SIGWINCH, on_sigwinch)
            except Exception:
                pass

            old_term_settings = termios.tcgetattr(stdin_fd)
            tty.setcbreak(stdin_fd)

            # Enter alternate screen buffer: isolates from shell scrollback history,
            # prevents mouse scrolling from dragging shell history into the viewport,
            # and leaves user's terminal completely pristine upon exit.
            sys.stdout.write(Ansi.ENTER_ALT_SCREEN + Ansi.CURSOR_HIDE + Ansi.CLEAR_SCREEN + Ansi.HOME)
            sys.stdout.flush()
        except Exception:
            is_tty = False

    try:
        while True:
            t_start = time.monotonic()

            term_size = shutil.get_terminal_size(fallback=(80, 24))
            term_cols = term_size.columns
            term_rows = term_size.lines

            if is_tty and resized:
                resized = False
                sys.stdout.write(Ansi.CLEAR_SCREEN + Ansi.HOME)
                sys.stdout.flush()

            # Guard against terminals smaller than base minimum dimensions (58x14)
            # Skips expensive sysfs/NVML telemetry polling completely when the window is too small
            if is_tty and (term_cols < 58 or term_rows < 14):
                warn_lines = [
                    "",
                    c(f"Terminal too small: {term_cols}x{term_rows}", Ansi.BOLD, Ansi.BRIGHT_YELLOW),
                    "Minimum required: 76x16 (2x2 grid) or 58x30 (stacked).",
                    "",
                    c("Please resize / enlarge your terminal window.", Ansi.DIM),
                    c("Press 'q' to quit, 's' for shell (Ctrl+C to exit)", Ansi.DIM),
                ]
                frame = Ansi.HOME + "\n".join(fit_cell(l, term_cols, align="^") + Ansi.CLEAR_LINE for l in warn_lines) + Ansi.CLEAR_TO_END
                sys.stdout.write(frame)
                sys.stdout.flush()
            else:
                active_toast = status_msg if time.monotonic() < status_until else ""
                data = telemetry.collect_all(sample_interval=0.0, force_display=force_display)
                force_display = False
                output = DashboardRenderer.render(
                    data,
                    width=term_cols,
                    height=term_rows,
                    history=telemetry.history,
                    watch_mode=True,
                    status_msg=active_toast,
                    graph_mode=graph_mode,
                )

                if is_tty:
                    raw_lines = output.split("\n")
                    min_required_rows = len(raw_lines)

                    # Secondary guard: dynamically checks if stacked narrow layout needs more vertical rows
                    if term_rows < min_required_rows:
                        warn_lines = [
                            "",
                            c(f"Terminal too small: {term_cols}x{term_rows}", Ansi.BOLD, Ansi.BRIGHT_YELLOW),
                            f"Minimum required: {term_cols}x{min_required_rows} for current layout.",
                            "",
                            c("Please resize / enlarge your terminal window.", Ansi.DIM),
                            c("Press 'q' to quit, 's' for shell (Ctrl+C to exit)", Ansi.DIM),
                        ]
                        frame = Ansi.HOME + "\n".join(fit_cell(l, term_cols, align="^") + Ansi.CLEAR_LINE for l in warn_lines) + Ansi.CLEAR_TO_END
                        sys.stdout.write(frame)
                        sys.stdout.flush()
                    else:
                        framed_lines = [line + Ansi.CLEAR_LINE for line in raw_lines]
                        frame_body = "\n".join(framed_lines)
                        sys.stdout.write(Ansi.HOME + frame_body + Ansi.CLEAR_TO_END)
                        sys.stdout.flush()
                else:
                    print(output)

            while True:
                elapsed = time.monotonic() - t_start
                remaining = max(0.0, interval - elapsed)
                if remaining <= 0.0 or resized:
                    break

                if is_tty and stdin_fd is not None:
                    import select
                    poll_fds = [stdin_fd]
                    if pipe_r is not None:
                        poll_fds.append(pipe_r)

                    r, _, _ = select.select(poll_fds, [], [], remaining)

                    if pipe_r is not None and pipe_r in r:
                        try:
                            os.read(pipe_r, 1024)
                        except Exception:
                            pass
                        if resized:
                            break

                    if stdin_fd in r:
                        try:
                            # Read raw bytes directly from fd to avoid Python TextIOWrapper buffer eating multi-byte escape sequences
                            data_bytes = os.read(stdin_fd, 64)
                        except Exception:
                            data_bytes = b""

                        if not data_bytes:
                            continue

                        # 1. Escape sequences (multi-byte, e.g. arrow keys \x1b[A, mouse reporting \x1b[<...)
                        if data_bytes.startswith(b"\x1b"):
                            if data_bytes == b"\x1b":
                                # Check if further bytes follow immediately (e.g. fragmented escape sequence)
                                r_esc, _, _ = select.select([stdin_fd], [], [], 0.03)
                                if r_esc:
                                    try:
                                        os.read(stdin_fd, 64)
                                    except Exception:
                                        pass
                                    continue
                                else:
                                    # Standalone Escape press -> quit
                                    return
                            else:
                                # Multi-byte escape sequence (arrow keys, mouse clicks, function keys), swallow and continue
                                continue

                        # 2. Direct single keystrokes
                        if data_bytes in (b"q", b"Q", b"\x03"):  # q, Ctrl+C
                            return
                        elif data_bytes in (b"s", b"S"):
                            drop_shell = True
                            return
                        elif data_bytes in (b"g", b"G"):
                            cur_idx = graph_modes.index(graph_mode)
                            graph_mode = graph_modes[(cur_idx + 1) % len(graph_modes)]
                            status_msg = f"Graph: {graph_labels[graph_mode]}"
                            status_until = time.monotonic() + 2.2
                            break
                        elif data_bytes in (b"p", b"P", b"1", b"2", b"3", b"4", b"c", b"C", b"r", b"R", b"l", b"L"):
                            msg, disp_dirty = _dispatch_tui_action(data_bytes)
                            if msg:
                                status_msg = msg
                                status_until = time.monotonic() + 2.8
                            if disp_dirty:
                                force_display = True
                            break
                else:
                    time.sleep(remaining)
                    break

    except KeyboardInterrupt:
        pass
    finally:
        if is_tty and stdin_fd is not None:
            if old_term_settings:
                try:
                    import termios
                    termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_term_settings)
                except Exception:
                    pass
            # Exit alternate screen buffer and restore cursor
            sys.stdout.write(Ansi.CURSOR_SHOW + Ansi.EXIT_ALT_SCREEN)
            sys.stdout.flush()

        if old_sigwinch is not None:
            try:
                import signal
                signal.signal(signal.SIGWINCH, old_sigwinch)
            except Exception:
                pass

        if pipe_r is not None:
            try:
                os.close(pipe_r)
            except Exception:
                pass
        if pipe_w is not None:
            try:
                os.close(pipe_w)
            except Exception:
                pass

        if drop_shell:
            telemetry.close()
            user_sh = get_user_shell()
            sh_name = os.path.basename(user_sh)
            try:
                os.execlp(user_sh, sh_name)
            except Exception as e:
                print(f"Failed to drop to shell {user_sh}: {e}", file=sys.stderr)
                sys.exit(1)


# --- Main CLI Entrypoint ---

def main():
    parser = argparse.ArgumentParser(
        prog="lstats",
        description="Hardware & Platform Telemetry CLI for Lenovo Legion Pro 7.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  lstats               Show comprehensive hardware & platform status snapshot
  lstats -w            Launch live-updating real-time monitor (1s interval)
  lstats -w 0.5        Launch live monitor updating every 500ms
  lstats -j            Export complete telemetry tree as structured JSON
  lstats -s            Print compact single-line telemetry string
        """,
    )
    parser.add_argument(
        "-w", "--watch",
        nargs="?", const=1.0, type=float, default=None,
        metavar="INTERVAL",
        help="Run in live continuous watch mode (default interval: 1.0s)",
    )
    parser.add_argument(
        "-j", "--json",
        action="store_true",
        help="Output full telemetry as formatted JSON",
    )
    parser.add_argument(
        "-s", "--short",
        action="store_true",
        help="Output single-line compact telemetry summary",
    )
    parser.add_argument(
        "-g", "--graph",
        choices=("spark", "braille", "gauge"),
        default="spark",
        help="Watch-mode graph style: spark (block sparkline), braille (high-density wave), or gauge (bar)",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI color output",
    )

    args = parser.parse_args()

    if args.no_color:
        global COLOR_ENABLED
        COLOR_ENABLED = False

    telemetry = TelemetryCollector()
    try:
        if args.json:
            data = telemetry.collect_all(sample_interval=0.05)
            print(json.dumps(data, indent=2))
        elif args.short:
            data = telemetry.collect_all(sample_interval=0.05)
            print(ShortRenderer.render(data))
        elif args.watch is not None:
            interval = max(0.2, float(args.watch))
            run_watch_mode(telemetry, interval=interval, graph_mode=args.graph)
        else:
            data = telemetry.collect_all(sample_interval=0.05)
            ts = shutil.get_terminal_size(fallback=(104, 28))
            print(DashboardRenderer.render(data, width=ts.columns, height=ts.lines, history=telemetry.history, watch_mode=False))
    finally:
        telemetry.close()


if __name__ == "__main__":
    main()
