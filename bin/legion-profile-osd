def send_error_osd(title, msg):
    """Shows a persistent desktop error notification for user-visible failures."""
    ensure_gui_environment()
    cmd = [
        "notify-send",
        "-a", "Legion Toolkit",
        "-i", "dialog-error",
        "-u", "critical",
        "-t", "5000",
        title,
        msg
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

_detached_pids = set()
_detached_lock = threading.Lock()


def reap_zombies():
    """Reaps terminated detached child processes without stealing waitpid from subprocess.run()."""
    with _detached_lock:
        for pid in list(_detached_pids):
            try:
                waited_pid, _ = os.waitpid(pid, os.WNOHANG)
                if waited_pid == pid:
                    _detached_pids.discard(pid)
            except ChildProcessError:
                _detached_pids.discard(pid)
            except OSError:
                pass

def check_external_displays_connected() -> bool:
    """Checks sysfs to determine if any non-eDP DRM display connector is currently connected."""
    for p in glob.glob("/sys/class/drm/*-*/status"):
        if "-eDP-" not in p:
            try:
                with open(p, "r") as f:
                    if f.read().strip() == "connected":
                        return True
            except Exception:
                pass
    return False

def is_display_sleeping() -> bool:
    """
    Checks if the session's active display(s) have entered DPMS sleep / screen blanking.
    Evaluates ALL connected DRM connectors:
    - If ANY connected connector is currently DPMS 'On', the display session is awake (False).
    - If ALL connected connectors are DPMS != 'On' (Off/Standby/Suspend), the session is asleep (True).
    This properly handles External-Only / Clamshell mode where eDP-1 is 'connected' + 'dpms=Off'
    while DP-1 is 'On', and avoids false wakeups when DP-1 drops HPD during DPMS sleep.
    """
    connected_any = False
    for p in glob.glob("/sys/class/drm/card*-*"):
        try:
            status_p = os.path.join(p, "status")
            dpms_p = os.path.join(p, "dpms")
            if os.path.isfile(status_p) and os.path.isfile(dpms_p):
                with open(status_p, "r") as f_st:
                    if f_st.read().strip().lower() == "connected":
                        connected_any = True
                        with open(dpms_p, "r") as f_dp:
                            if f_dp.read().strip().lower() == "on":
                                return False
        except Exception:
            pass
    return connected_any


def is_internal_edp_on() -> bool:
    """Returns True if any connected internal eDP connector is currently powered on (DPMS On)."""
    for p in glob.glob("/sys/class/drm/*-eDP-*"):
        try:
            status_p = os.path.join(p, "status")
            dpms_p = os.path.join(p, "dpms")
            if os.path.isfile(status_p) and os.path.isfile(dpms_p):
                with open(status_p, "r") as f_st:
                    if f_st.read().strip().lower() == "connected":
                        with open(dpms_p, "r") as f_dp:
                            if f_dp.read().strip().lower() == "on":
                                return True
        except Exception:
            pass
    return False

def is_session_locked() -> bool:
    """Checks if KDE screensaver / lockscreen is currently active."""
    try:
        res = subprocess.run(
            ["qdbus6", "org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver.GetActive"],
            capture_output=True,
            text=True,
            timeout=1,
        )
        return res.stdout.strip().lower() == "true"
    except Exception:
        return False

# Tracks deferred PowerDevil backlight recovery if an external display was disconnected while sleeping/locked
_deferred_drm_recovery = False


def _get_powerdevil_profile() -> str:
    """
    Queries KDE PowerDevil's active power profile ('AC', 'Battery', 'LowBattery').
    Falls back to sysfs AC online check if PowerDevil DBus is momentarily unavailable.
    """
    qdbus_bin = shutil.which("qdbus6")
    if qdbus_bin:
        try:
            p = subprocess.run(
                [qdbus_bin, "org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement",
                 "org.kde.Solid.PowerManagement.currentProfile"],
                capture_output=True, text=True, timeout=1.0,
            )
            prof = p.stdout.strip()
            if prof in ("AC", "Battery", "LowBattery"):
                return prof
        except Exception:
            pass
    return "AC" if is_ac_online() else "Battery"


def read_powerdevil_display_timeouts():
    """
    Reads the user's KDE Plasma Power Management GUI settings from ~/.config/powerdevilrc
    for the active PowerDevil profile (AC, Battery, or LowBattery).
    Returns (dim_timeout_sec, turnoff_timeout_sec) where 0 means disabled.
    """
    profile = _get_powerdevil_profile()
    # KDE Plasma 6 PowerDevil built-in defaults when keys are omitted
    dim_en = True
    off_en = True
    if profile == "AC":
        dim_sec, off_sec = 300, 600
    elif profile == "LowBattery":
        dim_sec, off_sec = 60, 120
    else:
        dim_sec, off_sec = 120, 300

    cfg_path = os.path.expanduser("~/.config/powerdevilrc")
    if not os.path.isfile(cfg_path):
        return (dim_sec if dim_en else 0), (off_sec if off_en else 0)

    section_target = f"[{profile}][Display]"
    in_sec = False
    try:
        with open(cfg_path, "r", encoding="utf-8", errors="ignore") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    in_sec = (line == section_target)
                    continue
                if not in_sec or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                if k == "DimDisplayWhenIdle":
                    dim_en = (v.lower() == "true")
                elif k == "DimDisplayIdleTimeoutSec":
                    try:
                        dim_sec = int(v)
                    except ValueError:
                        pass
                elif k == "TurnOffDisplayWhenIdle":
                    off_en = (v.lower() == "true")
                elif k == "TurnOffDisplayIdleTimeoutSec":
                    try:
                        off_sec = int(v)
                    except ValueError:
                        pass
    except Exception:
        pass

    return (dim_sec if (dim_en and dim_sec > 0) else 0), (off_sec if (off_en and off_sec > 0) else 0)


def _get_external_screen_brightness_displays():
    """Returns list of (dbus_obj_name, label, brightness, max_brightness) for external displays in org.kde.ScreenBrightness."""
    res = []
    qdbus_bin = shutil.which("qdbus6")
    if not qdbus_bin:
        return res
    try:
        p = subprocess.run(
            [qdbus_bin, "org.kde.ScreenBrightness", "/org/kde/ScreenBrightness",
             "org.freedesktop.DBus.Properties.Get", "org.kde.ScreenBrightness", "DisplaysDBusNames"],
            capture_output=True, text=True, timeout=1.5,
        )
        names = [n.strip() for n in p.stdout.splitlines() if n.strip()]
        for name in names:
            p2 = subprocess.run(
                [qdbus_bin, "org.kde.ScreenBrightness", f"/org/kde/ScreenBrightness/{name}",
                 "org.freedesktop.DBus.Properties.GetAll", "org.kde.ScreenBrightness.Display"],
                capture_output=True, text=True, timeout=1.5,
            )
            props = {}
            for line in p2.stdout.splitlines():
                if ":" in line:
                    k, v = line.split(":", 1)
                    props[k.strip()] = v.strip()
            if props.get("IsInternal", "").lower() == "false":
                br = int(props.get("Brightness", "0"))
                mx = int(props.get("MaxBrightness", "10000"))
                label = props.get("Label", name)
                if mx > 0:
                    res.append((name, label, br, mx))
    except Exception:
        pass
    return res


def _set_screen_brightness_silent(obj_name, value):
    """Sets brightness silently via KDE org.kde.ScreenBrightness (flags=1 SuppressIndicator)."""
    qdbus_bin = shutil.which("qdbus6")
    if not qdbus_bin:
        return False
    try:
        r = subprocess.run(
            [qdbus_bin, "org.kde.ScreenBrightness", f"/org/kde/ScreenBrightness/{obj_name}",
             "org.kde.ScreenBrightness.Display.SetBrightness", str(int(value)), "1"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2.0,
        )
        return r.returncode == 0
    except Exception:
        return False


def _is_powerdevil_inhibited() -> bool:
    """Checks if any application holds a PowerManagement idle/screen inhibition."""
    qdbus_bin = shutil.which("qdbus6")
    if not qdbus_bin:
        return False
    try:
        p = subprocess.run(
            [qdbus_bin, "org.freedesktop.PowerManagement.Inhibit",
             "/org/freedesktop/PowerManagement/Inhibit",
             "org.freedesktop.PowerManagement.Inhibit.HasInhibit"],
            capture_output=True, text=True, timeout=1.0,
        )
        return p.stdout.strip().lower() == "true"
    except Exception:
        return False


class SessionDBusListener:
    """
    Minimal pure-Python DBus1 UNIX-socket signal listener (zero external libraries,
    zero child processes, 0% idle CPU inside select.poll()).
    Subscribes to:
      - org.kde.ScreenBrightness.DisplayAdded          -> exact instant DDC/CI external monitor is ready
      - org.kde.Solid.PowerManagement.profileChanged   -> instant AC/Battery/LowBattery transition
      - org.kde.Solid.PowerManagement.configurationReloaded -> instant Power Management GUI Apply
    """

    MATCH_RULES = (
        "type='signal',interface='org.kde.ScreenBrightness',member='DisplayAdded'",
        "type='signal',interface='org.kde.Solid.PowerManagement',member='profileChanged'",
        "type='signal',interface='org.kde.Solid.PowerManagement',member='configurationReloaded'",
    )

    def __init__(self):
        self.sock = None
        self.serial = 1
        self.buf = b""

    @staticmethod
    def _pad(n, align):
        return (align - (n % align)) % align

    @classmethod
    def _dbus_str(cls, s, buf_len):
        b = s.encode("utf-8") + b"\x00"
        return b"\x00" * cls._pad(buf_len, 4) + struct.pack("<I", len(b) - 1) + b

    @classmethod
    def _dbus_sig(cls, s):
        b = s.encode("utf-8")
        return struct.pack("<B", len(b)) + b + b"\x00"

    def _build_call(self, dest, path, iface, member, str_args=()):
        serial = self.serial
        self.serial += 1
        body = b""
        for a in str_args:
            body += self._dbus_str(a, len(body))

        fields = b""
        def add_field(code, sig, val_str):
            nonlocal fields
            fields += b"\x00" * self._pad(len(fields), 8)
            fields += struct.pack("<B", code) + self._dbus_sig(sig)
            fields += self._dbus_str(val_str, len(fields))

        add_field(1, "o", path)
        add_field(2, "s", iface)
        add_field(3, "s", member)
        add_field(6, "s", dest)
        if str_args:
            fields += b"\x00" * self._pad(len(fields), 8)
            fields += struct.pack("<B", 8) + self._dbus_sig("g") + self._dbus_sig("s" * len(str_args))

        hdr = struct.pack("<BBBBIII", ord("l"), 1, 0, 1, len(body), serial, len(fields)) + fields
        hdr += b"\x00" * self._pad(len(hdr), 8)
        return hdr + body

    def connect(self):
        self.close()
        ensure_gui_environment()
        addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path=/run/user/{os.getuid()}/bus"
        path = None
        for part in addr.split(","):
            if part.startswith("unix:path="):
                path = part.split("=", 1)[1]
                break
        if not path or not os.path.exists(path):
            return False

        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2.0)
        try:
            s.connect(path)
            uid_hex = str(os.getuid()).encode("ascii").hex().encode("ascii")
            s.sendall(b"\x00AUTH EXTERNAL " + uid_hex + b"\r\n")
            resp = b""
            while b"\r\n" not in resp:
                chunk = s.recv(256)
                if not chunk:
                    raise OSError("DBus auth closed")
                resp += chunk
            if not resp.startswith(b"OK "):
                raise OSError(f"DBus auth rejected: {resp!r}")
            s.sendall(b"BEGIN\r\n")
            self.sock = s
            self.buf = b""
            self.serial = 1
            s.sendall(self._build_call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "Hello"))
            for rule in self.MATCH_RULES:
                s.sendall(self._build_call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "AddMatch", (rule,)))
            s.setblocking(False)
            return True
        except Exception as e:
            print(f"[DISPLAY/DBUS] Notice: Session DBus signal listener unavailable: {e}", flush=True)
            try:
                s.close()
            except Exception:
                pass
            self.sock = None
            return False

    def fileno(self):
        return self.sock.fileno() if self.sock else -1

    def close(self):
        if self.sock:
            try:
                self.sock.close()
            except Exception:
                pass
        self.sock = None
        self.buf = b""

    def read_signals(self):
        """Reads pending DBus messages; returns list of (iface, member, arg0) or None if disconnected."""
        if not self.sock:
            return None
        signals = []
        while True:
            try:
                chunk = self.sock.recv(4096)
                if not chunk:
                    return None
                self.buf += chunk
            except BlockingIOError:
                break
            except Exception:
                return None

        while len(self.buf) >= 16:
            endian, mtype, _flags, _ver, body_len, _serial, flen = struct.unpack("<BBBBIII", self.buf[:16])
            hdr_end = 16 + flen
            hdr_padded = hdr_end + self._pad(hdr_end, 8)
            total = hdr_padded + body_len
            if len(self.buf) < total:
                break
            hdr_fields = self.buf[16:hdr_end]
            body = self.buf[hdr_padded:total]
            self.buf = self.buf[total:]
            if mtype == 4:  # DBUS_MESSAGE_TYPE_SIGNAL
                pos = 0
                iface = ""
                member = ""
                while pos < len(hdr_fields):
                    pos += self._pad(pos, 8)
                    if pos + 2 > len(hdr_fields):
                        break
                    code = hdr_fields[pos]
                    sig_len = hdr_fields[pos + 1]
                    sig = hdr_fields[pos + 2:pos + 2 + sig_len].decode("ascii", "ignore")
                    pos += 2 + sig_len + 1
                    if sig in ("s", "o"):
                        pos += self._pad(pos, 4)
                        if pos + 4 > len(hdr_fields):
                            break
                        slen = struct.unpack("<I", hdr_fields[pos:pos + 4])[0]
                        val = hdr_fields[pos + 4:pos + 4 + slen].decode("utf-8", "ignore")
                        pos += 4 + slen + 1
                        if code == 2:
                            iface = val
                        elif code == 3:
                            member = val
                    elif sig == "g":
                        if pos >= len(hdr_fields):
                            break
                        slen = hdr_fields[pos]
                        pos += 1 + slen + 1
                    elif sig == "u":
                        pos += self._pad(pos, 4) + 4
                    else:
                        break
                arg0 = ""
                if len(body) >= 5:
                    slen = struct.unpack("<I", body[:4])[0]
                    if 4 + slen <= len(body):
                        arg0 = body[4:4 + slen].decode("utf-8", "ignore")
                signals.append((iface, member, arg0))
        return signals


class WaylandIdleDpmsGuard:
    """
    Pure-Python, strictly event-driven Wayland client (ext_idle_notifier_v1 + org_kde_kwin_dpms_manager
    + wl_output v4 name/mode tracking). Zero polling, zero sleep-guessing loops, 0% idle CPU.

    Architecture:
      1. External Dimming: listens to ext_idle_notifier_v1 (honoring video/game idle inhibitors)
         and dims external DDC/CI displays via org.kde.ScreenBrightness at DimDisplayIdleTimeoutSec.
         On wake/resume, restores immediately if online, and whenever a display re-appears after
         DPMS wake or S3 resume, SessionDBusListener receives org.kde.ScreenBrightness.DisplayAdded
         and triggers an instant, zero-retry restore — regardless of monitor/dock wake speed.
      2. Authoritative KWin DPMS Pinning: tracks org_kde_kwin_dpms on all wl_outputs (idle,
         lockscreen "When locked", or manual DPMS Off). Pins external DRM status nodes to 'on'
         on DPMS Off and releases back to 'detect' on DPMS On (or daemon exit / config reload).
      3. Dynamic EDID & Mode-Table Fallback Recovery: tracks each wl_output's connector name and
         pre-sleep active width + EDID presence without hardcoded resolution thresholds. On wake,
         detects genuine EDID loss (edid=0B when EDID was previously present), KWin mode-table
         staleness (kwin_max_w < kernel progressive sysfs_max_w), or actual active-width drop
         below pre-sleep width, triggering a single off->detect EDID reprobe guarded by
         _reprobing_connectors.
    """

    def __init__(self):
        self.sock = None
        self.buf = b""
        self.next_id = 4
        self.seat_id = None
        self.idle_mgr_id = None
        self.dpms_mgr_id = None
        self.dim_notif_id = None
        self.off_notif_id = None
        self.dim_sec = 0
        self.off_sec = 0
        self.is_dim_idle = False
        self.is_off_idle = False
        self.dpms_all_off = False
        self._wl_outputs = {}       # {global_name: (wl_output_id, dpms_obj_id)}
        self._oid_to_name = {}      # {wl_output_id: connector_name (e.g. 'DP-1')}
        self._oid_to_width = {}     # {wl_output_id: active_width_px}
        self._oid_to_did = {}       # {wl_output_id: dpms_obj_id}
        self._dpms_modes = {}       # {dpms_obj_id: mode_int} (0=On, 1=Standby, 2=Suspend, 3=Off)
        self._dimmed_saved = {}     # {label: orig_brightness}
        self._pinned_connectors = set()    # {/sys/class/drm/.../status}
        self._pinned_state = {}            # {connector_name: (pre_sleep_wl_width, had_edid_bool)}
        self._reprobing_connectors = set() # {connector_name} currently undergoing off->detect
        self._wake_guard_until = 0.0       # short safety ceiling for _reprobing_connectors
        self._last_reoff_ts = 0.0
        self._reoff_timer = None
        self._wake_verify_timer = None
        self._lock = threading.Lock()
        self._restore_lock = threading.Lock()

    @property
    def is_sleeping_or_idle(self) -> bool:
        return self.dpms_all_off or self.is_off_idle

    @property
    def is_reprobing(self) -> bool:
        return bool(self._reprobing_connectors) and time.monotonic() < self._wake_guard_until

    def clear_reprobing(self):
        self._reprobing_connectors.clear()
        self._wake_guard_until = 0.0

    def _send(self, obj_id, opcode, payload=b""):
        if not self.sock:
            return
        msg = struct.pack("<IHH", obj_id, opcode, 8 + len(payload)) + payload
        self.sock.sendall(msg)

    @staticmethod
    def _wl_str(s):
        b = s.encode("utf-8") + b"\x00"
        return struct.pack("<I", len(b)) + b + b"\x00" * ((4 - len(b) % 4) % 4)

    def _alloc_id(self):
        oid = self.next_id
        self.next_id += 1
        return oid

    def _bind_wl_output(self, global_name, ver):
        if global_name in self._wl_outputs:
            return
        oid = self._alloc_id()
        self._send(2, 0, struct.pack("<I", global_name) + self._wl_str("wl_output") + struct.pack("<II", min(ver, 4), oid))
        did = None
        if self.dpms_mgr_id:
            did = self._alloc_id()
            self._send(self.dpms_mgr_id, 0, struct.pack("<II", did, oid))  # org_kde_kwin_dpms_manager.get
            self._oid_to_did[oid] = did
        self._wl_outputs[global_name] = (oid, did)

    def _unbind_wl_output(self, global_name):
        entry = self._wl_outputs.pop(global_name, None)
        if not entry:
            return
        oid, did = entry
        self._oid_to_name.pop(oid, None)
        self._oid_to_width.pop(oid, None)
        self._oid_to_did.pop(oid, None)
        if did is not None:
            self._dpms_modes.pop(did, None)
        try:
            if did is not None:
                self._send(did, 1)  # org_kde_kwin_dpms.release()
            self._send(oid, 0)      # wl_output.release()
        except Exception:
            pass

    def _cancel_reoff_timer(self):
        if self._reoff_timer:
            try:
                self._reoff_timer.cancel()
            except Exception:
                pass
            self._reoff_timer = None

    def _cancel_wake_verify_timer(self):
        if self._wake_verify_timer:
            try:
                self._wake_verify_timer.cancel()
            except Exception:
                pass
            self._wake_verify_timer = None

    @staticmethod
    def _read_sysfs_connector_health(name: str):
        """
        Reads kernel DRM sysfs directly for an external connector (0 subprocesses).
        Returns (status_path, edid_bytes, max_mode_width_px) or (None, -1, -1) if not connected/writable.
        """
        for sp in sorted(glob.glob(f"/sys/class/drm/card*-{name}/status")):
            if not os.access(sp, os.W_OK):
                continue
            try:
                with open(sp, "r") as f:
                    if f.read().strip().lower() != "connected":
                        continue
            except Exception:
                continue
            conn_dir = os.path.dirname(sp)
            edid_len = -1
            edid_p = os.path.join(conn_dir, "edid")
            if os.path.isfile(edid_p):
                try:
                    with open(edid_p, "rb") as f:
                        edid_len = len(f.read())
                except Exception:
                    pass
            max_w = 0
            modes_p = os.path.join(conn_dir, "modes")
            if os.path.isfile(modes_p):
                try:
                    with open(modes_p, "r") as f:
                        for line in f:
                            # Match progressive modes only (exclude interlaced 'WxHi' modes KWin may filter)
                            m = re.match(r"^(\d+)x\d+$", line.strip())
                            if m:
                                max_w = max(max_w, int(m.group(1)))
                except Exception:
                    pass
            return sp, edid_len, max_w
        return None, -1, -1

    def _trigger_edid_reprobe(self, name: str, status_path: str, reason: str):
        with self._lock:
            if name in self._reprobing_connectors:
                return
            self._pinned_state.pop(name, None)
            self._reprobing_connectors.add(name)
            self._wake_guard_until = time.monotonic() + 10.0

        def _do_reprobe():
            try:
                print(f"[DISPLAY/IDLE] {name} woke in fallback state ({reason}) ➔ forcing EDID reprobe", flush=True)
                with open(status_path, "w") as f:
                    f.write("off")
                time.sleep(0.25)
                with open(status_path, "w") as f:
                    f.write("detect")
            except Exception as e:
                print(f"[DISPLAY/IDLE] EDID reprobe error on {name}: {e}", flush=True)
                with self._lock:
                    self._reprobing_connectors.discard(name)

        threading.Thread(target=_do_reprobe, daemon=True).start()

    def _check_vga_fallback_for_connector(
        self,
        name: str,
        wl_width: int = 0,
        kwin_max_w: int = 0,
        allow_clear: bool = False,
    ):
        """
        Dynamic, resolution-agnostic EDID & mode-table fallback detector (no hardcoded pixel thresholds).
        Works identically across 4K, 1440p, 1080p, 720p, native XGA (1024x768), SVGA (800x600),
        no-EDID analog VGA dongles, and intentional low-res/4:3 mirror selections.

        Triggers a single off->detect EDID reprobe ONLY when objective hardware/compositor state proves fallback:
          1. EDID disappeared during sleep: edid_len == 0 (when display had EDID pre-sleep, or unknown).
          2. KWin mode table is stale vs kernel EDID: edid_len >= 128 and 0 < kwin_max_w < sysfs_max_w.
          3. Active output width actually dropped below recorded pre-sleep active width: 0 < wl_width < prev_w.
        """
        if self.is_sleeping_or_idle:
            return
        if not name or name.startswith("eDP"):
            return
        with self._lock:
            if name in self._reprobing_connectors:
                return
            pinned = self._pinned_state.get(name)

        prev_w, prev_had_edid = pinned if pinned is not None else (0, True)

        status_path, edid_len, max_mode_w = self._read_sysfs_connector_health(name)
        if not status_path:
            return

        edid_lost = (edid_len == 0) and prev_had_edid
        kwin_stale = (edid_len >= 128) and (0 < kwin_max_w < max_mode_w)
        res_dropped = (prev_w > 0) and (0 < wl_width < prev_w)

        if edid_lost or kwin_stale or res_dropped:
            reasons = []
            if edid_lost:
                reasons.append(f"edid=0B, sysfs_max={max_mode_w}px")
            if kwin_stale:
                reasons.append(f"kwin_max={kwin_max_w}px < sysfs_max={max_mode_w}px")
            if res_dropped:
                reasons.append(f"active={wl_width}px < pre_sleep={prev_w}px")
            self._trigger_edid_reprobe(name, status_path, "; ".join(reasons))
            return

        # Only clear _pinned_state once deferred wake verification confirms KWin + sysfs agree
        # (so stale pre-sleep wl_output widths at t=0 cannot clear pre-sleep baseline prematurely,
        # while subsequent manual user resolution changes while awake never false-trigger).
        if allow_clear:
            with self._lock:
                self._pinned_state.pop(name, None)

    def _check_vga_fallback_for_output(self, oid):
        name = self._oid_to_name.get(oid, "")
        width = self._oid_to_width.get(oid, 0)
        if not name or name.startswith("eDP"):
            return
        self._check_vga_fallback_for_connector(name, wl_width=width)

    @staticmethod
    def _query_kwin_output_modes() -> dict:
        """
        Queries KWin's current output mode table once via clean JSON (`kscreen-doctor -j`).
        Returns {connector_name: (current_width_px, max_mode_width_px)} for connected enabled external outputs.
        """
        result = {}
        try:
            ensure_gui_environment()
            p = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=1.5)
            if p.returncode != 0 or not p.stdout:
                return result
            data = json.loads(p.stdout)
            for out in data.get("outputs", []):
                cname = out.get("name", "")
                if not cname or cname.startswith("eDP"):
                    continue
                if not (out.get("connected") and out.get("enabled")):
                    continue
                cur_id = str(out.get("currentModeId", ""))
                cur_w = 0
                max_w = 0
                for mode in out.get("modes", []):
                    w = int(mode.get("size", {}).get("width", 0) or 0)
                    if w > max_w:
                        max_w = w
                    if str(mode.get("id", "")) == cur_id:
                        cur_w = w
                result[cname] = (cur_w, max_w)
        except Exception:
            pass
        return result

    def _on_wake(self, was_asleep: bool):
        self._cancel_reoff_timer()
        self._cancel_wake_verify_timer()
        released_names = self._set_external_drm_status_pin(False)
        # Inspect all external connectors immediately (both tracked wl_outputs and any connector
        # we just unpinned from 'on' -> 'detect') BEFORE attempting brightness restore so saved
        # brightness is never consumed on a dying pre-reprobe handle.
        if was_asleep or released_names:
            checked = set()
            for oid in list(self._oid_to_name.keys()):
                cname = self._oid_to_name.get(oid, "")
                if cname and not cname.startswith("eDP"):
                    checked.add(cname)
                    self._check_vga_fallback_for_output(oid)
            for cname in released_names:
                if cname not in checked:
                    self._check_vga_fallback_for_connector(cname)

            # Deferred verification: covers BOTH races after unpinning:
            #  a) kernel takes ~0.3-0.9s to finish detect/modeset
            #  b) kernel recovers EDID on 'detect' while KWin stays stuck on its cached
            #     no-EDID fallback mode table without emitting a new wl_output.mode event
            with self._lock:
                pinned_names = set(self._pinned_state.keys())
            verify_names = set(released_names) | pinned_names | checked
            if verify_names and not self.is_reprobing:
                def _deferred_verify():
                    if self.is_sleeping_or_idle or self.is_reprobing:
                        return
                    kwin_modes = self._query_kwin_output_modes()
                    for cname in sorted(verify_names):
                        oid_w = next(
                            (self._oid_to_width.get(o, 0) for o, n in list(self._oid_to_name.items()) if n == cname),
                            0,
                        )
                        kwin_cur_w, kwin_max_w = kwin_modes.get(cname, (0, 0))
                        self._check_vga_fallback_for_connector(
                            cname,
                            wl_width=kwin_cur_w or oid_w,
                            kwin_max_w=kwin_max_w,
                            allow_clear=True,
                        )
                    if self._dimmed_saved and not self.is_dim_idle and not self.is_sleeping_or_idle and not self.is_reprobing:
                        threading.Thread(target=self.restore_external_dim, daemon=True).start()

                self._wake_verify_timer = threading.Timer(0.9, _deferred_verify)
                self._wake_verify_timer.daemon = True
                self._wake_verify_timer.start()

        if self._dimmed_saved and not self.is_reprobing:
            threading.Thread(target=self.restore_external_dim, daemon=True).start()

    def _evaluate_dpms_state(self):
        if not self._dpms_modes:
            return
        all_off = all(mode != 0 for mode in self._dpms_modes.values())
        if all_off and not self.dpms_all_off:
            self._cancel_wake_verify_timer()
            self.dpms_all_off = True
            print("[DISPLAY/DPMS] KWin DPMS Off detected ➔ pinning external DRM connectors", flush=True)
            self._set_external_drm_status_pin(True)
        elif not all_off and self.dpms_all_off:
            self.dpms_all_off = False
            self.is_off_idle = False
            self.is_dim_idle = False
            print("[DISPLAY/DPMS] KWin DPMS On detected ➔ releasing connector pin", flush=True)
            self._on_wake(was_asleep=True)

    def connect(self):
        self.close()
        ensure_gui_environment()
        xdg = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        wdisp = os.environ.get("WAYLAND_DISPLAY")
        sock_path = os.path.join(xdg, wdisp) if wdisp else None
        if not sock_path or not os.path.exists(sock_path):
            sock_path = None
            try:
                for f in sorted(os.listdir(xdg)):
                    if f.startswith("wayland-") and not f.endswith(".lock"):
                        sock_path = os.path.join(xdg, f)
                        break
            except Exception:
                pass
        if not sock_path or not os.path.exists(sock_path):
            return False

        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2.0)
        try:
            s.connect(sock_path)
            self.sock = s
            self.buf = b""
            self.next_id = 4
            self._wl_outputs.clear()
            self._oid_to_name.clear()
            self._oid_to_width.clear()
            self._oid_to_did.clear()
            self._dpms_modes.clear()
            self.dpms_all_off = False
            self._send(1, 1, struct.pack("<I", 2))  # wl_display.get_registry(2)
            self._send(1, 0, struct.pack("<I", 3))  # wl_display.sync(3)

            globals_map = {}
            initial_outputs = []
            done = False
            while not done:
                chunk = s.recv(4096)
                if not chunk:
                    raise OSError("Wayland socket closed during handshake")
                self.buf += chunk
                while len(self.buf) >= 8:
                    obj_id, opcode, size = struct.unpack("<IHH", self.buf[:8])
                    if len(self.buf) < size:
                        break
                    payload = self.buf[8:size]
                    self.buf = self.buf[size:]
                    if obj_id == 2 and opcode == 0:
                        name, slen = struct.unpack("<II", payload[:8])
                        iface = payload[8:8 + slen - 1].decode("utf-8", "ignore")
                        ver_off = 8 + ((slen + 3) & ~3)
                        ver = struct.unpack("<I", payload[ver_off:ver_off + 4])[0]
                        if iface == "wl_output":
                            initial_outputs.append((name, ver))
                        else:
                            globals_map[iface] = (name, ver)
                    elif obj_id == 3 and opcode == 0:
                        done = True

            if "wl_seat" not in globals_map or "ext_idle_notifier_v1" not in globals_map:
                self.close()
                return False

            seat_name, seat_ver = globals_map["wl_seat"]
            idle_name, idle_ver = globals_map["ext_idle_notifier_v1"]
            self.seat_id = self._alloc_id()
            self.idle_mgr_id = self._alloc_id()
            self._send(2, 0, struct.pack("<I", seat_name) + self._wl_str("wl_seat") + struct.pack("<II", min(seat_ver, 5), self.seat_id))
            self._send(2, 0, struct.pack("<I", idle_name) + self._wl_str("ext_idle_notifier_v1") + struct.pack("<II", min(idle_ver, 1), self.idle_mgr_id))

            dpms_hooked = False
            if "org_kde_kwin_dpms_manager" in globals_map:
                dm_name, dm_ver = globals_map["org_kde_kwin_dpms_manager"]
                self.dpms_mgr_id = self._alloc_id()
                self._send(2, 0, struct.pack("<I", dm_name) + self._wl_str("org_kde_kwin_dpms_manager") + struct.pack("<II", min(dm_ver, 1), self.dpms_mgr_id))
                dpms_hooked = True

            for oname, over in initial_outputs:
                self._bind_wl_output(oname, over)

            s.setblocking(False)
            self.configure_timeouts(force=True)
            print(
                f"[DISPLAY/IDLE] Hooked Wayland ext_idle_notifier_v1 (dim={self.dim_sec}s, off={self.off_sec}s)"
                + (" + org_kde_kwin_dpms" if dpms_hooked else ""),
                flush=True,
            )
            return True
        except Exception as e:
            print(f"[DISPLAY/IDLE] Notice: Wayland idle hook unavailable: {e}", flush=True)
            self.close()
            return False

    def fileno(self):
        return self.sock.fileno() if self.sock else -1

    def close(self):
        self._cancel_reoff_timer()
        self._cancel_wake_verify_timer()
        self._set_external_drm_status_pin(False)
        if self.sock:
            try:
                self.sock.close()
            except Exception:
                pass
        self.sock = None
        self.seat_id = None
        self.idle_mgr_id = None
        self.dpms_mgr_id = None
        self.dim_notif_id = None
        self.off_notif_id = None
        self.is_dim_idle = False
        self.is_off_idle = False
        self.dpms_all_off = False
        self._wl_outputs.clear()
        self._oid_to_name.clear()
        self._oid_to_width.clear()
        self._oid_to_did.clear()
        self._dpms_modes.clear()
        self._reprobing_connectors.clear()

    def configure_timeouts(self, force=False):
        if not self.sock or not self.idle_mgr_id or not self.seat_id:
            return
        dim_s, off_s = read_powerdevil_display_timeouts()
        if not force and dim_s == self.dim_sec and off_s == self.off_sec:
            return
        self.dim_sec, self.off_sec = dim_s, off_s
        try:
            if not self.dpms_all_off:
                self._cancel_reoff_timer()
                self._cancel_wake_verify_timer()
                if self._pinned_connectors:
                    self._set_external_drm_status_pin(False)
                if self._dimmed_saved:
                    threading.Thread(target=self.restore_external_dim, daemon=True).start()

            if self.dim_notif_id:
                self._send(self.dim_notif_id, 0)  # ext_idle_notification_v1.destroy()
                self.dim_notif_id = None
            if self.off_notif_id:
                self._send(self.off_notif_id, 0)
                self.off_notif_id = None
            self.is_dim_idle = False
            self.is_off_idle = False

            if dim_s > 0:
                self.dim_notif_id = self._alloc_id()
                self._send(self.idle_mgr_id, 1, struct.pack("<III", self.dim_notif_id, dim_s * 1000, self.seat_id))
            if off_s > 0:
                self.off_notif_id = self._alloc_id()
                self._send(self.idle_mgr_id, 1, struct.pack("<III", self.off_notif_id, off_s * 1000, self.seat_id))
            if not force:
                print(f"[DISPLAY/IDLE] Reloaded powerdevilrc timeouts (dim={dim_s}s, off={off_s}s)", flush=True)
        except Exception as e:
            print(f"[DISPLAY/IDLE] Failed updating Wayland idle timers: {e}", flush=True)

    def _set_external_drm_status_pin(self, pin: bool):
        """
        Pins connected external DRM connectors to 'on' during DPMS Off (recording their
        pre-sleep width directly from wl_output v4 + sysfs fallback without spawning any subprocess),
        and releases them back to 'detect' immediately on DPMS On or daemon exit.
        Returns the list of connector names (e.g. ['DP-1']) affected.
        """
        affected = []
        if pin:
            with self._lock:
                already_pinned = set(self._pinned_connectors)
            if not already_pinned:
                wl_widths = {
                    self._oid_to_name[oid]: w
                    for oid, w in self._oid_to_width.items()
                    if oid in self._oid_to_name and not self._oid_to_name[oid].startswith("eDP") and w > 0
                }
                state = {}
                for p in sorted(glob.glob("/sys/class/drm/card*-*/status")):
                    if "-eDP-" in p:
                        continue
                    cname = os.path.basename(os.path.dirname(p)).split("-", 1)[-1]
                    sp, edid_len, _ = self._read_sysfs_connector_health(cname)
                    if sp:
                        # Record true wl_output active width (0 if unknown — never guessed from max_mode)
                        # and whether the connector actually exposed an EDID before sleep.
                        state[cname] = (wl_widths.get(cname, 0), edid_len >= 128)
                with self._lock:
                    self._pinned_state = state
            for p in sorted(glob.glob("/sys/class/drm/card*-*/status")):
                if "-eDP-" in p or p in already_pinned:
                    continue
                try:
                    if os.access(p, os.W_OK):
                        with open(p, "r") as f:
                            st = f.read().strip().lower()
                        if st == "connected":
                            with open(p, "w") as f:
                                f.write("on")
                            with self._lock:
                                self._pinned_connectors.add(p)
                            dev_name = os.path.basename(os.path.dirname(p))
                            affected.append(dev_name.split("-", 1)[-1])
                            print(f"[DISPLAY/IDLE] Pinned {dev_name} during DPMS sleep (anti-HPD-flap)", flush=True)
                except Exception:
                    pass
        else:
            with self._lock:
                released = list(self._pinned_connectors)
                self._pinned_connectors.clear()
            for p in released:
                try:
                    if os.access(p, os.W_OK):
                        with open(p, "w") as f:
                            f.write("detect")
                        dev_name = os.path.basename(os.path.dirname(p))
                        affected.append(dev_name.split("-", 1)[-1])
                        print(f"[DISPLAY/IDLE] Released {dev_name} to 'detect' on wake", flush=True)
                except Exception:
                    pass
        return affected

    def _apply_external_dim(self):
        if _is_powerdevil_inhibited():
            return
        if not check_external_displays_connected():
            return
        ext_displays = _get_external_screen_brightness_displays()
        if not ext_displays:
            return
        with self._lock:
            if self._dimmed_saved:
                return
            for obj_name, label, br, mx in ext_displays:
                target = max(int(mx * 0.15), int(br * 0.30))
                if br > target + int(mx * 0.05):
                    self._dimmed_saved[label] = br
                    _set_screen_brightness_silent(obj_name, target)
                    print(f"[DISPLAY/IDLE] Dimmed external {obj_name} ({label}): {br} ➔ {target}", flush=True)

    def restore_external_dim(self, target_dbus_name: str = ""):
        """
        Event-driven single-pass restore triggered either immediately on wake or the exact
        millisecond org.kde.ScreenBrightness.DisplayAdded fires after DDC/CI handshake finishes.
        Refuses to run while an EDID reprobe (off->detect) is in flight so it never wastes the
        saved brightness on a transient pre-reprobe handle.
        """
        if self.is_dim_idle or self.is_sleeping_or_idle or self.is_reprobing:
            return
        if not self._restore_lock.acquire(blocking=False):
            return
        try:
            with self._lock:
                if not self._dimmed_saved:
                    return
                saved = dict(self._dimmed_saved)

            ext_displays = _get_external_screen_brightness_displays()
            if not ext_displays:
                return
            restored_labels = []
            for label, orig_br in saved.items():
                match = next((d for d in ext_displays if d[1] == label), None)
                if match is None and target_dbus_name:
                    match = next((d for d in ext_displays if d[0] == target_dbus_name), None)
                if match is None and len(ext_displays) == 1 and len(saved) == 1:
                    match = ext_displays[0]
                if match is not None:
                    obj_name, _lbl, cur_br, _mx = match
                    if abs(cur_br - orig_br) <= 100:
                        restored_labels.append(label)
                    elif _set_screen_brightness_silent(obj_name, orig_br):
                        # Confirm both that DDC/CI converged AND that no reprobe replaced the handle
                        time.sleep(0.35)
                        if self.is_reprobing:
                            return
                        chk_list = _get_external_screen_brightness_displays()
                        chk = next((d for d in chk_list if d[0] == obj_name), None)
                        if chk is not None and abs(chk[2] - orig_br) <= 100:
                            print(f"[DISPLAY/IDLE] Restored external {obj_name} ({label}) brightness ➔ {orig_br}", flush=True)
                            restored_labels.append(label)

            with self._lock:
                for lbl in restored_labels:
                    self._dimmed_saved.pop(lbl, None)
        finally:
            self._restore_lock.release()

    def enforce_dpms_off_if_idle(self, reason="HPD_FLAP"):
        """Fallback DPMS Off re-assertion if connector pinning is unavailable (no sysfs write perm)."""
        if not self.is_sleeping_or_idle:
            return
        now = time.monotonic()
        if now - self._last_reoff_ts < 1.2:
            return
        self._last_reoff_ts = now

        def _do_reoff():
            if not self.is_sleeping_or_idle:
                return
            ensure_gui_environment()
            try:
                subprocess.run(["kscreen-doctor", "--dpms", "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2.0)
                print(f"[DISPLAY/IDLE] Re-asserted DPMS Off while still asleep ({reason})", flush=True)
            except Exception:
                pass

        self._cancel_reoff_timer()
        self._reoff_timer = threading.Timer(0.12, _do_reoff)
        self._reoff_timer.daemon = True
        self._reoff_timer.start()

    def process_events(self):
        """Reads and dispatches pending Wayland registry, wl_output, DPMS, and idle events."""
        if not self.sock:
            return False
        while True:
            try:
                chunk = self.sock.recv(4096)
                if not chunk:
                    return False
                self.buf += chunk
            except BlockingIOError:
                break
            except Exception:
                return False

        while len(self.buf) >= 8:
            obj_id, opcode, size = struct.unpack("<IHH", self.buf[:8])
            if len(self.buf) < size:
                break
            payload = self.buf[8:size]
            self.buf = self.buf[size:]

            if obj_id == 2:  # wl_registry hotplug
                if opcode == 0 and len(payload) >= 12:
                    name, slen = struct.unpack("<II", payload[:8])
                    iface = payload[8:8 + slen - 1].decode("utf-8", "ignore")
                    ver_off = 8 + ((slen + 3) & ~3)
                    if iface == "wl_output" and len(payload) >= ver_off + 4:
                        ver = struct.unpack("<I", payload[ver_off:ver_off + 4])[0]
                        self._bind_wl_output(name, ver)
                elif opcode == 1 and len(payload) >= 4:
                    name = struct.unpack("<I", payload[:4])[0]
                    self._unbind_wl_output(name)
            elif obj_id in self._oid_to_did or any(oid == obj_id for oid, _ in self._wl_outputs.values()):
                # wl_output v4 events: 1=mode(flags,w,h,refresh), 2=done, 4=name(str)
                if opcode == 1 and len(payload) >= 16:
                    flags, w, _h, _ref = struct.unpack("<Iiii", payload[:16])
                    if flags & 1:  # WL_OUTPUT_MODE_CURRENT
                        self._oid_to_width[obj_id] = w
                elif opcode == 4 and len(payload) >= 4:
                    slen = struct.unpack("<I", payload[:4])[0]
                    if 4 + slen <= len(payload):
                        cname = payload[4:4 + slen - 1].decode("utf-8", "ignore")
                        self._oid_to_name[obj_id] = cname
                elif opcode == 2:  # wl_output.done
                    self._check_vga_fallback_for_output(obj_id)
            elif obj_id in self._dpms_modes or any(did == obj_id for _, did in self._wl_outputs.values()):
                # org_kde_kwin_dpms events: 0=supported(u32), 1=mode(u32), 2=done()
                if opcode == 1 and len(payload) >= 4:
                    self._dpms_modes[obj_id] = struct.unpack("<I", payload[:4])[0]
                elif opcode == 2:
                    self._evaluate_dpms_state()
            elif obj_id == self.dim_notif_id:
                if opcode == 0:  # idled
                    self.is_dim_idle = True
                    threading.Thread(target=self._apply_external_dim, daemon=True).start()
                elif opcode == 1:  # resumed
                    self.is_dim_idle = False
                    if self._pinned_connectors:
                        # Handle wake where dim_notif resumed before off_notif/DPMS On
                        self.is_off_idle = False
                        self.dpms_all_off = False
                        self._on_wake(was_asleep=True)
                    elif not self.dpms_all_off and not self.is_reprobing:
                        threading.Thread(target=self.restore_external_dim, daemon=True).start()
            elif obj_id == self.off_notif_id:
                if opcode == 0:  # idled
                    self.is_off_idle = True
                    if not self.dpms_mgr_id:
                        self._set_external_drm_status_pin(True)
                elif opcode == 1:  # resumed
                    was_off = self.is_off_idle or self.dpms_all_off or bool(self._pinned_connectors)
                    self.is_off_idle = False
                    self.dpms_all_off = False
                    self._on_wake(was_asleep=was_off)
        return True


def setup_powerdevilrc_inotify():
    """Creates a non-blocking libc inotify fd watching ~/.config for powerdevilrc edits."""
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        in_fd = libc.inotify_init1(0o0004000 | 0o2000000)  # IN_NONBLOCK | IN_CLOEXEC
        if in_fd < 0:
            return None
        cfg_dir = os.path.expanduser("~/.config").encode("utf-8")
        # IN_CLOSE_WRITE (0x8) | IN_MOVED_TO (0x80) | IN_CREATE (0x100)
        wd = libc.inotify_add_watch(in_fd, cfg_dir, 0x00000008 | 0x00000080 | 0x00000100)
        if wd < 0:
            os.close(in_fd)
            return None
        return in_fd
    except Exception:
        return None


_idle_guard = WaylandIdleDpmsGuard()
_dbus_listener = SessionDBusListener()


def handle_drm_hotplug(force: bool = False):
    """
    Called when an external display disconnect is detected.
    Restarts plasma-powerdevil.service to rebind KDE Plasma 6's backlight controller back
    to the internal panel, strictly suppressed while asleep, locked, or undergoing an
    intentional EDID reprobe (deferred instead of dropped).
    """
    global _deferred_drm_recovery

    if not force and _idle_guard.is_reprobing:
        print("[DISPLAY] Deferring disconnect evaluation while EDID reprobe is in progress", flush=True)
        _deferred_drm_recovery = True
        return

    if not force and (_idle_guard.is_sleeping_or_idle or is_display_sleeping() or is_session_locked()):
        print("[DISPLAY] External display disconnect during DPMS sleep / user idle ➔ deferring PowerDevil restart until wake", flush=True)
        _deferred_drm_recovery = True
        if _idle_guard.is_sleeping_or_idle:
            _idle_guard.enforce_dpms_off_if_idle(reason="DISCONNECT_DURING_IDLE")
        return

    def _worker():
        time.sleep(1.5)
        if not force and (_idle_guard.is_sleeping_or_idle or _idle_guard.is_reprobing or check_external_displays_connected()):
            return
        ensure_gui_environment()

        try:
            res = subprocess.run(
                ["systemctl", "--user", "restart", "plasma-powerdevil.service"],
                capture_output=True,
                timeout=5,
            )
            if res.returncode == 0:
                print("[DISPLAY] External monitor unplugged: successfully restarted plasma-powerdevil to rebind backlight", flush=True)
            else:
                print(f"[DISPLAY] Notice: plasma-powerdevil restart returned code {res.returncode}", flush=True)
        except Exception as e:
            print(f"[DISPLAY] Failed to restart plasma-powerdevil: {e}", flush=True)

    t = threading.Thread(target=_worker, daemon=True)
    t.start()

def apply_rapl_mmio(profile_id=None, source="PROFILE"):
    """Synchronizes MMIO RAPL PL1/PL2 limits for the active profile and AC state."""
    res = sync_rapl_mmio(profile_id=profile_id)
    if res.get("changed"):
        pwr_state = "AC" if res.get("ac_online") else "Battery"
        print(
            f"[POWER/{source}] {res.get('profile')} ({pwr_state}) ➔ "
            f"MMIO RAPL PL1={res.get('pl1_w')}W, PL2={res.get('pl2_w')}W",
            flush=True,
        )
    elif res.get("reason") == "permission_denied":
        print(
            "[POWER] Notice: intel-rapl-mmio:0 power limit nodes are not writable "
            "(install tmpfiles.d/lenovo_rapl_mmio.conf).",
            flush=True,
        )


def get_copilot_config():
    """
    Reads copilot config dynamically from ~/.config/legion/config.jsonc (or config.json).
    Returns (config_dict, error_or_None).
    """
    cfg, err = load_config()
    if not cfg and not err:
        return {
            "tap": DEFAULT_COPILOT_CMD,
            "candidates": DEFAULT_CANDIDATES
        }, None
    tap_entry = cfg.get("copilot_tap") if "copilot_tap" in cfg else cfg.get("copilot_command", DEFAULT_COPILOT_CMD)
    candidates = cfg.get("copilot_candidates", DEFAULT_CANDIDATES)
    return {
        "tap": tap_entry,
        "candidates": candidates
    }, err

def run_executable(cmd_str, source_name="Copilot", env_extra=None):
    """Validates and launches an application outside the daemon's cgroup."""
    ensure_gui_environment()
    try:
        args = shlex.split(cmd_str)
    except ValueError as e:
        errmsg = f"Invalid command syntax: {cmd_str!r}\n{e}"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Config Error", errmsg)
        return False

    if not args:
        errmsg = f"Command is empty string\nEdit ~/.config/legion/config.jsonc"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Empty Command", errmsg)
        return False

    exe = shutil.which(args[0]) or (args[0] if os.path.isfile(args[0]) else None)
    if not exe:
        errmsg = f"App not found: {args[0]!r}\nEdit ~/.config/legion/config.jsonc"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — App Not Found", errmsg)
        return False

    try:
        # A direct child inherits this service's cgroup, inflating the daemon's
        # resource accounting and making systemctl restart kill the app. A user
        # scope gives each interactive launch an independent lifecycle instead.
        launcher = shutil.which("systemd-run")
        full_env = dict(os.environ)
        if env_extra:
            full_env.update(env_extra)

        if launcher:
            launcher_cmd = [launcher, "--user", "--scope", "--collect", "--quiet"]
            if env_extra:
                for k, v in env_extra.items():
                    launcher_cmd.append(f"--setenv={k}={v}")
            launcher_cmd.extend(["--", *args])
            proc = subprocess.Popen(
                launcher_cmd,
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=full_env
            )
        else:
            proc = subprocess.Popen(args, start_new_session=True, env=full_env)
        with _detached_lock:
            _detached_pids.add(proc.pid)
        print(f"[{source_name}] Executed successfully: {cmd_str}", flush=True)
        return proc.pid
    except Exception as e:
        errmsg = f"Launch failed: {e}\nCommand: {cmd_str}"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Launch Error", errmsg)
        return None

TERMINAL_COMM_NAMES = {
    "alacritty", "kitty", "foot", "ghostty", "konsole", "wezterm",
    "xterm", "gnome-terminal", "mate-terminal", "xfce4-terminal"
}
SESSION_STOP_NAMES = {
    "systemd", "init", "systemd-run", "plasma-workspace", "kwin_wayland",
    "antigravity-ide", "code", "vscodium", "cursor", "language_server", "node"
}

def get_related_pids(pids):
    """
    Finds all PIDs associated with the target processes in the process tree:
    - Ancestors (parents up to enclosing terminal emulator, stopping before system/session processes)
    - Descendants (children running under the process)
    """
    related = set(pids)
    for pid in pids:
        curr = pid
        for _ in range(4):
            try:
                with open(f"/proc/{curr}/stat", "r") as f:
                    stat_parts = f.read().split()
                    ppid = int(stat_parts[3])
                if ppid <= 1:
                    break
                with open(f"/proc/{ppid}/comm", "r") as f:
                    pcomm = f.read().strip().lower()
                if pcomm in SESSION_STOP_NAMES:
                    break
                related.add(ppid)
                if pcomm in TERMINAL_COMM_NAMES:
                    break
                curr = ppid
            except Exception:
                break
        try:
            with open(f"/proc/{pid}/task/{pid}/children", "r") as f:
                for cpid in f.read().split():
                    if cpid.isdigit():
                        related.add(int(cpid))
        except Exception:
            pass
    return list(related)

def find_process_pids(proc_name, match_type="auto", is_inner_payload=False):
    """
    Finds PIDs for a process name:
    1. Tries exact comm match (pgrep -x).
    2. If not found or if match_type == 'full', tries full cmdline match (pgrep -f),
       reliably handling interpreted scripts (Python, Bash, Node) while excluding
       the daemon itself, zombie processes, and wrapper terminal emulators.
    """
    if not proc_name:
        return []
    pattern = re.escape(proc_name)
    use_full = (match_type == "full") or (match_type != "exact" and (len(proc_name) > 15 or " " in proc_name))
    flag = "-f" if use_full else "-x"

    def _query(flg, pat):
        try:
            res = subprocess.run(["pgrep", flg, "--", pat], capture_output=True, text=True)
            if res.returncode == 0:
                return [int(p) for p in res.stdout.split() if p.isdigit()]
        except Exception:
            pass
        return []

    pids = _query(flag, pattern)
    if not pids and flag == "-x" and match_type != "exact":
        pids = _query("-f", pattern)

    valid_pids = []
    my_pid = os.getpid()
    for pid in pids:
        if pid == my_pid:
            continue
        try:
            with open(f"/proc/{pid}/comm", "r") as f:
                comm = f.read().strip().lower()
            if is_inner_payload and comm in TERMINAL_COMM_NAMES:
                # Do not match the terminal emulator wrapper itself when querying for an inner payload
                continue
            with open(f"/proc/{pid}/stat", "r") as f:
                stat_str = f.read()
            rparen = stat_str.rfind(")")
            if rparen != -1 and len(stat_str) > rparen + 2:
                state = stat_str[rparen + 2]
                if state == "Z":
                    continue
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmdline = f.read().replace(b"\x00", b" ").decode("utf-8", "ignore")
            if "legion-profile-osd" in cmdline:
                continue
            valid_pids.append(pid)
        except Exception:
            continue
    return valid_pids

def manage_kwin_window(pids, on_active="close"):
    """
    Interacts with KWin Wayland via DBus Scripting:
    - If currently focused window belongs to target process tree, toggles it off
      (closes or minimizes according to on_active).
    - If target window is in background or minimized, brings it to front and focuses it.
    Returns True if a matching window was found and managed, False otherwise.
    """
    qdbus_bin = shutil.which("qdbus6") or shutil.which("qdbus")
    if not qdbus_bin:
        return False

    related_pids = get_related_pids(pids)
    if not related_pids:
        return False

    script_name = f"legion_win_{int(time.time() * 1000)}"
    action_str = on_active.lower() if on_active else "close"

    kwin_script = f"""
    (function() {{
        var targetPids = {related_pids};
        var activeWin = workspace.activeWindow;

        // 1. If currently focused window belongs to target, handle dismiss/toggle-off
        if (activeWin && targetPids.indexOf(activeWin.pid) !== -1) {{
            var act = "{action_str}";
            if (act === "minimize") {{
                activeWin.minimized = true;
            }} else if (act === "none" || act === "keep") {{
                // keep active (no-op)
            }} else {{
                activeWin.closeWindow();
            }}
            return;
        }}

        // 2. Not active -> find topmost window in stacking order to raise and focus
        var matched = null;
        var list = workspace.stackingOrder || (workspace.windowList ? workspace.windowList() : []);
        for (var i = list.length - 1; i >= 0; i--) {{
            var w = list[i];
            if (w.normalWindow && targetPids.indexOf(w.pid) !== -1) {{
                matched = w;
                break;
            }}
        }}
        if (!matched && workspace.windowList) {{
            var wins = workspace.windowList();
            for (var j = 0; j < wins.length; j++) {{
                var win = wins[j];
                if (win.normalWindow && targetPids.indexOf(win.pid) !== -1) {{
                    matched = win;
                    break;
                }}
            }}
        }}

        if (matched) {{
            if (matched.minimized) {{
                matched.minimized = false;
            }}
            workspace.activeWindow = matched;
            if (workspace.raiseWindow) {{
                workspace.raiseWindow(matched);
            }}
        }}
    }})();
    """

    tmp_file = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(kwin_script)
            tmp_file = f.name

        load_res = subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "loadScript", tmp_file, script_name],
            capture_output=True,
            text=True,
            timeout=2
        )
        if load_res.returncode != 0:
            return False

        script_id = load_res.stdout.strip()
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", f"/Scripting/Script{script_id}", "run"],
            capture_output=True,
            timeout=2
        )
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "unloadScript", script_name],
            capture_output=True,
            timeout=2
        )
        return True
    except Exception as e:
        print(f"[KWIN] Window toggle error: {e}", flush=True)
        return False
    finally:
        if tmp_file and os.path.exists(tmp_file):
            try:
                os.unlink(tmp_file)
            except Exception:
                pass

_last_terminal_spawn = 0.0
_pending_spawn_pid = None
_last_toggle_launch = {}

def get_valid_shells():
    """Reads valid login shells from /etc/shells."""
    try:
        with open("/etc/shells", "r") as f:
            return {os.path.basename(line.strip()) for line in f if line.strip() and not line.strip().startswith("#")}
    except Exception:
        return {"bash", "zsh", "fish", "sh", "dash"}


def is_interactive_shell(sh_args):
    """
    Checks if a shell's arguments match an allowlist of interactive invocation patterns.
    Fails-safe to False (non-interactive) for any script (-c, file path, unknown options).
    """
    if not sh_args:
        return False
    args = sh_args[1:]
    COMMON_SAFE_FLAGS = {"-l", "--login", "-i", "--norc", "--noprofile", "--no-rc", "-s"}
    i = 0
    n = len(args)
    while i < n:
        arg = args[i]
        # Special handling for bash/zsh --rcfile / --init-file <path>
        if arg in ("--rcfile", "--init-file") and i + 1 < n:
            i += 2
            continue
        # Check against common safe interactive flags
        if arg in COMMON_SAFE_FLAGS:
            i += 1
            continue
        # Combined short flags like -il, -li (must only consist of 'i' and 'l')
        if arg.startswith("-") and not arg.startswith("--"):
            flag_chars = set(arg[1:])
            if flag_chars.issubset({"i", "l"}):
                i += 1
                continue
        # Any other flag or argument (like -c, script.sh, etc.) is considered non-interactive
        return False
    return True

def check_pending_spawn(now):
    """
    Checks whether a pending terminal spawn is still active.
    Returns True if spawn is still in progress (should debounce/block duplicate spawn).
    Returns False if spawn has completed (shell transitioned to interactive, died, or timed out).
    """
    global _pending_spawn_pid, _last_terminal_spawn
    if _pending_spawn_pid is None:
        return False

    # 1. Timeout protection: max 3.5s
    if now - _last_terminal_spawn >= 3.5:
        _pending_spawn_pid = None
        return False

    # 2. Check if terminal process is still alive
    try:
        os.kill(_pending_spawn_pid, 0)
    except OSError:
        _pending_spawn_pid = None
        return False

    # 3. Check if any child shell of the pending terminal has transitioned to interactive
    for tc in glob.glob(f"/proc/{_pending_spawn_pid}/task/*/children"):
        try:
            with open(tc) as f:
                children = [int(c) for c in f.read().split() if c.isdigit()]
            for cpid in children:
                with open(f"/proc/{cpid}/cmdline", "rb") as cf:
                    raw = cf.read().split(b"\x00")
                sh_args = [a.decode("utf-8", errors="ignore") for a in raw if a]
                if is_interactive_shell(sh_args):
                    _pending_spawn_pid = None
                    return False
        except Exception:
            pass

    return True

def get_idle_terminals(proc_name="alacritty"):
    """
    Finds running terminal instances whose direct child is a valid login shell
    from /etc/shells and currently truly idle at prompt:
    1. Child is in /etc/shells (excludes nvtop, btop, etc.).
    2. Child is not in zombie state.
    3. tpgid == child_pid (controlling terminal foreground is the shell itself).
    4. Shell wchan is not waiting on a child process (do_wait, wait4, waitid, sigsuspend).
    5. Shell has NO living child processes running in foreground or sharing shell pgrp.
    6. Child argv matches interactive allowlist (excludes -c, scripts, etc.).
    Returns list of dicts: [{"term_pid": pid, "shell_pid": cpid}, ...]
    """
    idle_entries = []
    try:
        out = subprocess.check_output(["pgrep", "-x", proc_name], text=True)
        pids = [int(p) for p in out.split() if p.isdigit()]
    except subprocess.CalledProcessError:
        return []

    valid_shells = get_valid_shells()

    for pid in pids:
        try:
            # 1. Filter out zombie processes
            with open(f"/proc/{pid}/stat", "r") as f:
                raw_stat = f.read()
            after_comm = raw_stat[raw_stat.rfind(")") + 2:].split()
            if after_comm[0] == "Z":
                continue

            # 2. Find direct children of the terminal process
            children = []
            for task_child in glob.glob(f"/proc/{pid}/task/*/children"):
                try:
                    with open(task_child, "r") as f:
                        children.extend([int(c) for c in f.read().split() if c.isdigit()])
                except Exception:
                    pass
            children = list(set(children))
            if not children:
                continue

            # 3. Inspect children: must be a valid shell from /etc/shells AND truly idle at prompt
            for cpid in children:
                try:
                    with open(f"/proc/{cpid}/comm", "r") as f:
                        comm = f.read().strip()
                    if comm not in valid_shells:
                        continue

                    with open(f"/proc/{cpid}/stat", "r") as f:
                        sh_stat = f.read()
                    sh_after = sh_stat[sh_stat.rfind(")") + 2:].split()
                    if sh_after[0] == "Z":
                        continue

                    tpgid = int(sh_after[5])
                    if tpgid != cpid:
                        continue  # Terminal pty foreground owned by child process -> BUSY

                    # 4. Check kernel wait-channel: if waiting on children/signals, shell is NOT at prompt
                    try:
                        with open(f"/proc/{cpid}/wchan", "r") as wf:
                            wchan = wf.read().strip()
                        if any(w in wchan for w in ("do_wait", "wait4", "waitid", "sigsuspend")):
                            continue  # Blocked waiting on child process -> BUSY
                    except Exception:
                        pass

                    # 5. Check if shell has any living children in foreground or shell pgrp
                    has_running_child = False
                    for tc in glob.glob(f"/proc/{cpid}/task/*/children"):
                        try:
                            with open(tc, "r") as cf:
                                sh_kids = [int(x) for x in cf.read().split() if x.isdigit()]
                            for k in sh_kids:
                                try:
                                    with open(f"/proc/{k}/stat", "r") as kf:
                                        kst = kf.read()
                                    kafter = kst[kst.rfind(")") + 2:].split()
                                    if kafter[0] != "Z":  # Living, non-zombie child
                                        kpgrp = int(kafter[2])
                                        ktpgid = int(kafter[5])
                                        if ktpgid == tpgid or kpgrp == tpgid or kpgrp == cpid:
                                            has_running_child = True
                                            break
                                except Exception:
                                    pass
                            if has_running_child:
                                break
                        except Exception:
                            pass

                    if has_running_child:
                        continue  # Shell is actively holding a command -> BUSY

                    # 6. Filter out non-interactive shells via allowlist
                    with open(f"/proc/{cpid}/cmdline", "rb") as f:
                        raw = f.read().split(b"\x00")
                    sh_args = [a.decode("utf-8", errors="ignore") for a in raw if a]
                    if not is_interactive_shell(sh_args):
                        continue

                    idle_entries.append({"term_pid": pid, "shell_pid": cpid})
                    break
                except Exception:
                    continue
        except Exception:
            continue

    return idle_entries

def focus_kwin_idle_terminal(idle_pids):
    """
    Focuses the most recently used idle terminal window in KWin 6 stacking order.
    If an idle terminal is already active in the foreground, keeps focus (Option A).
    """
    qdbus_bin = shutil.which("qdbus6") or shutil.which("qdbus")
    if not qdbus_bin:
        return False

    script_name = f"legion_idle_focus_{int(time.time() * 1000)}"
    kwin_script = f"""
    (function() {{
        var targetPids = {idle_pids};
        var activeWin = workspace.activeWindow;
        if (activeWin && targetPids.indexOf(activeWin.pid) !== -1) {{
            // Option A: already focused on an idle terminal -> keep focus
            return;
        }}
        for (var i = workspace.stackingOrder.length - 1; i >= 0; i--) {{
            var w = workspace.stackingOrder[i];
            if (w.normalWindow && targetPids.indexOf(w.pid) !== -1) {{
                if (w.minimized) w.minimized = false;
                workspace.activeWindow = w;
                if (workspace.raiseWindow) workspace.raiseWindow(w);
                break;
            }}
        }}
    }})();
    """
    tmp_file = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(kwin_script)
            tmp_file = f.name

        load_res = subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "loadScript", tmp_file, script_name],
            capture_output=True,
            text=True,
            timeout=2
        )
        if load_res.returncode != 0:
            return False

        script_id = load_res.stdout.strip()
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", f"/Scripting/Script{script_id}", "run"],
            capture_output=True,
            timeout=2
        )
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "unloadScript", script_name],
            capture_output=True,
            timeout=2
        )
        return True
    except Exception as e:
        print(f"[KWIN] Focus idle terminal error: {e}", flush=True)
        return False
    finally:
        if tmp_file and os.path.exists(tmp_file):
            try:
                os.unlink(tmp_file)
            except Exception:
                pass

def dispatch_hotkey(hotkey_label, cfg_entry, default_entry):
    """
    Executes a configurable hotkey action based on ~/.config/legion/config.jsonc (or config.json).
    Supports two clean modes:
      1. 'exec' / 'cycle' : Directly runs the command (e.g. lcolor cycle, lhz toggle, spectacle).
      2. 'toggle'         : Smart process & window toggle.
                            - If not running -> launches 'exec'.
                            - If running but obscured -> brings window to front & focuses.
                            - If running and already active -> handles via 'on_active' ('close'/'minimize'/'none').
    cfg_entry can be:
      - A dict: {"action": "toggle", "exec": "...", "process": "...", "on_active": "close"|"minimize"|"none", "match": "full"|"exact"}
      - A string: "lcolor cycle" or "alacritty -e nvtop"
      - None: falls back to default_entry
    """
    reap_zombies()
    ensure_gui_environment()
    entry = cfg_entry if cfg_entry is not None else default_entry

    if isinstance(entry, dict):
        action = entry.get("action", "").strip().lower()
        cmd = entry.get("exec", "").strip()
        proc_name = entry.get("process", "").strip() or None
        match_type = entry.get("match", "auto").strip().lower()
    elif isinstance(entry, str):
        cmd = entry.strip()
        action = ""
        proc_name = None
        match_type = "auto"
    else:
        return

    KNOWN_TERMINALS = ("alacritty", "kitty", "foot", "ghostty", "konsole", "wezterm", "xterm")
    args = shlex.split(cmd) if cmd else []
    cmd_base = os.path.basename(args[0]).lower() if args else ""
    has_inner_cmd = len(args) >= 3 and args[1] in ("-e", "-x", "--command")

    if not action:
        if cmd_base in KNOWN_TERMINALS and not has_inner_cmd:
            action = "smart_terminal"
        elif has_inner_cmd:
            action = "toggle"
        else:
            action = "exec"

    if not cmd or cmd.lower() in ("disabled", "none", "off", "false"):
        return

    if cmd.startswith("lcolor") and os.path.isfile(LCOLOR_BIN):
        cmd = cmd.replace("lcolor", LCOLOR_BIN, 1)
    elif cmd.startswith("lhz") and os.path.isfile(LHZ_BIN):
        cmd = cmd.replace("lhz", LHZ_BIN, 1)

    if action in ("smart_terminal", "smart_spawn"):
        global _last_terminal_spawn, _pending_spawn_pid
        now = time.monotonic()

        # 1. Debounce protection (< 1.2s between rapid presses)
        if now - _last_terminal_spawn < 1.2:
            print(f"[{hotkey_label}] Terminal spawn debounce (< 1.2s), ignoring duplicate press.", flush=True)
            return

        # 2. Check if a previously spawned terminal is still in its startup phase
        if check_pending_spawn(now):
            print(f"[{hotkey_label}] Terminal spawn still in progress (PID {_pending_spawn_pid}), ignoring duplicate press.", flush=True)
            return

        target_proc = proc_name or (cmd_base if cmd_base in KNOWN_TERMINALS else "alacritty")
        idle_entries = get_idle_terminals(target_proc)
        if idle_entries:
            _pending_spawn_pid = None
            idle_term_pids = [e["term_pid"] for e in idle_entries]
            print(f"[{hotkey_label}] Found idle terminal(s) {idle_term_pids} ({target_proc}) ➔ Focusing in KWin", flush=True)
            focus_kwin_idle_terminal(idle_term_pids)
        else:
            print(f"[{hotkey_label}] No idle terminal found (all busy or none open) ➔ Spawning {target_proc}", flush=True)
            _last_terminal_spawn = now
            spawn_pid = run_executable(cmd, source_name=hotkey_label)
            _pending_spawn_pid = spawn_pid
        return

    if action == "toggle":
        inner_target = None
        args = shlex.split(cmd) if cmd else []
        if len(args) >= 3 and args[1] in ("-e", "-x", "--command"):
            target = args[2]
            if target in ("bash", "sh", "zsh") and len(args) >= 5 and args[3] in ("-c", "-lc"):
                try:
                    sub_args = shlex.split(args[4])
                    if sub_args:
                        target = sub_args[0]
                except Exception:
                    pass
            inner_target = os.path.basename(target)

        # Determine process name to track (prioritize explicit process, inner wrapper command, or firefoxpwa site ID)
        target_proc = proc_name or inner_target
        if not target_proc:
            if len(args) >= 4 and args[0] == "firefoxpwa" and args[1] == "site" and args[2] == "launch":
                target_proc = args[3]
            elif args:
                target_proc = os.path.basename(args[0])

        pids = find_process_pids(target_proc, match_type=match_type, is_inner_payload=bool(inner_target))
        if not pids and proc_name and proc_name != target_proc:
            pids = find_process_pids(proc_name, match_type=match_type, is_inner_payload=bool(inner_target))

        if pids:
            on_active = "close"
            if isinstance(entry, dict):
                on_active = entry.get("on_active", "close").strip().lower()

            managed = manage_kwin_window(pids, on_active=on_active)
            if managed:
                print(f"[{hotkey_label}] Managed window for {target_proc!r} (PIDs: {pids}, on_active: {on_active})", flush=True)
            else:
                flag = "-f" if (match_type == "full" or len(target_proc) > 15 or " " in target_proc) else "-x"
                subprocess.run(["pkill", flag, "--", re.escape(target_proc)], check=False)
                print(f"[{hotkey_label}] Toggled OFF: killed {target_proc!r} (mode: {flag})", flush=True)
        else:
            global _last_toggle_launch
            now = time.monotonic()
            last_t = _last_toggle_launch.get(cmd, 0.0)
            if now - last_t < 1.5:
                print(f"[{hotkey_label}] Launch in progress (< 1.5s), ignoring duplicate press for {target_proc!r}.", flush=True)
                return
            _last_toggle_launch[cmd] = now
            run_executable(cmd, hotkey_label)
    else:
        run_executable(cmd, hotkey_label)

# Guard: prevent multiple picker windows stacking if user holds repeatedly
_menu_open = threading.Event()
_menu_proc = None                    # live Popen handle for the current picker
_menu_proc_lock = threading.Lock()   # protects _menu_proc and _abort_requested
_abort_requested = False             # dismiss was requested before proc was spawned

LEGION_THEME = os.path.expanduser("~/.config/rofi/legion-launcher.rasi")

def _run_picker_proc(cmd, stdin_data=None):
    """Launch a picker subprocess, store its handle, block until done.
    Returns (stdout, returncode). Deadlock-free and handles external termination.

    Fix 1 — deadlock: stderr=DEVNULL prevents the 64 KB OS pipe buffer from
    filling up and blocking the child while Python is stuck on stdout.read().
    communicate() reads stdout/stderr concurrently via internal threads and
    calls wait() — safe even if proc.terminate() is called from another thread.

    Fix 2 — race condition: if a dismiss was requested before we reached Popen
    (i.e. during JSON/config loading), _abort_requested is True and we
    terminate the process immediately after registering it under the lock.
    """
    global _menu_proc, _abort_requested
    ensure_gui_environment()

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if stdin_data is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,  # avoid 64 KB pipe-buffer deadlock
            text=True,
        )
    except Exception as e:
        print(f"[PICKER] Failed to spawn {cmd[0]}: {e}", flush=True)
        return "", -1

    with _menu_proc_lock:
        _menu_proc = proc
        if _abort_requested:
            proc.terminate()
            _abort_requested = False

    try:
        # communicate() handles stdin write + stdout read + wait atomically;
        # returns even if proc was terminated externally mid-flight.
        stdout, _ = proc.communicate(input=stdin_data)
        return stdout, proc.returncode
    except Exception:
        return "", -1
    finally:
        with _menu_proc_lock:
            _menu_proc = None

def _show_rofi(names, lookup):
    """Run rofi -dmenu. Uses Legion theme if present; otherwise rofi's own defaults."""
    rofi_cmd = [
        shutil.which("rofi"), "-dmenu",
        "-i",                   # case-insensitive filter
        "-p", "✦ Quick Launch",
        "-no-custom",           # reject free-text not in list
        "-hover-select",
        "-me-select-entry", "",
        "-me-accept-entry", "MousePrimary",
    ]
    # Only inject our theme if it exists — never silently override a user's own theme
    if os.path.isfile(LEGION_THEME):
        rofi_cmd += ["-theme", LEGION_THEME]

    stdout, returncode = _run_picker_proc(rofi_cmd, stdin_data="\n".join(names))
    selected = stdout.strip()
    if returncode == 0 and selected and selected in lookup:
        run_executable(lookup[selected], f"Candidate [{selected}]")

def _show_kdialog(names, lookup):
    """Fallback menu using kdialog when rofi is not installed."""
    cmd = [shutil.which("kdialog") or "kdialog",
           "--title", "✦ Quick Launch",
           "--menu", "Select Application:"]
    for i, name in enumerate(names, 1):
        cmd += [str(i), name]
    stdout, returncode = _run_picker_proc(cmd)
    tag = stdout.strip()
    index_lookup = {str(i): name for i, name in enumerate(names, 1)}
    if returncode == 0 and tag and tag in index_lookup:
        name = index_lookup[tag]
        if name in lookup:
            run_executable(lookup[name], f"Candidate [{name}]")

def dismiss_copilot_menu():
    """
    Dismisses the open candidate picker menu if running.
    Works even during the brief window before the subprocess is spawned.
    """
    global _abort_requested
    if not _menu_open.is_set():
        return False
    with _menu_proc_lock:
        proc = _menu_proc
        if proc and proc.poll() is None:
            # Proc is live — kill it directly
            proc.terminate()
            print("[COPILOT MENU] Dismissed by Copilot press", flush=True)
        else:
            # Proc not yet spawned (still in config-read window) — mark abort
            _abort_requested = True
            print("[COPILOT MENU] Abort queued (proc not yet live)", flush=True)
    return True

def launch_copilot_menu():
    """
    Spawns picker menu in a background thread.
    - Uses rofi if available (with Legion theme if present, else rofi defaults)
    - Falls back to kdialog if rofi is not installed
    - Subsequent Copilot press (tap or hold) while menu is open → dismisses the picker.
    """
    if _menu_open.is_set():
        dismiss_copilot_menu()
        return

    def _menu_worker():
        _menu_open.set()
        try:
            cfg, err = get_copilot_config()
            if err:
                send_error_osd("Copilot Menu — Config Warning", err)

            candidates = cfg.get("candidates", DEFAULT_CANDIDATES)
            lookup = {}   # name → exec_str (preserve insertion order for kdialog)
            names = []
            for item in candidates:
                name = item.get("name", "Application")
                lookup[name] = item.get("exec", "")
                names.append(name)

            try:
                if shutil.which("rofi"):
                    _show_rofi(names, lookup)
                elif shutil.which("kdialog"):
                    _show_kdialog(names, lookup)
                else:
                    print("[COPILOT MENU] Neither rofi nor kdialog found — install one.", flush=True)
                    send_error_osd("Copilot Menu — No Picker Found",
                                   "Install rofi or kdialog to use the candidate menu.")
            except Exception as e:
                print(f"[COPILOT MENU] Error: {e}", flush=True)
        finally:
            _menu_open.clear()

    threading.Thread(target=_menu_worker, daemon=True).start()

def send_profile_osd(state):
    ensure_gui_environment()
    info = PROFILES.get(state, {
        "title": f"Profile: {state}",
        "msg": "ACPI platform_profile changed",
        "icon_file": "custom.svg",
        "fallback": "preferences-system-power-management"
    })
    
    icon_path = os.path.join(ICON_DIR, info["icon_file"])
    icon = icon_path if os.path.isfile(icon_path) else info["fallback"]

    cmd = [
        "notify-send",
        "-a", "Legion Profile",
        "-i", icon,
        "-h", "string:x-canonical-private-synchronous:legion-profile-osd",
        "-t", "1800",
        info["title"],
        info["msg"]
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

def find_keyboard_fd():
    """Find and open the ITE keyboard event node."""
    if os.path.exists(KBD_SYMLINK):
        target = os.path.realpath(KBD_SYMLINK)
        try:
            fd = os.open(target, os.O_RDONLY | os.O_NONBLOCK)
            return fd, target
        except Exception:
            pass
    for p in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(256)
            fcntl.ioctl(fd, 0x82004506, buf)
            name = buf.split(b"\x00")[0].decode("utf-8", "ignore")
            if "ITE" in name and "Keyboard" in name:
                return fd, p
            os.close(fd)
        except Exception:
            pass
    return None, None

def trigger_copilot_tap(source="COPILOT"):
    """Dispatches Copilot short-tap action or dismisses an open candidate picker menu."""
    if _menu_open.is_set():
        dismiss_copilot_menu()
        return
    print(f"[{source}] Short tap triggered ➔ Dispatching Default Action", flush=True)
    cfg, err = get_copilot_config()
    if err:
        send_error_osd("Copilot Key — Config Warning", err)
    dispatch_hotkey("Copilot Tap", cfg.get("tap"), DEFAULT_COPILOT_CMD)


EVIOCGKEY_96 = 0x80604518
MODIFIER_KEYCODES = {29, 42, 54, 56, 97, 100, 125, 126}  # Ctrl, Shift, Alt, Meta (L/R)
_copilot_auto_lock = threading.Lock()
_last_auto_trigger_ts = 0.0


def _detect_pressed_keyboard_keys():
    """
    Scans readable /dev/input/event* nodes via EVIOCGKEY ioctl (96-byte key bitmap).
    Returns a list of (fd, path, non_modifier_keys, all_keys) for devices with active keys.
    Caller owns the returned file descriptors and must close them.
    """
    active = []
    for p in sorted(glob.glob("/dev/input/event*")):
        fd = None
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(96)
            fcntl.ioctl(fd, EVIOCGKEY_96, buf)
            pressed = [i for i in range(96 * 8) if buf[i // 8] & (1 << (i % 8))]
            if pressed:
                non_mod = [k for k in pressed if k not in MODIFIER_KEYCODES]
                active.append((fd, p, non_mod, pressed))
                fd = None
        except Exception:
            pass
        finally:
            if fd is not None:
                try:
                    os.close(fd)
                except Exception:
                    pass
    return active


def trigger_copilot_auto(source="IPC/COPILOT"):
    """
    Emulates full physical Copilot key behavior (Short Tap < 0.28s vs Long Hold >= 0.28s)
    for external keyboard shortcuts (e.g. Meta+M -> `lcopilot`).
    - If Quick Launch menu is already open: immediately dismisses it.
    - Queries EVIOCGKEY on readable keyboard nodes at t=0 when the shortcut fires:
      blocks inside kernel wait queue via select.poll() for up to 280ms waiting for EV_KEY release.
      * Released before 280ms -> Short Tap (Smart Terminal).
      * Still held at 280ms -> Long Hold (Quick Launch Menu).
    - Fallback when no key is physically held (e.g. CLI or synthetic trigger):
      single invocation triggers Tap; double invocation within 320ms triggers Menu.
    """
    global _last_auto_trigger_ts
    if _menu_open.is_set():
        dismiss_copilot_menu()
        return

    now = time.monotonic()
    active_devs = _detect_pressed_keyboard_keys()

    # Prefer devices that currently have a non-modifier trigger key held (e.g. KEY_M = 50)
    target_fd = None
    target_keys = set()
    for fd, _path, non_mod, all_keys in active_devs:
        if target_fd is None and non_mod:
            target_fd = fd
            target_keys = set(non_mod)
        elif target_fd is None and all_keys:
            target_fd = fd
            target_keys = set(all_keys)
        else:
            try:
                os.close(fd)
            except Exception:
                pass

    if target_fd is None:
        # KDE kglobalaccel invokes the command after key release (<200ms tap).
        # Single tap triggers Tap immediately; double-press within 380ms triggers Menu.
        if now - _last_auto_trigger_ts <= 0.38:
            _last_auto_trigger_ts = 0.0
            print(f"[{source}] Double-press / repeat detected ➔ Opening Candidates Menu", flush=True)
            launch_copilot_menu()
        else:
            _last_auto_trigger_ts = now
            trigger_copilot_tap(source)
        return

    if not _copilot_auto_lock.acquire(blocking=False):
        try:
            os.close(target_fd)
        except Exception:
            pass
        return

    def _hold_waiter(fd, watch_keys):
        try:
            p = select.poll()
            p.register(fd, select.POLLIN | select.POLLERR | select.POLLHUP)
            deadline = time.monotonic() + 0.28
            released = False

            while not released:
                rem_ms = int((deadline - time.monotonic()) * 1000)
                if rem_ms <= 0:
                    break
                evts = p.poll(rem_ms)
                if not evts:
                    break
                while True:
                    try:
                        data = os.read(fd, 24)
                        if len(data) < 24:
                            break
                        _sec, _usec, etype, code, value = struct.unpack("qqHHI", data)
                        if etype == 1 and code in watch_keys and value == 0:
                            released = True
                            break
                    except BlockingIOError:
                        break
                    except Exception:
                        released = True
                        break

            # Verify via EVIOCGKEY bitmap whether any watched key is still physically depressed
            if not released:
                try:
                    buf = bytearray(96)
                    fcntl.ioctl(fd, EVIOCGKEY_96, buf)
                    still_down = any(buf[k // 8] & (1 << (k % 8)) for k in watch_keys)
                    if not still_down:
                        released = True
                except Exception:
                    pass

            if released:
                trigger_copilot_tap(source)
            else:
                print(f"[{source}] Long hold (>=280ms) detected ➔ Opening Candidates Menu", flush=True)
                launch_copilot_menu()
        finally:
            try:
                os.close(fd)
            except Exception:
                pass
            _copilot_auto_lock.release()

    threading.Thread(target=_hold_waiter, args=(target_fd, target_keys), daemon=True).start()



def trigger_fn_n(source="Fn+N"):
    """Dispatches configurable Fn+N smart toggle / launcher action."""
    cfg, _ = load_config()
    cfg_n = cfg.get("fn_n") if "fn_n" in cfg else cfg.get("fn_n_command")
    default_n = {"action": "toggle", "exec": "alacritty -e nvtop", "process": "nvtop"}
    dispatch_hotkey(source, cfg_n, default_n)


def main():
    ensure_gui_environment()
    poller = select.poll()

    # 1. Register ACPI platform_profile for Fn+Q & lmode
    profile_file = None
    last_profile_state = ""
    if os.path.exists(NODE):
        try:
            profile_file = open(NODE, "r")
            last_profile_state = profile_file.read().strip()
            poller.register(profile_file, select.POLLPRI | select.POLLERR)
            apply_rapl_mmio(last_profile_state, source="INIT")
        except Exception:
            pass

    # 2. Register Ideapad extra buttons node for Fn+R & Fn+L
    hotkey_fd = None
    if os.path.exists(HOTKEY_NODE):
        try:
            hotkey_fd = os.open(HOTKEY_NODE, os.O_RDONLY | os.O_NONBLOCK)
            poller.register(hotkey_fd, select.POLLIN | select.POLLERR)
        except Exception:
            pass

    # 3. Register ITE Keyboard node for Copilot Key
    kbd_fd, kbd_path = find_keyboard_fd()
    if kbd_fd:
        poller.register(kbd_fd, select.POLLIN | select.POLLERR)
        print(f"[INIT] Successfully hooked keyboard on {kbd_path}", flush=True)
    else:
        print("[INIT] Notice: ITE Keyboard node not accessible without read permissions.", flush=True)

    # 4. Register DRM Uevent Netlink socket for display hotplug/unplug auto-recovery
    nl_sock = None
    last_external_connected = check_external_displays_connected()
    try:
        nl_sock = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, 15)  # 15 = NETLINK_KOBJECT_UEVENT
        nl_sock.bind((0, 1))  # Multicast group 1 (kernel uevents)
        nl_sock.setblocking(False)
        poller.register(nl_sock.fileno(), select.POLLIN | select.POLLERR)
        print(f"[INIT] Successfully hooked kernel DRM hotplug uevents (external display: {last_external_connected})", flush=True)
    except Exception as e:
        print(f"[INIT] Notice: Could not bind DRM netlink socket: {e}", flush=True)

    # 5. Register local UNIX datagram IPC socket for zero-overhead CLI/external-keyboard triggers
    ipc_sock = None
    try:
        os.makedirs(os.path.dirname(IPC_SOCKET_PATH), exist_ok=True)
        if os.path.exists(IPC_SOCKET_PATH):
            os.unlink(IPC_SOCKET_PATH)
        ipc_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        ipc_sock.bind(IPC_SOCKET_PATH)
        os.chmod(IPC_SOCKET_PATH, 0o600)
        ipc_sock.setblocking(False)
        poller.register(ipc_sock.fileno(), select.POLLIN | select.POLLERR)
        print(f"[INIT] IPC socket listening at {IPC_SOCKET_PATH}", flush=True)
    except Exception as e:
        print(f"[INIT] Notice: Could not bind IPC socket: {e}", flush=True)

    # 6. Register Wayland (ext_idle_notifier_v1 + org_kde_kwin_dpms + wl_output),
    # Session DBus signal listener (DisplayAdded, profileChanged, configurationReloaded),
    # and ~/.config/powerdevilrc inotify watch — all inside one zero-polling select.poll() loop.
    wl_fd = -1
    if _idle_guard.connect():
        wl_fd = _idle_guard.fileno()
        poller.register(wl_fd, select.POLLIN | select.POLLERR | select.POLLHUP)

    dbus_fd = -1
    if _dbus_listener.connect():
        dbus_fd = _dbus_listener.fileno()
        poller.register(dbus_fd, select.POLLIN | select.POLLERR | select.POLLHUP)
        print("[DISPLAY/DBUS] Subscribed to DisplayAdded, profileChanged & configurationReloaded", flush=True)

    cfg_inotify_fd = setup_powerdevilrc_inotify()
    if cfg_inotify_fd is not None:
        poller.register(cfg_inotify_fd, select.POLLIN | select.POLLERR)

    last_toggle_time = 0
    last_fn_l_time = 0
    last_fn_n_time = 0
    last_tap_time = 0
    copilot_is_hold = False
    last_scancode = 0

    wl_retry_after = 0.0
    dbus_retry_after = 0.0

    def _handle_sigterm(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, _handle_sigterm)

    global _deferred_drm_recovery
    try:
        while True:
            # Sleep indefinitely in kernel wait queue (0% CPU); use a bounded timeout only when
            # deferred DRM recovery is pending or a Wayland/DBus socket reconnect is scheduled.
            need_poll_wake = (
                (_deferred_drm_recovery and not _idle_guard.is_sleeping_or_idle)
                or (wl_fd < 0 and wl_retry_after > 0)
                or (dbus_fd < 0 and dbus_retry_after > 0)
            )
            timeout = 1000 if need_poll_wake else None
            events = poller.poll(timeout)
            reap_zombies()

            now_mono = time.monotonic()
            if wl_fd < 0 and wl_retry_after > 0 and now_mono >= wl_retry_after:
                if _idle_guard.connect():
                    wl_fd = _idle_guard.fileno()
                    poller.register(wl_fd, select.POLLIN | select.POLLERR | select.POLLHUP)
                    wl_retry_after = 0.0
                else:
                    wl_retry_after = now_mono + 5.0

            if dbus_fd < 0 and dbus_retry_after > 0 and now_mono >= dbus_retry_after:
                if _dbus_listener.connect():
                    dbus_fd = _dbus_listener.fileno()
                    poller.register(dbus_fd, select.POLLIN | select.POLLERR | select.POLLHUP)
                    dbus_retry_after = 0.0
                else:
                    dbus_retry_after = now_mono + 5.0

            # Check deferred recovery once awake, not reprobing, and unlocked
            if _deferred_drm_recovery and not _idle_guard.is_sleeping_or_idle and not _idle_guard.is_reprobing:
                curr_ext = check_external_displays_connected()
                if curr_ext:
                    print("[DISPLAY] External display reconnected/woke ➔ clearing deferred recovery", flush=True)
                    _deferred_drm_recovery = False
                    last_external_connected = True
                elif is_internal_edp_on() and not is_session_locked():
                    print("[DISPLAY] User resumed on internal panel after external disconnect ➔ executing deferred recovery", flush=True)
                    _deferred_drm_recovery = False
                    handle_drm_hotplug(force=True)

            for fd, event in events:
                # Handle Wayland ext_idle_notifier_v1 + org_kde_kwin_dpms + wl_output events
                if wl_fd >= 0 and fd == wl_fd:
                    if not _idle_guard.process_events():
                        try:
                            poller.unregister(wl_fd)
                        except Exception:
                            pass
                        _idle_guard.close()
                        wl_fd = -1
                        if _idle_guard.connect():
                            wl_fd = _idle_guard.fileno()
                            poller.register(wl_fd, select.POLLIN | select.POLLERR | select.POLLHUP)
                        else:
                            wl_retry_after = time.monotonic() + 3.0

                # Handle Session DBus signals (DisplayAdded, profileChanged, configurationReloaded)
                elif dbus_fd >= 0 and fd == dbus_fd:
                    sigs = _dbus_listener.read_signals()
                    if sigs is None:
                        try:
                            poller.unregister(dbus_fd)
                        except Exception:
                            pass
                        _dbus_listener.close()
                        dbus_fd = -1
                        dbus_retry_after = time.monotonic() + 3.0
                    else:
                        for iface, member, arg0 in sigs:
                            if iface == "org.kde.ScreenBrightness" and member == "DisplayAdded":
                                if _idle_guard._dimmed_saved and not _idle_guard.is_dim_idle and not _idle_guard.is_sleeping_or_idle and not _idle_guard.is_reprobing:
                                    threading.Thread(
                                        target=_idle_guard.restore_external_dim,
                                        args=(arg0,),
                                        daemon=True,
                                    ).start()
                            elif iface == "org.kde.Solid.PowerManagement" and member in ("profileChanged", "configurationReloaded"):
                                _idle_guard.configure_timeouts()

                # Handle ~/.config/powerdevilrc live edits (GUI Power Management changes)
                elif cfg_inotify_fd is not None and fd == cfg_inotify_fd:
                    should_reload = False
                    while True:
                        try:
                            raw = os.read(cfg_inotify_fd, 4096)
                            if not raw:
                                break
                            if b"powerdevilrc" in raw:
                                should_reload = True
                        except BlockingIOError:
                            break
                        except Exception:
                            break
                    if should_reload:
                        _idle_guard.configure_timeouts()

                # Handle Profile change (Fn+Q)
                elif profile_file and fd == profile_file.fileno():
                    profile_file.seek(0)
                    curr = profile_file.read().strip()
                    if curr and curr != last_profile_state:
                        apply_rapl_mmio(curr, source="PROFILE")
                        send_profile_osd(curr)
                        last_profile_state = curr

                # Handle Hotkeys (Fn+R & Fn+L)
                elif hotkey_fd and fd == hotkey_fd:
                    while True:
                        try:
                            data = os.read(hotkey_fd, 24)
                            if len(data) < 24:
                                break
                            sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                            
                            # EV_SYN (etype 0) boundary: reset pending scancode
                            if etype == 0:
                                last_scancode = 0

                            # EV_MSC (etype 4) captures raw hardware scancode
                            elif etype == 4:
                                last_scancode = value

                            # EV_KEY (etype 1), value 1 = PRESS
                            elif etype == 1 and value == 1:
                                now = time.time()
                                
                                # Fn + R: Refresh Rate Toggle (Keycode 562)
                                if code == KEY_REFRESH_RATE_TOGGLE:
                                    if now - last_toggle_time > 0.4:
                                        last_toggle_time = now
                                        ensure_gui_environment()
                                        if os.path.isfile(LHZ_BIN):
                                            subprocess.run([LHZ_BIN, "toggle"], check=False)

                                # Fn + L: Display Color Profile Cycle / Configurable Action
                                # Strictly match Fn+L scancodes (0x012c, 0x012b). KEY_UNKNOWN_VPC (240)
                                # is generic and also emitted by Fn+Up (0x0119), Fn+Down (0x011a), etc.
                                elif last_scancode in (SCANCODE_FN_L_A, SCANCODE_FN_L_B):
                                    if now - last_fn_l_time > 0.4:
                                        last_fn_l_time = now
                                        cfg, _ = load_config()
                                        cfg_l = cfg.get("fn_l") if "fn_l" in cfg else cfg.get("fn_l_command")
                                        default_l = {"action": "cycle", "exec": "lcolor cycle"}
                                        dispatch_hotkey("Fn+L", cfg_l, default_l)

                                # Fn + N: Configurable Launcher / Utility
                                elif code == KEY_FN_N or last_scancode == SCANCODE_FN_N:
                                    if now - last_fn_n_time > 0.4:
                                        last_fn_n_time = now
                                        trigger_fn_n("Fn+N")

                                last_scancode = 0

                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[HOTKEY] Unexpected read error: {e}", flush=True)
                            break

                # Handle Copilot Key (Keycode 193) on ITE Keyboard: Tap vs Hold
                elif kbd_fd and fd == kbd_fd:
                    while True:
                        try:
                            data = os.read(kbd_fd, 24)
                            if len(data) < 24:
                                break
                            sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                            
                            # EV_KEY (etype 1), code 193 (KEY_F23 / Copilot)
                            if etype == 1 and code == KEY_COPILOT:
                                if value == 1:  # PRESS
                                    copilot_is_hold = False
                                elif value == 2:  # REPEAT (Held down >= 250ms)
                                    if not copilot_is_hold:
                                        copilot_is_hold = True
                                        print("[COPILOT] Long press detected ➔ Opening Candidates Menu", flush=True)
                                        launch_copilot_menu()
                                elif value == 0:  # RELEASE
                                    if not copilot_is_hold:
                                        # Short tap
                                        now = time.time()
                                        if now - last_tap_time > 0.3:
                                            last_tap_time = now
                                            trigger_copilot_tap("COPILOT")
                                    copilot_is_hold = False

                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[COPILOT] Unexpected read error: {e}", flush=True)
                            break

                # Handle Kernel Uevents (DRM Display Hotplug & Power Supply AC/Battery/Resume)
                elif nl_sock and fd == nl_sock.fileno():
                    has_drm_event = False
                    has_psy_event = False
                    while True:
                        try:
                            data = nl_sock.recv(4096)
                            if not data:
                                break
                            if b"SUBSYSTEM=drm" in data:
                                has_drm_event = True
                            if b"SUBSYSTEM=power_supply" in data:
                                has_psy_event = True
                        except BlockingIOError:
                            break
                        except Exception:
                            break

                    if has_psy_event:
                        apply_rapl_mmio(source="UEVENT")
                        _idle_guard.configure_timeouts()

                    if has_drm_event:
                        curr_external = check_external_displays_connected()
                        # Detect transition: external display was unplugged
                        if last_external_connected and not curr_external:
                            print("[DISPLAY] DRM event: External display unplugged ➔ evaluating PowerDevil recovery", flush=True)
                            handle_drm_hotplug()
                        elif not last_external_connected and curr_external:
                            if _idle_guard.is_sleeping_or_idle:
                                _idle_guard.enforce_dpms_off_if_idle(reason="RECONNECT_DURING_IDLE")
                            else:
                                _idle_guard.clear_reprobing()
                                if _deferred_drm_recovery:
                                    print("[DISPLAY] External display reconnected ➔ clearing deferred recovery", flush=True)
                                    _deferred_drm_recovery = False
                                # If the final display already registered before clear_reprobing(),
                                # trigger one immediate restore check now; otherwise DisplayAdded will handle it.
                                if _idle_guard._dimmed_saved and not _idle_guard.is_dim_idle:
                                    threading.Thread(target=_idle_guard.restore_external_dim, daemon=True).start()
                        elif _idle_guard.is_sleeping_or_idle and not is_display_sleeping():
                            _idle_guard.enforce_dpms_off_if_idle(reason="DRM_WAKE_DURING_IDLE")
                        last_external_connected = curr_external

                # Handle local IPC triggers (e.g. lcopilot for external keyboards)
                elif ipc_sock and fd == ipc_sock.fileno():
                    while True:
                        try:
                            cmd_bytes = ipc_sock.recv(256)
                            if not cmd_bytes:
                                break
                            ipc_cmd = cmd_bytes.decode("utf-8", errors="ignore").strip().lower()
                            if ipc_cmd == "copilot_auto":
                                trigger_copilot_auto("IPC/COPILOT")
                            elif ipc_cmd == "copilot_tap":
                                trigger_copilot_tap("IPC/COPILOT")
                            elif ipc_cmd == "copilot_menu":
                                print("[IPC/COPILOT] Quick Launch menu requested", flush=True)
                                launch_copilot_menu()
                            elif ipc_cmd == "fn_n":
                                trigger_fn_n("IPC/Fn+N")
                            elif ipc_cmd == "sync_rapl":
                                apply_rapl_mmio(source="IPC")
                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[IPC] Command error: {e}", flush=True)
                            break

    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        _idle_guard.close()
        _dbus_listener.close()
        if cfg_inotify_fd is not None:
            try:
                os.close(cfg_inotify_fd)
            except Exception:
                pass
        if ipc_sock:
            try:
                ipc_sock.close()
            except Exception:
                pass
        if os.path.exists(IPC_SOCKET_PATH):
            try:
                os.unlink(IPC_SOCKET_PATH)
            except Exception:
                pass

if __name__ == "__main__":
    main()
