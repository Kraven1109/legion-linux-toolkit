#!/usr/bin/env python3
"""
Unified Legion Background Event Daemon
Listens to:
  1. /sys/firmware/acpi/platform_profile (Fn+Q & lmode)
  2. /dev/input/by-path/*-VPC2004:00-event:
     - Keycode 562 (Fn+R ➔ Refresh Rate 240Hz/60Hz)
     - Scancodes 0x012c / 0x012b (Fn+L ➔ Logo Light ON/OFF OSD)
  3. /dev/input/event* (ITE Device 8258 Keyboard):
     - Keycode 193 (Copilot Key):
       * Tap (< 0.3s)   ➔ Launch copilot_tap (Alacritty)
       * Hold (>= 0.3s) ➔ Popup Candidate Menu (kdialog 1-2-3 picker)
Zero polling, sleeps indefinitely in kernel wait queues via select.poll().
"""

import select
import subprocess
import sys
import os
import struct
import time
import glob
import fcntl
import json
import shlex
import shutil
import threading

NODE = "/sys/firmware/acpi/platform_profile"
HOTKEY_NODE = "/dev/input/by-path/pci-0000:00:1f.0-platform-VPC2004:00-event"
KBD_SYMLINK = "/dev/input/by-path/pci-0000:80:14.0-usb-0:4:1.0-event-kbd"
CONFIG_PATH = os.path.expanduser("~/.config/legion/config.json")
DEFAULT_COPILOT_CMD = "/usr/bin/alacritty"
LHZ_BIN = os.path.expanduser("~/.local/bin/lhz")
LCOLOR_BIN = os.path.expanduser("~/.local/bin/lcolor")
ICON_DIR = os.path.expanduser("~/.local/share/icons/legion")

# Linux Input Event Codes
KEY_REFRESH_RATE_TOGGLE = 562
KEY_UNKNOWN_VPC = 240
KEY_COPILOT = 193  # KEY_F23 emitted exclusively by Copilot key
KEY_FN_N = 618     # Fn+N (scancode 0x012a) — default: "device info" (useless), repurposed

# Scancodes on VPC2004 for Fn+L (repurposed to Color Profile Cycling)
SCANCODE_FN_L_A = 0x012c
SCANCODE_FN_L_B = 0x012b
SCANCODE_FN_N    = 0x012a  # Fn+N scancode on VPC2004

DEFAULT_CANDIDATES = [
    {"key": "1", "name": "Terminal (Konsole)", "exec": "konsole"},
    {"key": "2", "name": "KRunner Search", "exec": "krunner"},
    {"key": "3", "name": "Screenshot (Spectacle)", "exec": "spectacle -r"},
]

PROFILES = {
    "low-power": {
        "title": "Quiet Mode",
        "msg": "🔵 Blue LED • Silent fans, power-saving",
        "icon_file": "quiet.svg",
        "fallback": "battery-charging"
    },
    "balanced": {
        "title": "Balanced Mode",
        "msg": "⚪ White LED • Dynamic auto power allocation",
        "icon_file": "balanced.svg",
        "fallback": "battery-profile-balanced"
    },
    "performance": {
        "title": "Performance Mode",
        "msg": "🔴 Red LED • Full 175W TGP & High CPU boost",
        "icon_file": "performance.svg",
        "fallback": "preferences-system-performance"
    },
    "max-power": {
        "title": "Extreme Mode",
        "msg": "🟣 Purple LED • Maximum fan curves & peak power",
        "icon_file": "extreme.svg",
        "fallback": "speedometer"
    },
    "custom": {
        "title": "Custom Mode",
        "msg": "Custom thermal envelope & curves",
        "icon_file": "custom.svg",
        "fallback": "preferences-system"
    }
}

def ensure_gui_environment():
    """
    Ensures that WAYLAND_DISPLAY, DISPLAY, and desktop session variables
    are properly set in os.environ.

    When the daemon starts before the desktop session (e.g., at system boot via default.target),
    Wayland variables are not yet present. This dynamically acquires them from
    `systemctl --user show-environment` or by probing `/run/user/<uid>/wayland-*`.
    """
    if os.environ.get("WAYLAND_DISPLAY") and os.environ.get("DISPLAY"):
        return

    uid = os.getuid()
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    os.environ["XDG_RUNTIME_DIR"] = runtime_dir

    # 1. Query systemd user environment (authoritative in KDE Plasma 6 Wayland)
    try:
        res = subprocess.run(
            ["systemctl", "--user", "show-environment"],
            capture_output=True, text=True, timeout=1
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    if k in (
                        "WAYLAND_DISPLAY", "DISPLAY", "XDG_CURRENT_DESKTOP",
                        "XDG_SESSION_TYPE", "XAUTHORITY", "PATH", "QT_WAYLAND_RECONNECT"
                    ):
                        os.environ[k] = v
    except Exception:
        pass

    # 2. Heuristic fallback: check /run/user/<uid>/wayland-* if WAYLAND_DISPLAY is still missing
    if not os.environ.get("WAYLAND_DISPLAY"):
        sockets = [
            s for s in glob.glob(f"{runtime_dir}/wayland-*")
            if not s.endswith(".lock")
        ]
        if sockets:
            os.environ["WAYLAND_DISPLAY"] = os.path.basename(sorted(sockets)[0])

    if not os.environ.get("DISPLAY"):
        os.environ["DISPLAY"] = ":0"

    if not os.environ.get("XDG_CURRENT_DESKTOP"):
        os.environ["XDG_CURRENT_DESKTOP"] = "KDE"

def send_error_osd(title, msg):
    """Shows a persistent desktop error notification for user-visible failures."""
    ensure_gui_environment()
    cmd = [
        "notify-send",
        "-a", "Legion Toolkit",
        "-i", "dialog-error",
        "-u", "critical",
        "-t", "5000",
        title,
        msg
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

def get_copilot_config():
    """
    Reads copilot config dynamically from ~/.config/legion/config.json.
    Returns (config_dict, error_or_None).
    """
    if not os.path.isfile(CONFIG_PATH):
        return {
            "tap": DEFAULT_COPILOT_CMD,
            "candidates": DEFAULT_CANDIDATES
        }, None
    try:
        with open(CONFIG_PATH, "r") as f:
            cfg = json.load(f)
        tap_cmd = cfg.get("copilot_tap") or cfg.get("copilot_command") or DEFAULT_COPILOT_CMD
        candidates = cfg.get("copilot_candidates", DEFAULT_CANDIDATES)
        return {
            "tap": tap_cmd,
            "candidates": candidates
        }, None
    except json.JSONDecodeError as e:
        return {"tap": DEFAULT_COPILOT_CMD, "candidates": DEFAULT_CANDIDATES}, f"config.json parse error: {e}"
    except Exception as e:
        return {"tap": DEFAULT_COPILOT_CMD, "candidates": DEFAULT_CANDIDATES}, f"config.json read error: {e}"

def run_executable(cmd_str, source_name="Copilot"):
    """Validates and launches an application or command string."""
    ensure_gui_environment()
    try:
        args = shlex.split(cmd_str)
    except ValueError as e:
        errmsg = f"Invalid command syntax: {cmd_str!r}\n{e}"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Config Error", errmsg)
        return False

    if not args:
        errmsg = f"Command is empty string\nEdit ~/.config/legion/config.json"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Empty Command", errmsg)
        return False

    exe = shutil.which(args[0]) or (args[0] if os.path.isfile(args[0]) else None)
    if not exe:
        errmsg = f"App not found: {args[0]!r}\nEdit ~/.config/legion/config.json"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — App Not Found", errmsg)
        return False

    try:
        subprocess.Popen(args, start_new_session=True)
        print(f"[{source_name}] Executed successfully: {cmd_str}", flush=True)
        return True
    except Exception as e:
        errmsg = f"Launch failed: {e}\nCommand: {cmd_str}"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Launch Error", errmsg)
        return False

def dispatch_hotkey(hotkey_label, cfg_entry, default_entry):
    """
    Executes a configurable hotkey action based on ~/.config/legion/config.json.
    Supports two clean modes:
      1. 'exec' / 'cycle' : Directly runs the command (e.g. lcolor cycle, lhz toggle, spectacle).
      2. 'toggle'         : Process toggle. Checks if 'process' is running via pgrep.
                            If running -> kills it via pkill.
                            If not running -> launches 'exec'.
    cfg_entry can be:
      - A dict: {"action": "toggle", "exec": "...", "process": "..."}
      - A string: "lcolor cycle" or "alacritty -e nvtop"
      - None: falls back to default_entry
    """
    ensure_gui_environment()
    entry = cfg_entry if cfg_entry is not None else default_entry

    if isinstance(entry, dict):
        action = entry.get("action", "exec").strip().lower()
        cmd = entry.get("exec", "").strip()
        proc_name = entry.get("process", "").strip() or None
    elif isinstance(entry, str):
        cmd = entry.strip()
        action = "exec"
        proc_name = None
    else:
        return

    if not cmd or cmd.lower() in ("disabled", "none", "off", "false"):
        return

    if cmd.startswith("lcolor") and os.path.isfile(LCOLOR_BIN):
        cmd = cmd.replace("lcolor", LCOLOR_BIN, 1)
    elif cmd.startswith("lhz") and os.path.isfile(LHZ_BIN):
        cmd = cmd.replace("lhz", LHZ_BIN, 1)

    if action == "toggle":
        if not proc_name:
            args = shlex.split(cmd)
            if len(args) >= 3 and args[1] in ("-e", "-x", "--command"):
                proc_name = os.path.basename(args[2])
            else:
                proc_name = os.path.basename(args[-1])

        already_running = False
        if proc_name:
            already_running = subprocess.run(
                ["pgrep", "-x", proc_name],
                capture_output=True
            ).returncode == 0

        if already_running:
            subprocess.run(["pkill", "-x", proc_name], check=False)
            print(f"[{hotkey_label}] Toggled OFF: killed {proc_name!r}", flush=True)
        else:
            run_executable(cmd, hotkey_label)
    else:
        run_executable(cmd, hotkey_label)

# Guard: prevent multiple picker windows stacking if user holds repeatedly
_menu_open = threading.Event()
_menu_proc = None                    # live Popen handle for the current picker
_menu_proc_lock = threading.Lock()   # protects _menu_proc and _abort_requested
_abort_requested = False             # dismiss was requested before proc was spawned

LEGION_THEME = os.path.expanduser("~/.config/rofi/legion-launcher.rasi")

def _run_picker_proc(cmd, stdin_data=None):
    """Launch a picker subprocess, store its handle, block until done.
    Returns (stdout, returncode). Deadlock-free and handles external termination.

    Fix 1 — deadlock: stderr=DEVNULL prevents the 64 KB OS pipe buffer from
    filling up and blocking the child while Python is stuck on stdout.read().
    communicate() reads stdout/stderr concurrently via internal threads and
    calls wait() — safe even if proc.terminate() is called from another thread.

    Fix 2 — race condition: if a dismiss was requested before we reached Popen
    (i.e. during JSON/config loading), _abort_requested is True and we
    terminate the process immediately after registering it under the lock.
    """
    global _menu_proc, _abort_requested
    ensure_gui_environment()

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if stdin_data is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,  # avoid 64 KB pipe-buffer deadlock
            text=True,
        )
    except Exception as e:
        print(f"[PICKER] Failed to spawn {cmd[0]}: {e}", flush=True)
        return "", -1

    with _menu_proc_lock:
        _menu_proc = proc
        if _abort_requested:
            proc.terminate()
            _abort_requested = False

    try:
        # communicate() handles stdin write + stdout read + wait atomically;
        # returns even if proc was terminated externally mid-flight.
        stdout, _ = proc.communicate(input=stdin_data)
        return stdout, proc.returncode
    except Exception:
        return "", -1
    finally:
        with _menu_proc_lock:
            _menu_proc = None

def _show_rofi(names, lookup):
    """Run rofi -dmenu. Uses Legion theme if present; otherwise rofi's own defaults."""
    rofi_cmd = [
        shutil.which("rofi"), "-dmenu",
        "-i",                   # case-insensitive filter
        "-p", "✦ Quick Launch",
        "-no-custom",           # reject free-text not in list
    ]
    # Only inject our theme if it exists — never silently override a user's own theme
    if os.path.isfile(LEGION_THEME):
        rofi_cmd += ["-theme", LEGION_THEME]

    stdout, returncode = _run_picker_proc(rofi_cmd, stdin_data="\n".join(names))
    selected = stdout.strip()
    if returncode == 0 and selected and selected in lookup:
        run_executable(lookup[selected], f"Candidate [{selected}]")

def _show_kdialog(names, lookup):
    """Fallback menu using kdialog when rofi is not installed."""
    cmd = [shutil.which("kdialog") or "kdialog",
           "--title", "✦ Quick Launch",
           "--menu", "Select Application:"]
    for i, name in enumerate(names, 1):
        cmd += [str(i), name]
    stdout, returncode = _run_picker_proc(cmd)
    tag = stdout.strip()
    index_lookup = {str(i): name for i, name in enumerate(names, 1)}
    if returncode == 0 and tag and tag in index_lookup:
        name = index_lookup[tag]
        if name in lookup:
            run_executable(lookup[name], f"Candidate [{name}]")

def launch_copilot_menu():
    """Spawns picker menu in a background thread.
    - Uses rofi if available (with Legion theme if present, else rofi defaults)
    - Falls back to kdialog if rofi is not installed
    - Second hold while menu is open → dismisses (terminates) the picker.
      Works even during the brief window before the subprocess is spawned."""
    global _abort_requested
    if _menu_open.is_set():
        with _menu_proc_lock:
            proc = _menu_proc
            if proc and proc.poll() is None:
                # Proc is live — kill it directly
                proc.terminate()
                print("[COPILOT MENU] Dismissed by second hold", flush=True)
            else:
                # Proc not yet spawned (still in config-read window) — mark abort
                _abort_requested = True
                print("[COPILOT MENU] Abort queued (proc not yet live)", flush=True)
        return

    def _menu_worker():
        _menu_open.set()
        try:
            cfg, err = get_copilot_config()
            if err:
                send_error_osd("Copilot Menu — Config Warning", err)

            candidates = cfg.get("candidates", DEFAULT_CANDIDATES)
            lookup = {}   # name → exec_str (preserve insertion order for kdialog)
            names = []
            for item in candidates:
                name = item.get("name", "Application")
                lookup[name] = item.get("exec", "")
                names.append(name)

            try:
                if shutil.which("rofi"):
                    _show_rofi(names, lookup)
                elif shutil.which("kdialog"):
                    _show_kdialog(names, lookup)
                else:
                    print("[COPILOT MENU] Neither rofi nor kdialog found — install one.", flush=True)
                    send_error_osd("Copilot Menu — No Picker Found",
                                   "Install rofi or kdialog to use the candidate menu.")
            except Exception as e:
                print(f"[COPILOT MENU] Error: {e}", flush=True)
        finally:
            _menu_open.clear()

    threading.Thread(target=_menu_worker, daemon=True).start()

def send_profile_osd(state):
    ensure_gui_environment()
    info = PROFILES.get(state, {
        "title": f"Profile: {state}",
        "msg": "ACPI platform_profile changed",
        "icon_file": "custom.svg",
        "fallback": "preferences-system-power-management"
    })
    
    icon_path = os.path.join(ICON_DIR, info["icon_file"])
    icon = icon_path if os.path.isfile(icon_path) else info["fallback"]

    cmd = [
        "notify-send",
        "-a", "Legion Profile",
        "-i", icon,
        "-h", "string:x-canonical-private-synchronous:legion-profile-osd",
        "-t", "1800",
        info["title"],
        info["msg"]
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

def find_keyboard_fd():
    """Find and open the ITE keyboard event node."""
    if os.path.exists(KBD_SYMLINK):
        target = os.path.realpath(KBD_SYMLINK)
        try:
            fd = os.open(target, os.O_RDONLY | os.O_NONBLOCK)
            return fd, target
        except Exception:
            pass
    for p in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(256)
            fcntl.ioctl(fd, 0x82004506, buf)
            name = buf.split(b"\x00")[0].decode("utf-8", "ignore")
            if "ITE" in name and "Keyboard" in name:
                return fd, p
            os.close(fd)
        except Exception:
            pass
    return None, None

def main():
    ensure_gui_environment()
    poller = select.poll()

    # 1. Register ACPI platform_profile for Fn+Q & lmode
    profile_file = None
    last_profile_state = ""
    if os.path.exists(NODE):
        try:
            profile_file = open(NODE, "r")
            last_profile_state = profile_file.read().strip()
            poller.register(profile_file, select.POLLPRI | select.POLLERR)
        except Exception:
            pass

    # 2. Register Ideapad extra buttons node for Fn+R & Fn+L
    hotkey_fd = None
    if os.path.exists(HOTKEY_NODE):
        try:
            hotkey_fd = os.open(HOTKEY_NODE, os.O_RDONLY | os.O_NONBLOCK)
            poller.register(hotkey_fd, select.POLLIN | select.POLLERR)
        except Exception:
            pass

    # 3. Register ITE Keyboard node for Copilot Key
    kbd_fd, kbd_path = find_keyboard_fd()
    if kbd_fd:
        poller.register(kbd_fd, select.POLLIN | select.POLLERR)
        print(f"[INIT] Successfully hooked keyboard on {kbd_path}", flush=True)
    else:
        print("[INIT] Notice: ITE Keyboard node not accessible without read permissions.", flush=True)

    last_toggle_time = 0
    last_fn_l_time = 0
    last_fn_n_time = 0
    last_tap_time = 0
    copilot_is_hold = False
    last_scancode = 0

    try:
        while True:
            # Sleep indefinitely in kernel wait queue (0% CPU overhead)
            events = poller.poll()
            for fd, event in events:
                # Handle Profile change (Fn+Q)
                if profile_file and fd == profile_file.fileno():
                    profile_file.seek(0)
                    curr = profile_file.read().strip()
                    if curr and curr != last_profile_state:
                        send_profile_osd(curr)
                        last_profile_state = curr

                # Handle Hotkeys (Fn+R & Fn+L)
                elif hotkey_fd and fd == hotkey_fd:
                    while True:
                        try:
                            data = os.read(hotkey_fd, 24)
                            if len(data) < 24:
                                break
                            sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                            
                            # EV_MSC (etype 4) captures raw hardware scancode
                            if etype == 4:
                                last_scancode = value

                            # EV_KEY (etype 1), value 1 = PRESS
                            elif etype == 1 and value == 1:
                                now = time.time()
                                
                                # Fn + R: Refresh Rate Toggle (Keycode 562)
                                if code == KEY_REFRESH_RATE_TOGGLE:
                                    if now - last_toggle_time > 0.4:
                                        last_toggle_time = now
                                        ensure_gui_environment()
                                        if os.path.isfile(LHZ_BIN):
                                            subprocess.run([LHZ_BIN, "toggle"], check=False)

                                # Fn + L: Display Color Profile Cycle / Configurable Action
                                elif code == KEY_UNKNOWN_VPC or last_scancode in (SCANCODE_FN_L_A, SCANCODE_FN_L_B):
                                    if now - last_fn_l_time > 0.4:
                                        last_fn_l_time = now
                                        cfg = {}
                                        try:
                                            with open(CONFIG_PATH) as _f:
                                                cfg = json.load(_f)
                                        except Exception:
                                            pass
                                        cfg_l = cfg.get("fn_l") if "fn_l" in cfg else cfg.get("fn_l_command")
                                        default_l = {"action": "cycle", "exec": "lcolor cycle"}
                                        dispatch_hotkey("Fn+L", cfg_l, default_l)

                                # Fn + N: Configurable Launcher / Utility
                                elif code == KEY_FN_N:
                                    if now - last_fn_n_time > 0.4:
                                        last_fn_n_time = now
                                        cfg = {}
                                        try:
                                            with open(CONFIG_PATH) as _f:
                                                cfg = json.load(_f)
                                        except Exception:
                                            pass
                                        cfg_n = cfg.get("fn_n") if "fn_n" in cfg else cfg.get("fn_n_command")
                                        default_n = {"action": "toggle", "exec": "alacritty -e nvtop", "process": "nvtop"}
                                        dispatch_hotkey("Fn+N", cfg_n, default_n)

                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[HOTKEY] Unexpected read error: {e}", flush=True)
                            break

                # Handle Copilot Key (Keycode 193) on ITE Keyboard: Tap vs Hold
                elif kbd_fd and fd == kbd_fd:
                    while True:
                        try:
                            data = os.read(kbd_fd, 24)
                            if len(data) < 24:
                                break
                            sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                            
                            # EV_KEY (etype 1), code 193 (KEY_F23 / Copilot)
                            if etype == 1 and code == KEY_COPILOT:
                                if value == 1:  # PRESS
                                    copilot_is_hold = False
                                elif value == 2:  # REPEAT (Held down >= 250ms)
                                    if not copilot_is_hold:
                                        copilot_is_hold = True
                                        print("[COPILOT] Long press detected ➔ Opening Candidates Menu", flush=True)
                                        launch_copilot_menu()
                                elif value == 0:  # RELEASE
                                    if not copilot_is_hold:
                                        # Short tap
                                        now = time.time()
                                        if now - last_tap_time > 0.3:
                                            last_tap_time = now
                                            print("[COPILOT] Short tap detected ➔ Launching Default App", flush=True)
                                            cfg, err = get_copilot_config()
                                            if err:
                                                send_error_osd("Copilot Key — Config Warning", err)
                                            run_executable(cfg.get("tap", DEFAULT_COPILOT_CMD), "Copilot Tap")
                                    copilot_is_hold = False

                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[COPILOT] Unexpected read error: {e}", flush=True)
                            break

    except KeyboardInterrupt:
        sys.exit(0)

if __name__ == "__main__":
    main()
