#!/usr/bin/env python3
"""
Unified Legion Background Event Daemon
Listens to:
  1. /sys/firmware/acpi/platform_profile (Fn+Q & lmode)
  2. /dev/input/by-path/*-VPC2004:00-event:
     - Keycode 562 (Fn+R ➔ Refresh Rate 240Hz/60Hz)
     - Scancodes 0x012c / 0x012b (Fn+L ➔ Display Color Profile Cycle)
     - Keycode 618 / Scancode 0x012a (Fn+N ➔ Smart Launcher / Utility)
  3. /dev/input/event* (ITE Device 8258 Keyboard):
     - Keycode 193 (Copilot Key):
       * Tap (< 0.3s)   ➔ Smart Terminal / Candidate Launcher
       * Hold (>= 0.3s) ➔ Popup Candidate Menu (Rofi / Kdialog fallback)
Zero polling, sleeps indefinitely in kernel wait queues via select.poll().
"""

import select
import subprocess
import sys
import os
import struct
import time
import glob
import fcntl
import json
import shlex
import shutil
import threading
import re
import tempfile
import signal

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from legion_core import (
    PLATFORM_PROFILE_NODE as NODE,
    PLATFORM_PROFILES as PROFILES,
    HOTKEY_NODE,
    CONFIG_DIR,
    ICON_DIR,
    ensure_gui_environment,
)

KBD_SYMLINK = "/dev/input/by-path/pci-0000:80:14.0-usb-0:4:1.0-event-kbd"
CONFIG_JSONC_PATH = os.path.join(CONFIG_DIR, "config.jsonc")
CONFIG_JSON_PATH = os.path.join(CONFIG_DIR, "config.json")
DEFAULT_COPILOT_CMD = {"action": "smart_terminal", "exec": "alacritty", "process": "alacritty"}
LHZ_BIN = os.path.expanduser("~/.local/bin/lhz")
LCOLOR_BIN = os.path.expanduser("~/.local/bin/lcolor")

# Linux Input Event Codes
KEY_REFRESH_RATE_TOGGLE = 562
KEY_UNKNOWN_VPC = 240  # Generic unmapped VPC keycode (shared by Fn+L, Fn+Up/Down arrows — filter by scancode)
KEY_COPILOT = 193      # KEY_F23 emitted exclusively by Copilot key
KEY_FN_N = 618         # Fn+N (scancode 0x012a) — default: "device info" (useless), repurposed

# Scancodes on VPC2004 for Fn+L (repurposed to Color Profile Cycling)
SCANCODE_FN_L_A = 0x012c
SCANCODE_FN_L_B = 0x012b
SCANCODE_FN_N    = 0x012a  # Fn+N scancode on VPC2004

DEFAULT_CANDIDATES = [
    {"key": "1", "name": "Terminal (Konsole)", "exec": "konsole"},
    {"key": "2", "name": "KRunner Search", "exec": "krunner"},
    {"key": "3", "name": "Screenshot (Spectacle)", "exec": "spectacle -r"},
]

def send_error_osd(title, msg):
    """Shows a persistent desktop error notification for user-visible failures."""
    ensure_gui_environment()
    cmd = [
        "notify-send",
        "-a", "Legion Toolkit",
        "-i", "dialog-error",
        "-u", "critical",
        "-t", "5000",
        title,
        msg
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

def reap_zombies():
    """Reaps terminated child processes to prevent defunct/zombie processes."""
    try:
        while True:
            pid, _ = os.waitpid(-1, os.WNOHANG)
            if pid <= 0:
                break
    except OSError:
        pass

def parse_jsonc(text):
    """
    Parses JSON with single-line (//) and multi-line (/* */) comments,
    preserving string literals and stripping trailing commas.
    """
    pattern = r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*.*?\*/'
    def replace(match):
        if match.group(1):
            return match.group(1)
        return ""
    cleaned = re.sub(pattern, replace, text, flags=re.DOTALL)
    cleaned = re.sub(r",\s*([\]}])", r"\1", cleaned)
    return json.loads(cleaned)

def load_config():
    """
    Reads configuration dynamically from ~/.config/legion/config.jsonc (or config.json).
    Returns (config_dict, error_or_None).
    """
    for path in (CONFIG_JSONC_PATH, CONFIG_JSON_PATH):
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    return parse_jsonc(f.read()), None
            except Exception as e:
                return {}, f"{os.path.basename(path)} error: {e}"
    return {}, None

def get_copilot_config():
    """
    Reads copilot config dynamically from ~/.config/legion/config.jsonc (or config.json).
    Returns (config_dict, error_or_None).
    """
    cfg, err = load_config()
    if not cfg and not err:
        return {
            "tap": DEFAULT_COPILOT_CMD,
            "candidates": DEFAULT_CANDIDATES
        }, None
    tap_entry = cfg.get("copilot_tap") if "copilot_tap" in cfg else cfg.get("copilot_command", DEFAULT_COPILOT_CMD)
    candidates = cfg.get("copilot_candidates", DEFAULT_CANDIDATES)
    return {
        "tap": tap_entry,
        "candidates": candidates
    }, err

def run_executable(cmd_str, source_name="Copilot", env_extra=None):
    """Validates and launches an application outside the daemon's cgroup."""
    ensure_gui_environment()
    try:
        args = shlex.split(cmd_str)
    except ValueError as e:
        errmsg = f"Invalid command syntax: {cmd_str!r}\n{e}"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Config Error", errmsg)
        return False

    if not args:
        errmsg = f"Command is empty string\nEdit ~/.config/legion/config.jsonc"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Empty Command", errmsg)
        return False

    exe = shutil.which(args[0]) or (args[0] if os.path.isfile(args[0]) else None)
    if not exe:
        errmsg = f"App not found: {args[0]!r}\nEdit ~/.config/legion/config.jsonc"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — App Not Found", errmsg)
        return False

    try:
        # A direct child inherits this service's cgroup, inflating the daemon's
        # resource accounting and making systemctl restart kill the app. A user
        # scope gives each interactive launch an independent lifecycle instead.
        launcher = shutil.which("systemd-run")
        full_env = dict(os.environ)
        if env_extra:
            full_env.update(env_extra)

        if launcher:
            launcher_cmd = [launcher, "--user", "--scope", "--collect", "--quiet"]
            if env_extra:
                for k, v in env_extra.items():
                    launcher_cmd.append(f"--setenv={k}={v}")
            launcher_cmd.extend(["--", *args])
            proc = subprocess.Popen(
                launcher_cmd,
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=full_env
            )
        else:
            proc = subprocess.Popen(args, start_new_session=True, env=full_env)
        print(f"[{source_name}] Executed successfully: {cmd_str}", flush=True)
        return proc.pid
    except Exception as e:
        errmsg = f"Launch failed: {e}\nCommand: {cmd_str}"
        print(f"[{source_name}] {errmsg}", flush=True)
        send_error_osd(f"{source_name} — Launch Error", errmsg)
        return None

TERMINAL_COMM_NAMES = {
    "alacritty", "kitty", "foot", "ghostty", "konsole", "wezterm",
    "xterm", "gnome-terminal", "mate-terminal", "xfce4-terminal"
}
SESSION_STOP_NAMES = {
    "systemd", "init", "systemd-run", "plasma-workspace", "kwin_wayland",
    "antigravity-ide", "code", "vscodium", "cursor", "language_server", "node"
}

def get_related_pids(pids):
    """
    Finds all PIDs associated with the target processes in the process tree:
    - Ancestors (parents up to enclosing terminal emulator, stopping before system/session processes)
    - Descendants (children running under the process)
    """
    related = set(pids)
    for pid in pids:
        curr = pid
        for _ in range(4):
            try:
                with open(f"/proc/{curr}/stat", "r") as f:
                    stat_parts = f.read().split()
                    ppid = int(stat_parts[3])
                if ppid <= 1:
                    break
                with open(f"/proc/{ppid}/comm", "r") as f:
                    pcomm = f.read().strip().lower()
                if pcomm in SESSION_STOP_NAMES:
                    break
                related.add(ppid)
                if pcomm in TERMINAL_COMM_NAMES:
                    break
                curr = ppid
            except Exception:
                break
        try:
            with open(f"/proc/{pid}/task/{pid}/children", "r") as f:
                for cpid in f.read().split():
                    if cpid.isdigit():
                        related.add(int(cpid))
        except Exception:
            pass
    return list(related)

def find_process_pids(proc_name, match_type="auto"):
    """
    Finds PIDs for a process name:
    1. Tries exact comm match (pgrep -x).
    2. If not found or if match_type == 'full', tries full cmdline match (pgrep -f),
       reliably handling interpreted scripts (Python, Bash, Node) while excluding
       the daemon itself and zombie processes.
    """
    if not proc_name:
        return []
    pattern = re.escape(proc_name)
    use_full = (match_type == "full") or (match_type != "exact" and (len(proc_name) > 15 or " " in proc_name))
    flag = "-f" if use_full else "-x"

    def _query(flg, pat):
        try:
            res = subprocess.run(["pgrep", flg, "--", pat], capture_output=True, text=True)
            if res.returncode == 0:
                return [int(p) for p in res.stdout.split() if p.isdigit()]
        except Exception:
            pass
        return []

    pids = _query(flag, pattern)
    if not pids and flag == "-x" and match_type != "exact":
        pids = _query("-f", pattern)

    valid_pids = []
    my_pid = os.getpid()
    for pid in pids:
        if pid == my_pid:
            continue
        try:
            with open(f"/proc/{pid}/stat", "r") as f:
                stat_str = f.read()
            rparen = stat_str.rfind(")")
            if rparen != -1 and len(stat_str) > rparen + 2:
                state = stat_str[rparen + 2]
                if state == "Z":
                    continue
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmdline = f.read().replace(b"\x00", b" ").decode("utf-8", "ignore")
            if "legion-profile-osd" in cmdline:
                continue
            valid_pids.append(pid)
        except Exception:
            continue
    return valid_pids

def manage_kwin_window(pids, on_active="close"):
    """
    Interacts with KWin Wayland via DBus Scripting:
    - If currently focused window belongs to target process tree, toggles it off
      (closes or minimizes according to on_active).
    - If target window is in background or minimized, brings it to front and focuses it.
    Returns True if a matching window was found and managed, False otherwise.
    """
    qdbus_bin = shutil.which("qdbus6") or shutil.which("qdbus")
    if not qdbus_bin:
        return False

    related_pids = get_related_pids(pids)
    if not related_pids:
        return False

    script_name = f"legion_win_{int(time.time() * 1000)}"
    action_str = on_active.lower() if on_active else "close"

    kwin_script = f"""
    (function() {{
        var targetPids = {related_pids};
        var activeWin = workspace.activeWindow;

        // 1. If currently focused window belongs to target, handle dismiss/toggle-off
        if (activeWin && targetPids.indexOf(activeWin.pid) !== -1) {{
            var act = "{action_str}";
            if (act === "minimize") {{
                activeWin.minimized = true;
            }} else if (act === "none" || act === "keep") {{
                // keep active (no-op)
            }} else {{
                activeWin.closeWindow();
            }}
            return;
        }}

        // 2. Not active -> find topmost window in stacking order to raise and focus
        var matched = null;
        var list = workspace.stackingOrder || (workspace.windowList ? workspace.windowList() : []);
        for (var i = list.length - 1; i >= 0; i--) {{
            var w = list[i];
            if (w.normalWindow && targetPids.indexOf(w.pid) !== -1) {{
                matched = w;
                break;
            }}
        }}
        if (!matched && workspace.windowList) {{
            var wins = workspace.windowList();
            for (var j = 0; j < wins.length; j++) {{
                var win = wins[j];
                if (win.normalWindow && targetPids.indexOf(win.pid) !== -1) {{
                    matched = win;
                    break;
                }}
            }}
        }}

        if (matched) {{
            if (matched.minimized) {{
                matched.minimized = false;
            }}
            workspace.activeWindow = matched;
            if (workspace.raiseWindow) {{
                workspace.raiseWindow(matched);
            }}
        }}
    }})();
    """

    tmp_file = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(kwin_script)
            tmp_file = f.name

        load_res = subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "loadScript", tmp_file, script_name],
            capture_output=True,
            text=True,
            timeout=2
        )
        if load_res.returncode != 0:
            return False

        script_id = load_res.stdout.strip()
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", f"/Scripting/Script{script_id}", "run"],
            capture_output=True,
            timeout=2
        )
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "unloadScript", script_name],
            capture_output=True,
            timeout=2
        )
        return True
    except Exception as e:
        print(f"[KWIN] Window toggle error: {e}", flush=True)
        return False
    finally:
        if tmp_file and os.path.exists(tmp_file):
            try:
                os.unlink(tmp_file)
            except Exception:
                pass

_last_terminal_spawn = 0.0
_pending_spawn_pid = None

def get_valid_shells():
    """Reads valid login shells from /etc/shells."""
    try:
        with open("/etc/shells", "r") as f:
            return {os.path.basename(line.strip()) for line in f if line.strip() and not line.strip().startswith("#")}
    except Exception:
        return {"bash", "zsh", "fish", "sh", "dash"}

def get_user_terminal_shell():
    """
    Resolves the user's interactive shell preference.
    First checks ~/.config/alacritty/alacritty.toml, then $SHELL / pw_shell.
    """
    try:
        cfg_path = os.path.expanduser("~/.config/alacritty/alacritty.toml")
        if os.path.exists(cfg_path):
            with open(cfg_path, "r") as f:
                for line in f:
                    if "program" in line and "=" in line:
                        parts = line.split("=", 1)
                        val = parts[1].strip().strip('"').strip("'")
                        if os.path.exists(val) and os.access(val, os.X_OK):
                            return val
    except Exception:
        pass
    try:
        import pwd
        return os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell or "/bin/sh"
    except Exception:
        return os.environ.get("SHELL", "/bin/sh")

def is_interactive_shell(sh_args):
    """
    Checks if a shell's arguments match an allowlist of interactive invocation patterns.
    Fails-safe to False (non-interactive) for any script (-c, file path, unknown options).
    """
    if not sh_args:
        return False
    args = sh_args[1:]
    COMMON_SAFE_FLAGS = {"-l", "--login", "-i", "--norc", "--noprofile", "--no-rc", "-s"}
    i = 0
    n = len(args)
    while i < n:
        arg = args[i]
        # Special handling for bash/zsh --rcfile / --init-file <path>
        if arg in ("--rcfile", "--init-file") and i + 1 < n:
            i += 2
            continue
        # Check against common safe interactive flags
        if arg in COMMON_SAFE_FLAGS:
            i += 1
            continue
        # Combined short flags like -il, -li (must only consist of 'i' and 'l')
        if arg.startswith("-") and not arg.startswith("--"):
            flag_chars = set(arg[1:])
            if flag_chars.issubset({"i", "l"}):
                i += 1
                continue
        # Any other flag or argument (like -c, script.sh, etc.) is considered non-interactive
        return False
    return True

def check_pending_spawn(now):
    """
    Checks whether a pending terminal spawn is still active.
    Returns True if spawn is still in progress (should debounce/block duplicate spawn).
    Returns False if spawn has completed (shell transitioned to interactive, died, or timed out).
    """
    global _pending_spawn_pid, _last_terminal_spawn
    if _pending_spawn_pid is None:
        return False

    # 1. Timeout protection: max 3.5s
    if now - _last_terminal_spawn >= 3.5:
        _pending_spawn_pid = None
        return False

    # 2. Check if terminal process is still alive
    try:
        os.kill(_pending_spawn_pid, 0)
    except OSError:
        _pending_spawn_pid = None
        return False

    # 3. Check if any child shell of the pending terminal has transitioned to interactive
    for tc in glob.glob(f"/proc/{_pending_spawn_pid}/task/*/children"):
        try:
            with open(tc) as f:
                children = [int(c) for c in f.read().split() if c.isdigit()]
            for cpid in children:
                with open(f"/proc/{cpid}/cmdline", "rb") as cf:
                    raw = cf.read().split(b"\x00")
                sh_args = [a.decode("utf-8", errors="ignore") for a in raw if a]
                if is_interactive_shell(sh_args):
                    _pending_spawn_pid = None
                    return False
        except Exception:
            pass

    return True

def get_idle_terminals(proc_name="alacritty"):
    """
    Finds running terminal instances whose direct child is a valid login shell
    from /etc/shells and currently truly idle at prompt:
    1. Child is in /etc/shells (excludes nvtop, btop, etc.).
    2. Child is not in zombie state.
    3. tpgid == child_pid (controlling terminal foreground is the shell itself).
    4. Shell wchan is not waiting on a child process (do_wait, wait4, waitid, sigsuspend).
    5. Shell has NO living child processes running in foreground or sharing shell pgrp.
    6. Child argv matches interactive allowlist (excludes -c, scripts, etc.).
    Returns list of dicts: [{"term_pid": pid, "shell_pid": cpid}, ...]
    """
    idle_entries = []
    try:
        out = subprocess.check_output(["pgrep", "-x", proc_name], text=True)
        pids = [int(p) for p in out.split() if p.isdigit()]
    except subprocess.CalledProcessError:
        return []

    valid_shells = get_valid_shells()

    for pid in pids:
        try:
            # 1. Filter out zombie processes
            with open(f"/proc/{pid}/stat", "r") as f:
                raw_stat = f.read()
            after_comm = raw_stat[raw_stat.rfind(")") + 2:].split()
            if after_comm[0] == "Z":
                continue

            # 2. Find direct children of the terminal process
            children = []
            for task_child in glob.glob(f"/proc/{pid}/task/*/children"):
                try:
                    with open(task_child, "r") as f:
                        children.extend([int(c) for c in f.read().split() if c.isdigit()])
                except Exception:
                    pass
            children = list(set(children))
            if not children:
                continue

            # 3. Inspect children: must be a valid shell from /etc/shells AND truly idle at prompt
            for cpid in children:
                try:
                    with open(f"/proc/{cpid}/comm", "r") as f:
                        comm = f.read().strip()
                    if comm not in valid_shells:
                        continue

                    with open(f"/proc/{cpid}/stat", "r") as f:
                        sh_stat = f.read()
                    sh_after = sh_stat[sh_stat.rfind(")") + 2:].split()
                    if sh_after[0] == "Z":
                        continue

                    tpgid = int(sh_after[5])
                    if tpgid != cpid:
                        continue  # Terminal pty foreground owned by child process -> BUSY

                    # 4. Check kernel wait-channel: if waiting on children/signals, shell is NOT at prompt
                    try:
                        with open(f"/proc/{cpid}/wchan", "r") as wf:
                            wchan = wf.read().strip()
                        if any(w in wchan for w in ("do_wait", "wait4", "waitid", "sigsuspend")):
                            continue  # Blocked waiting on child process -> BUSY
                    except Exception:
                        pass

                    # 5. Check if shell has any living children in foreground or shell pgrp
                    has_running_child = False
                    for tc in glob.glob(f"/proc/{cpid}/task/*/children"):
                        try:
                            with open(tc, "r") as cf:
                                sh_kids = [int(x) for x in cf.read().split() if x.isdigit()]
                            for k in sh_kids:
                                try:
                                    with open(f"/proc/{k}/stat", "r") as kf:
                                        kst = kf.read()
                                    kafter = kst[kst.rfind(")") + 2:].split()
                                    if kafter[0] != "Z":  # Living, non-zombie child
                                        kpgrp = int(kafter[2])
                                        ktpgid = int(kafter[5])
                                        if ktpgid == tpgid or kpgrp == tpgid or kpgrp == cpid:
                                            has_running_child = True
                                            break
                                except Exception:
                                    pass
                            if has_running_child:
                                break
                        except Exception:
                            pass

                    if has_running_child:
                        continue  # Shell is actively holding a command -> BUSY

                    # 6. Filter out non-interactive shells via allowlist
                    with open(f"/proc/{cpid}/cmdline", "rb") as f:
                        raw = f.read().split(b"\x00")
                    sh_args = [a.decode("utf-8", errors="ignore") for a in raw if a]
                    if not is_interactive_shell(sh_args):
                        continue

                    idle_entries.append({"term_pid": pid, "shell_pid": cpid})
                    break
                except Exception:
                    continue
        except Exception:
            continue

    return idle_entries

def focus_kwin_idle_terminal(idle_pids):
    """
    Focuses the most recently used idle terminal window in KWin 6 stacking order.
    If an idle terminal is already active in the foreground, keeps focus (Option A).
    """
    qdbus_bin = shutil.which("qdbus6") or shutil.which("qdbus")
    if not qdbus_bin:
        return False

    script_name = f"legion_idle_focus_{int(time.time() * 1000)}"
    kwin_script = f"""
    (function() {{
        var targetPids = {idle_pids};
        var activeWin = workspace.activeWindow;
        if (activeWin && targetPids.indexOf(activeWin.pid) !== -1) {{
            // Option A: already focused on an idle terminal -> keep focus
            return;
        }}
        for (var i = workspace.stackingOrder.length - 1; i >= 0; i--) {{
            var w = workspace.stackingOrder[i];
            if (w.normalWindow && targetPids.indexOf(w.pid) !== -1) {{
                if (w.minimized) w.minimized = false;
                workspace.activeWindow = w;
                if (workspace.raiseWindow) workspace.raiseWindow(w);
                break;
            }}
        }}
    }})();
    """
    tmp_file = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(kwin_script)
            tmp_file = f.name

        load_res = subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "loadScript", tmp_file, script_name],
            capture_output=True,
            text=True,
            timeout=2
        )
        if load_res.returncode != 0:
            return False

        script_id = load_res.stdout.strip()
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", f"/Scripting/Script{script_id}", "run"],
            capture_output=True,
            timeout=2
        )
        subprocess.run(
            [qdbus_bin, "org.kde.KWin", "/Scripting", "unloadScript", script_name],
            capture_output=True,
            timeout=2
        )
        return True
    except Exception as e:
        print(f"[KWIN] Focus idle terminal error: {e}", flush=True)
        return False
    finally:
        if tmp_file and os.path.exists(tmp_file):
            try:
                os.unlink(tmp_file)
            except Exception:
                pass

def dispatch_hotkey(hotkey_label, cfg_entry, default_entry):
    """
    Executes a configurable hotkey action based on ~/.config/legion/config.jsonc (or config.json).
    Supports two clean modes:
      1. 'exec' / 'cycle' : Directly runs the command (e.g. lcolor cycle, lhz toggle, spectacle).
      2. 'toggle'         : Smart process & window toggle.
                            - If not running -> launches 'exec'.
                            - If running but obscured -> brings window to front & focuses.
                            - If running and already active -> handles via 'on_active' ('close'/'minimize'/'none').
    cfg_entry can be:
      - A dict: {"action": "toggle", "exec": "...", "process": "...", "on_active": "close"|"minimize"|"none", "match": "full"|"exact"}
      - A string: "lcolor cycle" or "alacritty -e nvtop"
      - None: falls back to default_entry
    """
    reap_zombies()
    ensure_gui_environment()
    entry = cfg_entry if cfg_entry is not None else default_entry

    if isinstance(entry, dict):
        action = entry.get("action", "").strip().lower()
        cmd = entry.get("exec", "").strip()
        proc_name = entry.get("process", "").strip() or None
        match_type = entry.get("match", "auto").strip().lower()
    elif isinstance(entry, str):
        cmd = entry.strip()
        action = ""
        proc_name = None
        match_type = "auto"
    else:
        return

    KNOWN_TERMINALS = ("alacritty", "kitty", "foot", "ghostty", "konsole", "wezterm", "xterm")
    args = shlex.split(cmd) if cmd else []
    cmd_base = os.path.basename(args[0]).lower() if args else ""

    if not action:
        action = "smart_terminal" if cmd_base in KNOWN_TERMINALS else "exec"

    if not cmd or cmd.lower() in ("disabled", "none", "off", "false"):
        return

    if cmd.startswith("lcolor") and os.path.isfile(LCOLOR_BIN):
        cmd = cmd.replace("lcolor", LCOLOR_BIN, 1)
    elif cmd.startswith("lhz") and os.path.isfile(LHZ_BIN):
        cmd = cmd.replace("lhz", LHZ_BIN, 1)

    if action in ("smart_terminal", "smart_spawn"):
        global _last_terminal_spawn, _pending_spawn_pid
        now = time.monotonic()

        # 1. Debounce protection (< 1.2s between rapid presses)
        if now - _last_terminal_spawn < 1.2:
            print(f"[{hotkey_label}] Terminal spawn debounce (< 1.2s), ignoring duplicate press.", flush=True)
            return

        # 2. Check if a previously spawned terminal is still in its startup phase
        if check_pending_spawn(now):
            print(f"[{hotkey_label}] Terminal spawn still in progress (PID {_pending_spawn_pid}), ignoring duplicate press.", flush=True)
            return

        target_proc = proc_name or (cmd_base if cmd_base in KNOWN_TERMINALS else "alacritty")
        idle_entries = get_idle_terminals(target_proc)
        if idle_entries:
            _pending_spawn_pid = None
            idle_term_pids = [e["term_pid"] for e in idle_entries]
            print(f"[{hotkey_label}] Found idle terminal(s) {idle_term_pids} ({target_proc}) ➔ Focusing in KWin", flush=True)
            focus_kwin_idle_terminal(idle_term_pids)
        else:
            print(f"[{hotkey_label}] No idle terminal found (all busy or none open) ➔ Spawning new {target_proc} with lstats", flush=True)
            _last_terminal_spawn = now

            # Spawn terminal running lstats, then transitioning to interactive shell
            lstats_bin = os.path.expanduser("~/.local/bin/lstats")
            user_sh = get_user_terminal_shell()
            if os.path.isfile(lstats_bin) and cmd.strip() in ("alacritty", "/usr/bin/alacritty"):
                spawn_cmd = f'{cmd} -e {user_sh} -c "{lstats_bin}; exec {user_sh}"'
            else:
                spawn_cmd = cmd

            spawn_pid = run_executable(spawn_cmd, source_name=hotkey_label)
            _pending_spawn_pid = spawn_pid
        return

    if action == "toggle":
        inner_target = None
        args = shlex.split(cmd) if cmd else []
        if len(args) >= 3 and args[1] in ("-e", "-x", "--command"):
            target = args[2]
            if target in ("bash", "sh", "zsh") and len(args) >= 5 and args[3] in ("-c", "-lc"):
                try:
                    sub_args = shlex.split(args[4])
                    if sub_args:
                        target = sub_args[0]
                except Exception:
                    pass
            inner_target = os.path.basename(target)

        target_proc = inner_target or proc_name or (entry.get("name", "").strip() if isinstance(entry, dict) else None) or (os.path.basename(args[-1]) if args else "")

        pids = find_process_pids(target_proc, match_type=match_type)
        if not pids and proc_name and proc_name != target_proc:
            pids = find_process_pids(proc_name, match_type=match_type)

        if pids:
            on_active = "close"
            if isinstance(entry, dict):
                on_active = entry.get("on_active", "close").strip().lower()

            managed = manage_kwin_window(pids, on_active=on_active)
            if managed:
                print(f"[{hotkey_label}] Managed window for {target_proc!r} (PIDs: {pids}, on_active: {on_active})", flush=True)
            else:
                flag = "-f" if (match_type == "full" or len(target_proc) > 15 or " " in target_proc) else "-x"
                subprocess.run(["pkill", flag, "--", re.escape(target_proc)], check=False)
                print(f"[{hotkey_label}] Toggled OFF: killed {target_proc!r} (mode: {flag})", flush=True)
        else:
            run_executable(cmd, hotkey_label)
    else:
        run_executable(cmd, hotkey_label)

# Guard: prevent multiple picker windows stacking if user holds repeatedly
_menu_open = threading.Event()
_menu_proc = None                    # live Popen handle for the current picker
_menu_proc_lock = threading.Lock()   # protects _menu_proc and _abort_requested
_abort_requested = False             # dismiss was requested before proc was spawned

LEGION_THEME = os.path.expanduser("~/.config/rofi/legion-launcher.rasi")

def _run_picker_proc(cmd, stdin_data=None):
    """Launch a picker subprocess, store its handle, block until done.
    Returns (stdout, returncode). Deadlock-free and handles external termination.

    Fix 1 — deadlock: stderr=DEVNULL prevents the 64 KB OS pipe buffer from
    filling up and blocking the child while Python is stuck on stdout.read().
    communicate() reads stdout/stderr concurrently via internal threads and
    calls wait() — safe even if proc.terminate() is called from another thread.

    Fix 2 — race condition: if a dismiss was requested before we reached Popen
    (i.e. during JSON/config loading), _abort_requested is True and we
    terminate the process immediately after registering it under the lock.
    """
    global _menu_proc, _abort_requested
    ensure_gui_environment()

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if stdin_data is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,  # avoid 64 KB pipe-buffer deadlock
            text=True,
        )
    except Exception as e:
        print(f"[PICKER] Failed to spawn {cmd[0]}: {e}", flush=True)
        return "", -1

    with _menu_proc_lock:
        _menu_proc = proc
        if _abort_requested:
            proc.terminate()
            _abort_requested = False

    try:
        # communicate() handles stdin write + stdout read + wait atomically;
        # returns even if proc was terminated externally mid-flight.
        stdout, _ = proc.communicate(input=stdin_data)
        return stdout, proc.returncode
    except Exception:
        return "", -1
    finally:
        with _menu_proc_lock:
            _menu_proc = None

def _show_rofi(names, lookup):
    """Run rofi -dmenu. Uses Legion theme if present; otherwise rofi's own defaults."""
    rofi_cmd = [
        shutil.which("rofi"), "-dmenu",
        "-i",                   # case-insensitive filter
        "-p", "✦ Quick Launch",
        "-no-custom",           # reject free-text not in list
        "-hover-select",
        "-me-select-entry", "",
        "-me-accept-entry", "MousePrimary",
    ]
    # Only inject our theme if it exists — never silently override a user's own theme
    if os.path.isfile(LEGION_THEME):
        rofi_cmd += ["-theme", LEGION_THEME]

    stdout, returncode = _run_picker_proc(rofi_cmd, stdin_data="\n".join(names))
    selected = stdout.strip()
    if returncode == 0 and selected and selected in lookup:
        run_executable(lookup[selected], f"Candidate [{selected}]")

def _show_kdialog(names, lookup):
    """Fallback menu using kdialog when rofi is not installed."""
    cmd = [shutil.which("kdialog") or "kdialog",
           "--title", "✦ Quick Launch",
           "--menu", "Select Application:"]
    for i, name in enumerate(names, 1):
        cmd += [str(i), name]
    stdout, returncode = _run_picker_proc(cmd)
    tag = stdout.strip()
    index_lookup = {str(i): name for i, name in enumerate(names, 1)}
    if returncode == 0 and tag and tag in index_lookup:
        name = index_lookup[tag]
        if name in lookup:
            run_executable(lookup[name], f"Candidate [{name}]")

def dismiss_copilot_menu():
    """
    Dismisses the open candidate picker menu if running.
    Works even during the brief window before the subprocess is spawned.
    """
    global _abort_requested
    if not _menu_open.is_set():
        return False
    with _menu_proc_lock:
        proc = _menu_proc
        if proc and proc.poll() is None:
            # Proc is live — kill it directly
            proc.terminate()
            print("[COPILOT MENU] Dismissed by Copilot press", flush=True)
        else:
            # Proc not yet spawned (still in config-read window) — mark abort
            _abort_requested = True
            print("[COPILOT MENU] Abort queued (proc not yet live)", flush=True)
    return True

def launch_copilot_menu():
    """
    Spawns picker menu in a background thread.
    - Uses rofi if available (with Legion theme if present, else rofi defaults)
    - Falls back to kdialog if rofi is not installed
    - Subsequent Copilot press (tap or hold) while menu is open → dismisses the picker.
    """
    if _menu_open.is_set():
        dismiss_copilot_menu()
        return

    def _menu_worker():
        _menu_open.set()
        try:
            cfg, err = get_copilot_config()
            if err:
                send_error_osd("Copilot Menu — Config Warning", err)

            candidates = cfg.get("candidates", DEFAULT_CANDIDATES)
            lookup = {}   # name → exec_str (preserve insertion order for kdialog)
            names = []
            for item in candidates:
                name = item.get("name", "Application")
                lookup[name] = item.get("exec", "")
                names.append(name)

            try:
                if shutil.which("rofi"):
                    _show_rofi(names, lookup)
                elif shutil.which("kdialog"):
                    _show_kdialog(names, lookup)
                else:
                    print("[COPILOT MENU] Neither rofi nor kdialog found — install one.", flush=True)
                    send_error_osd("Copilot Menu — No Picker Found",
                                   "Install rofi or kdialog to use the candidate menu.")
            except Exception as e:
                print(f"[COPILOT MENU] Error: {e}", flush=True)
        finally:
            _menu_open.clear()

    threading.Thread(target=_menu_worker, daemon=True).start()

def send_profile_osd(state):
    ensure_gui_environment()
    info = PROFILES.get(state, {
        "title": f"Profile: {state}",
        "msg": "ACPI platform_profile changed",
        "icon_file": "custom.svg",
        "fallback": "preferences-system-power-management"
    })
    
    icon_path = os.path.join(ICON_DIR, info["icon_file"])
    icon = icon_path if os.path.isfile(icon_path) else info["fallback"]

    cmd = [
        "notify-send",
        "-a", "Legion Profile",
        "-i", icon,
        "-h", "string:x-canonical-private-synchronous:legion-profile-osd",
        "-t", "1800",
        info["title"],
        info["msg"]
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

def find_keyboard_fd():
    """Find and open the ITE keyboard event node."""
    if os.path.exists(KBD_SYMLINK):
        target = os.path.realpath(KBD_SYMLINK)
        try:
            fd = os.open(target, os.O_RDONLY | os.O_NONBLOCK)
            return fd, target
        except Exception:
            pass
    for p in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(256)
            fcntl.ioctl(fd, 0x82004506, buf)
            name = buf.split(b"\x00")[0].decode("utf-8", "ignore")
            if "ITE" in name and "Keyboard" in name:
                return fd, p
            os.close(fd)
        except Exception:
            pass
    return None, None

def main():
    ensure_gui_environment()
    try:
        signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    except Exception:
        pass
    poller = select.poll()

    # 1. Register ACPI platform_profile for Fn+Q & lmode
    profile_file = None
    last_profile_state = ""
    if os.path.exists(NODE):
        try:
            profile_file = open(NODE, "r")
            last_profile_state = profile_file.read().strip()
            poller.register(profile_file, select.POLLPRI | select.POLLERR)
        except Exception:
            pass

    # 2. Register Ideapad extra buttons node for Fn+R & Fn+L
    hotkey_fd = None
    if os.path.exists(HOTKEY_NODE):
        try:
            hotkey_fd = os.open(HOTKEY_NODE, os.O_RDONLY | os.O_NONBLOCK)
            poller.register(hotkey_fd, select.POLLIN | select.POLLERR)
        except Exception:
            pass

    # 3. Register ITE Keyboard node for Copilot Key
    kbd_fd, kbd_path = find_keyboard_fd()
    if kbd_fd:
        poller.register(kbd_fd, select.POLLIN | select.POLLERR)
        print(f"[INIT] Successfully hooked keyboard on {kbd_path}", flush=True)
    else:
        print("[INIT] Notice: ITE Keyboard node not accessible without read permissions.", flush=True)

    last_toggle_time = 0
    last_fn_l_time = 0
    last_fn_n_time = 0
    last_tap_time = 0
    copilot_is_hold = False
    last_scancode = 0

    try:
        while True:
            # Sleep indefinitely in kernel wait queue (0% CPU overhead)
            events = poller.poll()
            for fd, event in events:
                # Handle Profile change (Fn+Q)
                if profile_file and fd == profile_file.fileno():
                    profile_file.seek(0)
                    curr = profile_file.read().strip()
                    if curr and curr != last_profile_state:
                        send_profile_osd(curr)
                        last_profile_state = curr

                # Handle Hotkeys (Fn+R & Fn+L)
                elif hotkey_fd and fd == hotkey_fd:
                    while True:
                        try:
                            data = os.read(hotkey_fd, 24)
                            if len(data) < 24:
                                break
                            sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                            
                            # EV_SYN (etype 0) boundary: reset pending scancode
                            if etype == 0:
                                last_scancode = 0

                            # EV_MSC (etype 4) captures raw hardware scancode
                            elif etype == 4:
                                last_scancode = value

                            # EV_KEY (etype 1), value 1 = PRESS
                            elif etype == 1 and value == 1:
                                now = time.time()
                                
                                # Fn + R: Refresh Rate Toggle (Keycode 562)
                                if code == KEY_REFRESH_RATE_TOGGLE:
                                    if now - last_toggle_time > 0.4:
                                        last_toggle_time = now
                                        ensure_gui_environment()
                                        if os.path.isfile(LHZ_BIN):
                                            subprocess.run([LHZ_BIN, "toggle"], check=False)

                                # Fn + L: Display Color Profile Cycle / Configurable Action
                                # Strictly match Fn+L scancodes (0x012c, 0x012b). KEY_UNKNOWN_VPC (240)
                                # is generic and also emitted by Fn+Up (0x0119), Fn+Down (0x011a), etc.
                                elif last_scancode in (SCANCODE_FN_L_A, SCANCODE_FN_L_B):
                                    if now - last_fn_l_time > 0.4:
                                        last_fn_l_time = now
                                        cfg, _ = load_config()
                                        cfg_l = cfg.get("fn_l") if "fn_l" in cfg else cfg.get("fn_l_command")
                                        default_l = {"action": "cycle", "exec": "lcolor cycle"}
                                        dispatch_hotkey("Fn+L", cfg_l, default_l)

                                # Fn + N: Configurable Launcher / Utility
                                elif code == KEY_FN_N or last_scancode == SCANCODE_FN_N:
                                    if now - last_fn_n_time > 0.4:
                                        last_fn_n_time = now
                                        cfg, _ = load_config()
                                        cfg_n = cfg.get("fn_n") if "fn_n" in cfg else cfg.get("fn_n_command")
                                        default_n = {"action": "toggle", "exec": "alacritty -e nvtop", "process": "nvtop"}
                                        dispatch_hotkey("Fn+N", cfg_n, default_n)

                                last_scancode = 0

                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[HOTKEY] Unexpected read error: {e}", flush=True)
                            break

                # Handle Copilot Key (Keycode 193) on ITE Keyboard: Tap vs Hold
                elif kbd_fd and fd == kbd_fd:
                    while True:
                        try:
                            data = os.read(kbd_fd, 24)
                            if len(data) < 24:
                                break
                            sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                            
                            # EV_KEY (etype 1), code 193 (KEY_F23 / Copilot)
                            if etype == 1 and code == KEY_COPILOT:
                                if value == 1:  # PRESS
                                    copilot_is_hold = False
                                elif value == 2:  # REPEAT (Held down >= 250ms)
                                    if not copilot_is_hold:
                                        copilot_is_hold = True
                                        print("[COPILOT] Long press detected ➔ Opening Candidates Menu", flush=True)
                                        launch_copilot_menu()
                                elif value == 0:  # RELEASE
                                    if not copilot_is_hold:
                                        # Short tap
                                        now = time.time()
                                        if now - last_tap_time > 0.3:
                                            last_tap_time = now
                                            if _menu_open.is_set():
                                                dismiss_copilot_menu()
                                            else:
                                                print("[COPILOT] Short tap detected ➔ Dispatching Default Action", flush=True)
                                                cfg, err = get_copilot_config()
                                                if err:
                                                    send_error_osd("Copilot Key — Config Warning", err)
                                                dispatch_hotkey("Copilot Tap", cfg.get("tap"), DEFAULT_COPILOT_CMD)
                                    copilot_is_hold = False

                        except BlockingIOError:
                            break
                        except Exception as e:
                            print(f"[COPILOT] Unexpected read error: {e}", flush=True)
                            break

    except KeyboardInterrupt:
        sys.exit(0)

if __name__ == "__main__":
    main()
