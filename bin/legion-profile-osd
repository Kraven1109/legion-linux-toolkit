#!/usr/bin/env python3
"""
Unified Legion Background Event Daemon
Listens to:
  1. /sys/firmware/acpi/platform_profile (Fn+Q & lmode)
  2. /dev/input/by-path/*-VPC2004:00-event:
     - Keycode 562 (Fn+R ➔ Refresh Rate 240Hz/60Hz)
     - Scancodes 0x012c / 0x012b (Fn+L ➔ Display Color Profile Cycle)
     - Keycode 618 / Scancode 0x012a (Fn+N ➔ Smart Launcher / Utility)
  3. /dev/input/event* (ITE Device 8258 Keyboard):
     - Keycode 193 (Copilot Key):
       * Tap (< 0.3s)   ➔ Smart Terminal / Candidate Launcher
       * Hold (>= 0.3s) ➔ Popup Candidate Menu (Rofi / Kdialog fallback)
  4. NETLINK_KOBJECT_UEVENT (DRM display hotplug listener):
     - Automatically rebinds KDE Plasma 6 brightness control on external unplug
     - DPMS & screen-lock guards prevent wake-up loops during idle standby
     - Deferred recovery automatically recovers brightness when waking/unlocking
Zero polling, sleeps indefinitely in kernel wait queues via select.poll().
"""

import select
import subprocess
import sys
import os
import struct
import time
import glob
import fcntl
import shlex
import shutil
import threading
import re
import tempfile
import signal
import socket
import ctypes
import json

