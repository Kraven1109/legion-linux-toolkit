#!/usr/bin/env bash
set -euo pipefail

# Auto-discover GUI session if running from minimal environment
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
    for s in /run/user/"$UID"/wayland-*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            break
        fi
    done
    export DISPLAY="${DISPLAY:-:0}"
fi

# Dynamically discover the internal eDP panel
get_internal_output() {
    local out=""
    if command -v jq >/dev/null 2>&1; then
        out=$(kscreen-doctor -j 2>/dev/null | jq -r '.outputs[] | select(.connected and .enabled and (.name | startswith("eDP"))) | .name' 2>/dev/null | head -n 1)
    fi
    if [[ -z "$out" || "$out" == "null" ]]; then
        out=$(kscreen-doctor -o 2>/dev/null | grep -oE "eDP-[0-9]+" | head -n 1 || true)
    fi
    echo "${out:-eDP-1}"
}

# Query current active rate on internal display
get_current_rate() {
    local edp
    edp=$(get_internal_output)
    local rate=""
    if command -v jq >/dev/null 2>&1; then
        rate=$(kscreen-doctor -j 2>/dev/null | jq -r --arg out "$edp" '
            .outputs[] | select(.name == $out) as $o |
            $o.modes[] | select((.id | tostring) == ($o.currentModeId | tostring)) | .refreshRate
        ' 2>/dev/null | head -n 1 || true)
    fi
    if [[ -n "$rate" && "$rate" != "null" ]]; then
        printf "%.2f\n" "$rate" 2>/dev/null || echo "$rate"
        return
    fi
    kscreen-doctor -o 2>/dev/null | grep -E "^Output: .* $edp " -A 15 | grep -oE "@[0-9.]+\*" | tr -d '@*' | head -n 1 || true
}

send_osd() {
    local rate="$1"
    if [[ "$rate" == "240" ]]; then
        notify-send -a "Display Refresh Rate" \
            -i "video-display" \
            -h "string:x-canonical-private-synchronous:display-hz" \
            -t 1800 \
            "Refresh Rate: 240 Hz" \
            "⚡ Ultra Smooth • Maximum Gaming Performance"
    else
        notify-send -a "Display Refresh Rate" \
            -i "video-display" \
            -h "string:x-canonical-private-synchronous:display-hz" \
            -t 1800 \
            "Refresh Rate: 60 Hz" \
            "🔋 Battery Saver • Low Power Consumption"
    fi
}

set_rate() {
    local target="$1"
    local edp
    edp=$(get_internal_output)
    local mode_id=""

    if command -v jq >/dev/null 2>&1; then
        if [[ "$target" == "240" ]]; then
            mode_id=$(kscreen-doctor -j 2>/dev/null | jq -r --arg out "$edp" '
                .outputs[] | select(.name == $out) | .modes[] | select((.refreshRate >= 239) and (.refreshRate <= 241) and .size.width == 2560) | .id
            ' 2>/dev/null | head -n 1 || true)
        elif [[ "$target" == "60" ]]; then
            mode_id=$(kscreen-doctor -j 2>/dev/null | jq -r --arg out "$edp" '
                .outputs[] | select(.name == $out) | .modes[] | select((.refreshRate >= 59) and (.refreshRate <= 61) and .size.width == 2560) | .id
            ' 2>/dev/null | head -n 1 || true)
        fi
    fi

    # Fallback to standard known mode IDs if unparsed
    if [[ -z "$mode_id" || "$mode_id" == "null" ]]; then
        mode_id=$([[ "$target" == "240" ]] && echo "1" || echo "2")
    fi

    if [[ "$target" == "240" ]]; then
        kscreen-doctor "output.${edp}.mode.${mode_id}" >/dev/null 2>&1
        send_osd "240"
        echo -e "Switched to: \033[1;32m240 Hz\033[0m (${edp})"
    elif [[ "$target" == "60" ]]; then
        kscreen-doctor "output.${edp}.mode.${mode_id}" >/dev/null 2>&1
        send_osd "60"
        echo -e "Switched to: \033[1;33m60 Hz\033[0m (${edp})"
    else
        echo "[ERROR] Invalid rate: $target. Use 240 or 60." >&2
        exit 1
    fi
}

toggle_rate() {
    local current
    current=$(get_current_rate)
    if [[ "$current" =~ 240 ]]; then
        set_rate "60"
    else
        set_rate "240"
    fi
}

show_status() {
    local edp
    edp=$(get_internal_output)
    local current
    current=$(get_current_rate)
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e " 🖥️  \033[1mDisplay Refresh Rate Controller (lhz)\033[0m"
    echo "────────────────────────────────────────────────────────────────────"
    echo -e "  Internal Panel (${edp}):"
    if [[ "$current" =~ 240 ]]; then
        echo -e "    Active Rate:  \033[1;32m● 240.00 Hz (Max Smoothness)\033[0m"
        echo "    Resolution :  2560x1600 WQXGA OLED @ 240 Hz"
    elif [[ "$current" =~ 60 ]]; then
        echo -e "    Active Rate:  \033[1;33m● 60.00 Hz (Battery Saver)\033[0m"
        echo "    Resolution :  2560x1600 WQXGA OLED @ 60 Hz"
    else
        echo -e "    Active Rate:  $current Hz"
    fi

    # Display external outputs if present
    if command -v jq >/dev/null 2>&1; then
        local ext_lines
        ext_lines=$(kscreen-doctor -j 2>/dev/null | jq -r '
            [.outputs[] | select(.connected and .enabled and (.name | startswith("eDP") | not))] as $ext |
            if ($ext | length) > 0 then
                "────────────────────────────────────────────────────────────────────\n  External Displays (" + (($ext | length) | tostring) + " connected):\n" +
                ([$ext[] |
                    . as $o |
                    ($o.modes[] | select((.id | tostring) == ($o.currentModeId | tostring)) | .refreshRate // 60) as $hz |
                    "    • " + $o.name + ": " + ($o.size.width | tostring) + "x" + ($o.size.height | tostring) + " @ " + (($hz | round) | tostring) + " Hz (Scale " + ($o.scale | tostring) + "x)"
                ] | join("\n"))
            else
                ""
            end
        ' 2>/dev/null || true)
        if [[ -n "$ext_lines" ]]; then
            echo -e "$ext_lines"
        fi
    fi

    echo "────────────────────────────────────────────────────────────────────"
    echo "  Toggle: lhz toggle  |  Direct: lhz 240  or  lhz 60"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

fix_display() {
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e " 🛠️  \033[1mDisplay & Brightness Recovery\033[0m"
    echo "────────────────────────────────────────────────────────────────────"
    echo "  • Diagnosing KDE Plasma 6 PowerDevil & Wayland display outputs..."

    # 1. Restart PowerDevil to rebind backlight controller after display hotplug/unplug
    if systemctl --user is-active plasma-powerdevil.service >/dev/null 2>&1; then
        echo "  • Restarting plasma-powerdevil.service..."
        systemctl --user restart plasma-powerdevil.service
        sleep 0.3
    fi

    # 2. Verify /sys/class/backlight/intel_backlight
    local intel_cur=""
    local intel_max=""
    if [[ -f /sys/class/backlight/intel_backlight/brightness ]]; then
        intel_cur=$(cat /sys/class/backlight/intel_backlight/brightness 2>/dev/null || echo "")
        intel_max=$(cat /sys/class/backlight/intel_backlight/max_brightness 2>/dev/null || echo "")
    fi

    # 3. Query DBus brightness to verify connection
    local dbus_val=""
    if command -v qdbus6 >/dev/null 2>&1; then
        dbus_val=$(qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement/Actions/BrightnessControl org.kde.Solid.PowerManagement.Actions.BrightnessControl.brightness 2>/dev/null || echo "")
    fi

    local rate
    rate=$(get_current_rate)
    echo "────────────────────────────────────────────────────────────────────"
    echo -e "  Display Rate:       \033[1;32m${rate} Hz\033[0m"
    if [[ -n "$intel_cur" && -n "$intel_max" && "$intel_max" -gt 0 ]]; then
        local pct=$(( intel_cur * 100 / intel_max ))
        echo -e "  Hardware Backlight: \033[1;32m${intel_cur}/${intel_max} (${pct}%)\033[0m"
    fi
    if [[ -n "$dbus_val" ]]; then
        echo -e "  PowerDevil DBus:    \033[1;32m${dbus_val}/10000 (Active & Synced)\033[0m"
    fi
    echo -e "  Status:             \033[1;32m✔ Display & Brightness subsystems recovered\033[0m"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    notify-send -a "Legion Toolkit" \
        -i "video-display" \
        -h "string:x-canonical-private-synchronous:display-recovery" \
        -t 2000 \
        "Display & Brightness Recovered" \
        "✔ PowerDevil re-bound to hardware backlight • ${rate} Hz" 2>/dev/null || true
}

cmd="${1:-status}"

case "$cmd" in
    status)
        show_status
        ;;
    toggle)
        toggle_rate
        ;;
    240|high|max)
        set_rate "240"
        ;;
    60|low|save)
        set_rate "60"
        ;;
    fix|--fix|recover)
        fix_display
        ;;
    help|-h|--help)
        echo "Usage: lhz [status|toggle|240|60|fix]"
        ;;
    *)
        echo "[ERROR] Unknown command: $cmd" >&2
        exit 1
        ;;
esac
