#!/usr/bin/env bash
set -euo pipefail

# Auto-discover GUI session if running from minimal environment
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
    for s in /run/user/"$UID"/wayland-*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            break
        fi
    done
    export DISPLAY="${DISPLAY:-:0}"
fi

KSCREEN_JSON_CACHE=""

get_kscreen_json() {
    if [[ -z "$KSCREEN_JSON_CACHE" ]]; then
        KSCREEN_JSON_CACHE=$(kscreen-doctor -j 2>/dev/null || true)
    fi
    printf '%s' "$KSCREEN_JSON_CACHE"
}

# Dynamically discover the target output for refresh rate control:
# 1. If internal eDP panel is connected AND enabled, target internal eDP (240Hz <-> 60Hz).
# 2. If internal eDP is disabled (clamshell / external-only mode), target the primary enabled external display.
get_internal_output() {
    local out=""
    if command -v jq >/dev/null 2>&1; then
        local kjson
        kjson=$(get_kscreen_json)
        if [[ -n "$kjson" ]]; then
            out=$(jq -r '.outputs[] | select(.connected and .enabled and (.name | startswith("eDP"))) | .name' <<< "$kjson" 2>/dev/null | head -n 1)
            if [[ -z "$out" || "$out" == "null" ]]; then
                out=$(jq -r '.outputs[] | select(.connected and (.name | startswith("eDP"))) | .name' <<< "$kjson" 2>/dev/null | head -n 1)
            fi
        fi
    fi
    if [[ -z "$out" || "$out" == "null" ]]; then
        out=$(kscreen-doctor -o 2>/dev/null | grep -oE "eDP-[0-9]+" | head -n 1 || true)
    fi
    echo "${out:-eDP-1}"
}

get_target_output() {
    local edp
    edp=$(get_internal_output)
    if is_internal_enabled "$edp"; then
        echo "$edp"
        return
    fi
    if command -v jq >/dev/null 2>&1; then
        local kjson ext
        kjson=$(get_kscreen_json)
        if [[ -n "$kjson" ]]; then
            ext=$(jq -r '[.outputs[] | select(.connected and .enabled)] | sort_by(.priority // 99) | .[0].name // empty' <<< "$kjson" 2>/dev/null | head -n 1 || true)
            if [[ -n "$ext" && "$ext" != "null" ]]; then
                echo "$ext"
                return
            fi
        fi
    fi
    echo "$edp"
}

is_internal_enabled() {
    local edp="$1"
    if command -v jq >/dev/null 2>&1; then
        local kjson en
        kjson=$(get_kscreen_json)
        en=$(jq -r --arg out "$edp" '.outputs[] | select(.name == $out) | .enabled' <<< "$kjson" 2>/dev/null | head -n 1 || true)
        [[ "$en" == "true" ]]
        return
    fi
    return 0
}

# Query current active rate on internal display
get_current_rate() {
    local edp="${1:-}"
    [[ -z "$edp" ]] && edp=$(get_internal_output)
    local rate=""
    if command -v jq >/dev/null 2>&1; then
        local kjson
        kjson=$(get_kscreen_json)
        rate=$(jq -r --arg out "$edp" '
            .outputs[] | select(.name == $out) as $o |
            $o.modes[] | select((.id | tostring) == ($o.currentModeId | tostring)) | .refreshRate
        ' <<< "$kjson" 2>/dev/null | head -n 1 || true)
    fi
    if [[ -n "$rate" && "$rate" != "null" ]]; then
        printf "%.2f\n" "$rate" 2>/dev/null || echo "$rate"
        return
    fi
    kscreen-doctor -o 2>/dev/null | grep -E "^Output: .* $edp " -A 15 | grep -oE "@[0-9.]+\*" | tr -d '@*' | head -n 1 || true
}

send_osd() {
    local rate="$1"
    local out="${2:-}"
    local rate_int
    rate_int=$(printf "%.0f" "$rate" 2>/dev/null || echo "$rate")
    local suffix=""
    [[ -n "$out" ]] && suffix=" (${out})"
    if [[ "$rate_int" -ge 100 ]]; then
        notify-send -a "Display Refresh Rate" \
            -i "video-display" \
            -h "string:x-canonical-private-synchronous:display-hz" \
            -t 1800 \
            "Refresh Rate: ${rate_int} Hz${suffix}" \
            "⚡ High Refresh Rate • Smooth Motion Active"
    else
        notify-send -a "Display Refresh Rate" \
            -i "video-display" \
            -h "string:x-canonical-private-synchronous:display-hz" \
            -t 1800 \
            "Refresh Rate: ${rate_int} Hz${suffix}" \
            "🔋 Standard Rate • Reduced Power Consumption"
    fi
}

# Cycle available refresh rates at the active resolution on any output (external or internal)
cycle_output_rate() {
    local out="$1"
    local target_dir="${2:-cycle}" # cycle | high | low
    if ! command -v jq >/dev/null 2>&1; then
        return 1
    fi
    local kjson
    kjson=$(get_kscreen_json)
    local selection
    selection=$(jq -r --arg out "$out" --arg dir "$target_dir" '
        .outputs[] | select(.name == $out) as $o |
        ($o.modes[] | select((.id | tostring) == ($o.currentModeId | tostring))) as $cur |
        [
            $o.modes[]
            | select(.size.width == $cur.size.width and .size.height == $cur.size.height)
            | {id: (.id | tostring), hz: .refreshRate, r_hz: (.refreshRate | round)}
        ]
        | sort_by(-.hz)
        | unique_by(.r_hz)
        | sort_by(-.hz) as $modes |
        if ($modes | length) == 0 then
            ""
        elif $dir == "high" then
            "\($modes[0].id)|\($modes[0].hz)"
        elif $dir == "low" then
            "\($modes[-1].id)|\($modes[-1].hz)"
        else
            ($cur.refreshRate | round) as $cur_r |
            ([range(0; $modes | length) | select($modes[.].r_hz == $cur_r)] | first // 0) as $idx |
            (($idx + 1) % ($modes | length)) as $next_idx |
            "\($modes[$next_idx].id)|\($modes[$next_idx].hz)"
        end
    ' <<< "$kjson" 2>/dev/null | head -n 1 || true)

    if [[ -z "$selection" || "$selection" == "null" ]]; then
        echo "[ERROR] Could not resolve refresh rate modes for ${out}." >&2
        exit 1
    fi

    local mode_id="${selection%%|*}"
    local new_hz="${selection##*|}"
    local new_hz_fmt
    new_hz_fmt=$(printf "%.2f" "$new_hz" 2>/dev/null || echo "$new_hz")
    local new_hz_int
    new_hz_int=$(printf "%.0f" "$new_hz" 2>/dev/null || echo "$new_hz")

    kscreen-doctor "output.${out}.mode.${mode_id}" >/dev/null 2>&1
    send_osd "$new_hz" "$out"
    if [[ "$new_hz_int" -ge 100 ]]; then
        echo -e "Switched to: \033[1;32m${new_hz_fmt} Hz\033[0m (${out})"
    else
        echo -e "Switched to: \033[1;33m${new_hz_fmt} Hz\033[0m (${out})"
    fi
}

set_rate() {
    local target="$1"
    local out
    out=$(get_target_output)

    if [[ ! "$out" =~ ^eDP ]]; then
        if [[ "$target" == "240" ]]; then
            cycle_output_rate "$out" "high"
        else
            cycle_output_rate "$out" "low"
        fi
        return
    fi

    local edp="$out"
    local mode_id=""

    if command -v jq >/dev/null 2>&1; then
        local kjson
        kjson=$(get_kscreen_json)
        if [[ "$target" == "240" ]]; then
            mode_id=$(jq -r --arg out "$edp" '
                .outputs[] | select(.name == $out) | .modes[] | select((.refreshRate >= 239) and (.refreshRate <= 241) and .size.width == 2560) | .id
            ' <<< "$kjson" 2>/dev/null | head -n 1 || true)
        elif [[ "$target" == "60" ]]; then
            mode_id=$(jq -r --arg out "$edp" '
                .outputs[] | select(.name == $out) | .modes[] | select((.refreshRate >= 59) and (.refreshRate <= 61) and .size.width == 2560) | .id
            ' <<< "$kjson" 2>/dev/null | head -n 1 || true)
        fi
    fi

    # Fallback to standard known mode IDs if unparsed
    if [[ -z "$mode_id" || "$mode_id" == "null" ]]; then
        mode_id=$([[ "$target" == "240" ]] && echo "1" || echo "2")
    fi

    if [[ "$target" == "240" ]]; then
        kscreen-doctor "output.${edp}.mode.${mode_id}" >/dev/null 2>&1
        send_osd "240" "$edp"
        echo -e "Switched to: \033[1;32m240 Hz\033[0m (${edp})"
    elif [[ "$target" == "60" ]]; then
        kscreen-doctor "output.${edp}.mode.${mode_id}" >/dev/null 2>&1
        send_osd "60" "$edp"
        echo -e "Switched to: \033[1;33m60 Hz\033[0m (${edp})"
    else
        echo "[ERROR] Invalid rate: $target. Use 240 or 60." >&2
        exit 1
    fi
}

toggle_rate() {
    local out
    out=$(get_target_output)
    if [[ ! "$out" =~ ^eDP ]]; then
        cycle_output_rate "$out" "cycle"
        return
    fi
    local current
    current=$(get_current_rate "$out")
    if [[ "$current" =~ 240 ]]; then
        set_rate "60"
    else
        set_rate "240"
    fi
}

show_status() {
    local edp
    edp=$(get_internal_output)
    local current
    current=$(get_current_rate "$edp")
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e " 🖥️  \033[1mDisplay Refresh Rate Controller (lhz)\033[0m"
    echo "────────────────────────────────────────────────────────────────────"
    echo -e "  Internal Panel (${edp}):"
    if ! is_internal_enabled "$edp"; then
        echo -e "    State:        \033[0;90m● Disabled (Lid Closed / External Only)\033[0m"
        echo "    Last Rate:    ${current:-N/A} Hz (2560x1600 WQXGA OLED)"
    elif [[ "$current" =~ 240 ]]; then
        echo -e "    Active Rate:  \033[1;32m● 240.00 Hz (Max Smoothness)\033[0m"
        echo "    Resolution :  2560x1600 WQXGA OLED @ 240 Hz"
    elif [[ "$current" =~ 60 ]]; then
        echo -e "    Active Rate:  \033[1;33m● 60.00 Hz (Battery Saver)\033[0m"
        echo "    Resolution :  2560x1600 WQXGA OLED @ 60 Hz"
    else
        echo -e "    Active Rate:  $current Hz"
    fi

    # Display external outputs if present
    if command -v jq >/dev/null 2>&1; then
        local ext_lines kjson
        kjson=$(get_kscreen_json)
        ext_lines=$(jq -r '
            [.outputs[] | select(.connected and .enabled and (.name | startswith("eDP") | not))] as $ext |
            if ($ext | length) > 0 then
                "────────────────────────────────────────────────────────────────────\n  External Displays (" + (($ext | length) | tostring) + " connected):\n" +
                ([$ext[] |
                    . as $o |
                    ($o.modes[] | select((.id | tostring) == ($o.currentModeId | tostring)) | .refreshRate // 60) as $hz |
                    "    • " + $o.name + ": " + ($o.size.width | tostring) + "x" + ($o.size.height | tostring) + " @ " + (($hz | round) | tostring) + " Hz (Scale " + ($o.scale | tostring) + "x)"
                ] | join("\n"))
            else
                ""
            end
        ' <<< "$kjson" 2>/dev/null || true)
        if [[ -n "$ext_lines" ]]; then
            echo -e "$ext_lines"
        fi
    fi

    echo "────────────────────────────────────────────────────────────────────"
    echo "  Toggle: lhz toggle  |  Direct: lhz 240  or  lhz 60"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

fix_display() {
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e " 🛠️  \033[1mDisplay & Brightness Recovery (lhz fix)\033[0m"
    echo "────────────────────────────────────────────────────────────────────"
    echo "  • Diagnosing KDE Plasma 6 PowerDevil & Wayland display outputs..."

    # 1. Refresh KScreen JSON cache and check for "all displays disabled" lockout
    KSCREEN_JSON_CACHE=""
    local edp
    edp=$(get_internal_output)
    if command -v jq >/dev/null 2>&1; then
        local kjson enabled_count edp_connected
        kjson=$(get_kscreen_json)
        if [[ -n "$kjson" ]]; then
            enabled_count=$(jq -r '[.outputs[] | select(.connected and .enabled)] | length' <<< "$kjson" 2>/dev/null || echo "1")
            edp_connected=$(jq -r --arg out "$edp" '.outputs[] | select(.name == $out) | .connected' <<< "$kjson" 2>/dev/null | head -n 1 || echo "false")
            if [[ "$enabled_count" == "0" && "$edp_connected" == "true" ]]; then
                echo "  • No enabled display output detected! Re-enabling internal panel (${edp})..."
                kscreen-doctor "output.${edp}.enable" >/dev/null 2>&1 || true
                KSCREEN_JSON_CACHE=""
            fi
        fi
    fi

    # 2. Restart or start PowerDevil to rebind backlight controller after display hotplug/unplug
    echo "  • Restarting plasma-powerdevil.service..."
    systemctl --user restart plasma-powerdevil.service 2>/dev/null || true

    # 3. Dynamically detect active hardware backlight node (intel_backlight, nvidia_0, etc.)
    local bl_name=""
    local bl_cur=""
    local bl_max=""
    local bl_dir=""
    for candidate in /sys/class/backlight/intel_backlight /sys/class/backlight/nvidia_* /sys/class/backlight/*; do
        if [[ -d "$candidate" && -f "$candidate/brightness" && -f "$candidate/max_brightness" ]]; then
            bl_dir="$candidate"
            bl_name="$(basename "$candidate")"
            bl_cur=$(cat "$candidate/brightness" 2>/dev/null || echo "")
            bl_max=$(cat "$candidate/max_brightness" 2>/dev/null || echo "")
            break
        fi
    done

    # Guard against 0-brightness black-screen trap when internal panel is enabled
    if [[ -n "$bl_dir" && -n "$bl_cur" && -n "$bl_max" && "$bl_cur" -eq 0 && "$bl_max" -gt 0 ]] && is_internal_enabled "$edp"; then
        local safe_bl=$(( bl_max * 25 / 100 ))
        echo "  • Hardware backlight was at 0% — restoring safe visibility (${safe_bl}/${bl_max})..."
        if [[ -w "$bl_dir/brightness" ]]; then
            echo "$safe_bl" > "$bl_dir/brightness" 2>/dev/null || true
            bl_cur="$safe_bl"
        fi
    fi

    # 4. Poll PowerDevil DBus Readiness (up to 2.0s in 100ms steps instead of fixed blind sleep)
    # Note: qdbus6 prints DBus errors (e.g. UnknownObject while PowerDevil initializes) to stdout,
    # so we strictly validate that the returned value is an integer.
    local dbus_val=""
    local dbus_max=""
    if command -v qdbus6 >/dev/null 2>&1; then
        for _ in {1..20}; do
            local candidate_val
            candidate_val=$(qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement/Actions/BrightnessControl org.kde.Solid.PowerManagement.Actions.BrightnessControl.brightness 2>/dev/null || true)
            if [[ "$candidate_val" =~ ^[0-9]+$ ]]; then
                dbus_val="$candidate_val"
                local candidate_max
                candidate_max=$(qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement/Actions/BrightnessControl org.kde.Solid.PowerManagement.Actions.BrightnessControl.brightnessMax 2>/dev/null || true)
                if [[ "$candidate_max" =~ ^[0-9]+$ ]]; then
                    dbus_max="$candidate_max"
                else
                    dbus_max="10000"
                fi
                break
            fi
            sleep 0.1
        done
    fi

    local target_out
    target_out=$(get_target_output)
    local rate
    rate=$(get_current_rate "$target_out")
    echo "────────────────────────────────────────────────────────────────────"
    echo -e "  Active Output:      \033[1;36m${target_out}\033[0m (\033[1;32m${rate} Hz\033[0m)"
    if [[ -n "$bl_cur" && -n "$bl_max" && "$bl_max" -gt 0 ]]; then
        local pct=$(( bl_cur * 100 / bl_max ))
        echo -e "  Hardware Backlight: \033[1;32m${bl_cur}/${bl_max} (${pct}%)\033[0m [${bl_name}]"
    fi
    if [[ -n "$dbus_val" ]]; then
        echo -e "  PowerDevil DBus:    \033[1;32m${dbus_val}/${dbus_max:-10000} (Active & Synced)\033[0m"
    else
        echo -e "  PowerDevil DBus:    \033[1;33mRebinding in background...\033[0m"
    fi
    echo -e "  Status:             \033[1;32m✔ Display & Brightness subsystems recovered\033[0m"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    notify-send -a "Legion Toolkit" \
        -i "video-display" \
        -h "string:x-canonical-private-synchronous:display-recovery" \
        -t 2000 \
        "Display & Brightness Recovered" \
        "✔ PowerDevil re-bound (${bl_name:-backlight}) • ${target_out} @ ${rate} Hz" 2>/dev/null || true
}

cmd="${1:-status}"

case "$cmd" in
    status)
        show_status
        ;;
    toggle)
        toggle_rate
        ;;
    240|high|max)
        set_rate "240"
        ;;
    60|low|save)
        set_rate "60"
        ;;
    fix|--fix|recover)
        fix_display
        ;;
    help|-h|--help)
        echo "Usage: lhz [status|toggle|240|60|fix]"
        ;;
    *)
        echo "[ERROR] Unknown command: $cmd" >&2
        exit 1
        ;;
esac
