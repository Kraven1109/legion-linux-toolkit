#!/usr/bin/env python3
"""
Lenovo Legion Hotkey Event Detector & Sniffer
Part of legion-linux-toolkit
"""

import os
import sys
import glob
import struct
import select
import time
import fcntl
import argparse

# Common Linux evdev key mappings for laptop vendor keys
KEY_NAMES = {
    15: "KEY_TAB",
    28: "KEY_ENTER",
    29: "KEY_LEFTCTRL",
    46: "KEY_C",
    47: "KEY_V",
    56: "KEY_LEFTALT",
    102: "KEY_HOME (Fn + Left Arrow)",
    107: "KEY_END (Fn + Right Arrow)",
    119: "KEY_PAUSE",
    142: "KEY_SLEEP",
    148: "KEY_PROG1",
    149: "KEY_PROG2",
    190: "KEY_F16",
    191: "KEY_F17",
    192: "KEY_F18",
    193: "KEY_F23 (Copilot Key)",
    194: "KEY_F20",
    224: "KEY_BRIGHTNESSDOWN",
    225: "KEY_BRIGHTNESSUP",
    240: "KEY_UNKNOWN_VPC (Generic VPC code)",
    248: "KEY_MICMUTE",
    562: "KEY_REFRESH_RATE_TOGGLE (Fn + R)",
    618: "KEY_NOTIFICATION_CENTER (Fn + N)",
}

# Verified hardware scancodes on Lenovo Legion Pro 7 (16IAX10H) VPC2004 platform
VPC_SCANCODES = {
    # Fn + R: Refresh Rate Toggle
    0x0110: "Fn + R (Refresh Rate Toggle: 240Hz <-> 60Hz)",

    # Fn + Up / Down: Keyboard Backlight Brightness Levels (Firmware EC controlled)
    0x0118: "Fn + Down (Keyboard Backlight: Off / Level 0)",
    0x0119: "Fn + Up/Down (Keyboard Backlight: Low / Level 1)",
    0x011a: "Fn + Up/Down (Keyboard Backlight: Medium / Level 2)",
    0x0126: "Fn + Up (Keyboard Backlight: Max / Level 3)",

    # Fn + Space: Keyboard RGB Backlight Profile Cycle (Firmware EC controlled)
    0x0120: "Fn + Space (Keyboard RGB Profile 1)",
    0x0121: "Fn + Space (Keyboard RGB Profile 2)",
    0x0122: "Fn + Space (Keyboard RGB Profile 3)",
    0x0123: "Fn + Space (Keyboard RGB Profile 4)",
    0x0124: "Fn + Space (Keyboard RGB Profile 5)",
    0x0125: "Fn + Space (Keyboard RGB Profile 6)",

    # Fn + N: Smart Launcher / Utility
    0x012a: "Fn + N (Smart Launcher / Utility)",

    # Fn + L: Color Profile Cycler (Repurposed from Lid Logo)
    0x012b: "Fn + L (Color Profile Cycle / Logo Off)",
    0x012c: "Fn + L (Color Profile Cycle / Logo On)",
}

def main():
    parser = argparse.ArgumentParser(
        description="Lenovo Legion Hardware Hotkey Sniffer & Event Discovery Tool"
    )
    parser.add_argument(
        "-t", "--timeout",
        type=int,
        default=10,
        help="Listening timeout in seconds (default: 10s, use 0 for infinite until Ctrl+C)"
    )
    parser.add_argument(
        "-d", "--device",
        type=str,
        default=None,
        help="Filter device name or path (e.g., 'Ideapad' or '/dev/input/event9')"
    )
    parser.add_argument(
        "--only-press",
        action="store_true",
        help="Only display key PRESS events (ignore release & repeat)"
    )
    args = parser.parse_args()

    # Discover accessible input devices
    fds = []
    names = {}
    
    # Check by-path first for clean hardware naming
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(256)
            try:
                fcntl.ioctl(fd, 0x82004506, buf)
                dev_name = buf.split(b'\x00')[0].decode("utf-8", "ignore")
            except Exception:
                dev_name = "Unknown"

            if args.device:
                if args.device.lower() not in dev_name.lower() and args.device not in path:
                    os.close(fd)
                    continue

            fds.append(fd)
            names[fd] = f"{os.path.basename(path)}: {dev_name}"
        except PermissionError:
            pass
        except Exception:
            pass

    if not fds:
        print("\n❌ Permission denied: Cannot read accessible /dev/input/event* devices.")
        print("👉 Run with sudo to scan all raw devices: sudo test-hotkey")
        print("👉 Note: Lenovo VPC2004 extra buttons are accessible without sudo if tmpfiles.d is loaded.\n")
        sys.exit(1)

    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("🔍 LENOVO HARDWARE HOTKEY EVENT DETECTOR")
    if args.timeout > 0:
        print(f"⏱️  Listening for {args.timeout} seconds (press Ctrl+C to cancel)...")
    else:
        print("⏱️  Listening indefinitely (press Ctrl+C to exit)...")
    print("👉 Press any Fn hotkeys now (e.g. Fn+R, Fn+F9, Copilot, etc.)...")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    start_time = time.time()
    events_found = 0

    try:
        while True:
            if args.timeout > 0:
                elapsed = time.time() - start_time
                remaining = args.timeout - elapsed
                if remaining <= 0:
                    break
                timeout_select = min(0.5, remaining)
            else:
                timeout_select = 0.5

            r, _, _ = select.select(fds, [], [], timeout_select)
            for fd in r:
                while True:
                    try:
                        data = os.read(fd, 24)
                        if len(data) < 24:
                            break
                        sec, usec, etype, code, value = struct.unpack("qqHHI", data)
                        
                        if etype == 1:  # EV_KEY
                            if args.only_press and value != 1:
                                continue
                            state = "PRESS" if value == 1 else ("RELEASE" if value == 0 else "REPEAT")
                            key_sym = KEY_NAMES.get(code, f"CODE_{code}")
                            print(f"  [KEY EVENT] {names[fd]} ➔ Code: {code:3d} (0x{code:04x}) [{key_sym}] | Action: {state}")
                            events_found += 1
                        elif etype == 4:  # EV_MSC
                            annotation = f" [{VPC_SCANCODES[value]}]" if value in VPC_SCANCODES else ""
                            print(f"  [RAW SCAN]  {names[fd]} ➔ Scancode: 0x{value:04x}{annotation}")
                            events_found += 1
                    except BlockingIOError:
                        break
    except KeyboardInterrupt:
        print("\n🛑 Stopped by user.")

    # Cleanup
    for fd in fds:
        try:
            os.close(fd)
        except Exception:
            pass

    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    if events_found > 0:
        print(f"✅ Capture finished: {events_found} hardware events captured.")
    else:
        print("⏱️  Timeout reached: No hardware events captured.")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

if __name__ == "__main__":
    main()
