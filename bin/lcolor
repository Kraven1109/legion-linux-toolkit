#!/usr/bin/env python3
"""
lcolor — Native Display Color Profile Manager for Lenovo Legion Pro 7 (16IAX10H)
Target Panel: Samsung Display OLED 2.5K 240Hz (SDC420B)

Enforces hardware panel matching via EDID before applying factory-calibrated
color profiles through KDE Plasma 6 Wayland's kscreen-doctor.
"""

import os
import sys
import glob
import json
import shutil
import subprocess

EXPECTED_PANEL_ID = "SDC420B"
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PROJECT_DIR = os.path.realpath(os.path.join(SCRIPT_DIR, ".."))

PROFILES = [
    {
        "id": "srgb",
        "name": "sRGB",
        "file": "TPLCD_420B_sRGB.icm",
        "title": "sRGB (Standard Color)",
        "desc": "Web & Office • Clamped Gamut • Accurate Colors",
    },
    {
        "id": "displayp3",
        "name": "Display P3",
        "file": "TPLCD_420B_DisplayP3.icm",
        "title": "Display P3 (Wide Gamut)",
        "desc": "Modern Media & Apple Standard • Rich Vibrant Gamut",
    },
    {
        "id": "dcip3",
        "name": "DCI-P3",
        "file": "TPLCD_420B_DCIP3.icm",
        "title": "DCI-P3 (Digital Cinema)",
        "desc": "Theatrical & Movie Production • DCI Color Space",
    },
    {
        "id": "adobergb",
        "name": "Adobe RGB",
        "file": "TPLCD_420B_AdobeRGB.icm",
        "title": "Adobe RGB (Print & Photo)",
        "desc": "Expanded Cyan-Green Range • Professional Publishing",
    },
    {
        "id": "rec709",
        "name": "Rec.709",
        "file": "TPLCD_420B_REC709.icm",
        "title": "Rec.709 (HDTV Broadcast)",
        "desc": "Television & Video Broadcast Standard",
    },
    {
        "id": "native",
        "name": "Native",
        "file": "TPLCD_420B_Native.icm",
        "title": "Native (Full OLED)",
        "desc": "Unclamped OLED Gamut • Maximum Hardware Color Space",
    },
]

def get_panel_info():
    """
    Reads internal eDP display EDID directly from sysfs.
    Extracts Manufacturer ID (bytes 8-9) and Product Code (bytes 10-11).
    Returns (hardware_id, edid_sysfs_path) or (None, None).
    """
    candidates = sorted(glob.glob("/sys/class/drm/*-eDP-*/edid"))
    for edid_path in candidates:
        try:
            with open(edid_path, "rb") as f:
                data = f.read()
            if len(data) >= 128:
                mfg = int.from_bytes(data[8:10], "big")
                c1 = chr(((mfg >> 10) & 0x1F) + ord("A") - 1)
                c2 = chr(((mfg >> 5) & 0x1F) + ord("A") - 1)
                c3 = chr((mfg & 0x1F) + ord("A") - 1)
                prod = int.from_bytes(data[10:12], "little")
                hw_id = f"{c1}{c2}{c3}{prod:04X}"
                return hw_id, edid_path
        except Exception:
            continue
    return None, None

def get_active_display():
    """
    Queries kscreen-doctor -j for the primary connected eDP output.
    Returns (output_name, current_icc_path).
    """
    if not shutil.which("kscreen-doctor"):
        return None, None
    try:
        proc = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, check=True)
        data = json.loads(proc.stdout)
        outputs = data.get("outputs", [])
        for out in outputs:
            if out.get("connected") and out.get("enabled"):
                name = out.get("name", "")
                if name.startswith("eDP") or out.get("priority") == 1:
                    return name, out.get("iccProfilePath") or ""
        # Fallback to first connected output
        for out in outputs:
            if out.get("connected") and out.get("enabled"):
                return out.get("name", "1"), out.get("iccProfilePath") or ""
    except Exception as e:
        print(f"[WARN] Failed to query kscreen-doctor: {e}", file=sys.stderr)
    return "eDP-1", ""

def resolve_profile_path(filename):
    """
    Resolves the absolute path of an ICM profile file.
    Checks ~/.local/share/color/icc/, repo color-profiles/, and local dir.
    """
    search_dirs = [
        os.path.expanduser("~/.local/share/color/icc"),
        os.path.join(PROJECT_DIR, "color-profiles"),
        os.path.join(SCRIPT_DIR, "..", "color-profiles"),
    ]
    for d in search_dirs:
        candidate = os.path.join(d, filename)
        if os.path.isfile(candidate):
            return candidate
    return None

def send_osd(profile):
    """Dispatches a desktop notification with the color profile badge."""
    icon_candidates = [
        os.path.expanduser("~/.local/share/icons/legion/color-profile.svg"),
        os.path.join(PROJECT_DIR, "icons", "color-profile.svg"),
    ]
    icon = "preferences-desktop-display-color"
    for candidate in icon_candidates:
        if os.path.isfile(candidate):
            icon = candidate
            break

    cmd = [
        "notify-send",
        "-a", "Display Color Profile",
        "-i", icon,
        "-h", "string:x-canonical-private-synchronous:display-color",
        "-t", "1800",
        profile["title"],
        profile["desc"],
    ]
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        pass

def verify_hardware_panel():
    """
    Strict panel validation: Ensures the current display hardware ID matches
    the calibration target (SDC420B).
    """
    hw_id, _ = get_panel_info()
    if not hw_id:
        print("[ERROR] Unable to detect internal display EDID. Aborting.", file=sys.stderr)
        sys.exit(1)
    if hw_id != EXPECTED_PANEL_ID:
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", file=sys.stderr)
        print("❌ [HARDWARE SAFETY GUARD] Display Panel Mismatch!", file=sys.stderr)
        print(f"   Detected Panel ID : {hw_id}", file=sys.stderr)
        print(f"   Required Panel ID : {EXPECTED_PANEL_ID} (Samsung 2.5K OLED 240Hz)", file=sys.stderr)
        print("────────────────────────────────────────────────────────────────────", file=sys.stderr)
        print("These ICC profiles were measured and calibrated specifically for the", file=sys.stderr)
        print(f"Lenovo Legion SDC420B panel. Applying them on panel '{hw_id}' would cause", file=sys.stderr)
        print("color distortion. Switching has been safely aborted.", file=sys.stderr)
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", file=sys.stderr)
        sys.exit(1)
    return hw_id

def set_profile(target_key):
    """Applies a specified color profile to the active internal display."""
    verify_hardware_panel()
    target_key = target_key.strip().lower()

    match = None
    for p in PROFILES:
        if p["id"] == target_key or p["name"].lower() == target_key or target_key in p["file"].lower():
            match = p
            break

    if not match:
        print(f"[ERROR] Unknown color profile: '{target_key}'.", file=sys.stderr)
        print("Available profiles:", ", ".join([p["id"] for p in PROFILES]), file=sys.stderr)
        sys.exit(1)

    file_path = resolve_profile_path(match["file"])
    if not file_path:
        print(f"[ERROR] Profile file not found: {match['file']}", file=sys.stderr)
        sys.exit(1)

    output_name, _ = get_active_display()
    if not output_name:
        output_name = "eDP-1"

    cmd = ["kscreen-doctor", f"output.{output_name}.iccprofile.{file_path}"]
    try:
        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError as e:
        print(f"[ERROR] kscreen-doctor failed to apply profile: {e}", file=sys.stderr)
        sys.exit(1)

    send_osd(match)
    print(f"Applied Color Profile: \033[1;32m{match['name']}\033[0m ({match['title']})")
    print(f"  Target File : {file_path}")
    print(f"  Output Port : {output_name}")

def cycle_profile():
    """Cycles sequentially to the next color profile in the defined sequence."""
    verify_hardware_panel()
    _, current_path = get_active_display()

    current_idx = -1
    if current_path:
        current_file = os.path.basename(current_path)
        for idx, p in enumerate(PROFILES):
            if p["file"] == current_file:
                current_idx = idx
                break

    next_idx = (current_idx + 1) % len(PROFILES)
    next_profile = PROFILES[next_idx]
    set_profile(next_profile["id"])

def show_status():
    """Displays current color profile status, active output, and panel ID."""
    hw_id, edid_path = get_panel_info()
    output_name, current_path = get_active_display()

    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(" 🎨 \033[1mDisplay Color Profile Controller (lcolor)\033[0m")
    print("────────────────────────────────────────────────────────────────────")
    if hw_id == EXPECTED_PANEL_ID:
        print(f"  Panel Hardware ID  : \033[1;32m● {hw_id}\033[0m (Samsung 2.5K OLED 240Hz)")
        print("  Hardware Match     : \033[1;32mPASSED (Factory Profiles Verified)\033[0m")
    else:
        print(f"  Panel Hardware ID  : \033[1;31m● {hw_id or 'Unknown'}\033[0m")
        print("  Hardware Match     : \033[1;31mFAILED (Expected: SDC420B)\033[0m")

    print(f"  Output Connector   : {output_name or 'N/A'}")
    
    current_name = "Unknown / System Default"
    current_desc = "No calibrated ICC active"
    if current_path:
        current_file = os.path.basename(current_path)
        for p in PROFILES:
            if p["file"] == current_file:
                current_name = f"\033[1;36m{p['name']}\033[0m ({p['title']})"
                current_desc = p["desc"]
                break

    print(f"  Active Profile     : {current_name}")
    print(f"  Gamut / Usage      : {current_desc}")
    if current_path:
        print(f"  Active Path        : {current_path}")

    print("────────────────────────────────────────────────────────────────────")
    print("  Commands: lcolor cycle  |  lcolor set <name>  |  lcolor list")
    print("  Hotkey  : Fn + L (Cycles: sRGB ➔ Display P3 ➔ DCI-P3 ➔ Adobe RGB...)")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

def list_profiles():
    """Prints a formatted table of all calibrated profiles."""
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(" 📋 \033[1mCalibrated Factory Color Profiles (Samsung OLED SDC420B)\033[0m")
    print("────────────────────────────────────────────────────────────────────")
    for p in PROFILES:
        installed = "✓" if resolve_profile_path(p["file"]) else "✗"
        print(f"  • \033[1;33m{p['id']:<10}\033[0m : \033[1m{p['title']}\033[0m [{installed}]")
        print(f"                 {p['desc']}")
        print(f"                 File: {p['file']}")
    print("────────────────────────────────────────────────────────────────────")
    print("  Usage: lcolor set <id> (e.g. 'lcolor set srgb' or 'lcolor set dcip3')")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

def main():
    if len(sys.argv) < 2:
        show_status()
        sys.exit(0)

    cmd = sys.argv[1].strip().lower()
    if cmd in ("status", "info"):
        show_status()
    elif cmd in ("cycle", "next", "toggle"):
        cycle_profile()
    elif cmd in ("list", "ls"):
        list_profiles()
    elif cmd in ("set", "apply") and len(sys.argv) >= 3:
        set_profile(sys.argv[2])
    elif cmd in [p["id"] for p in PROFILES]:
        set_profile(cmd)
    elif cmd in ("help", "-h", "--help"):
        print("Usage: lcolor [status|cycle|list|set <profile_name>]")
        print("Available profiles:", ", ".join([p["id"] for p in PROFILES]))
    else:
        print(f"[ERROR] Unknown command: '{cmd}'.", file=sys.stderr)
        print("Usage: lcolor [status|cycle|list|set <profile_name>]", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
