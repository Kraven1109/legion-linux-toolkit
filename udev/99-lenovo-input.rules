# Lenovo Legion Pro 7 (16IAX10H) — evdev permissions for Legion toolkit daemon
# Managed by: /etc/udev/rules.d/99-lenovo-input.rules
# DO NOT use /etc/tmpfiles.d/ for /dev/input/ nodes — tmpfiles 'z' flag does NOT follow symlinks.
# udev matches by hardware name at kernel device creation time, before any symlink exists.

# 1. ITE Keyboard (Copilot Key → Keycode 193)
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{name}=="ITE Tech. Inc. ITE Device(8258) Keyboard", MODE="0666"

# 2. Ideapad Extra Buttons (Fn+R → Keycode 562, Fn+L → Scancodes 0x012c/0x012b)
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{name}=="Ideapad extra buttons", MODE="0666"
