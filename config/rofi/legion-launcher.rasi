/**
 * Legion Quick Launcher — Rofi Theme
 * Lenovo Legion Pro 7 (16IAX10H) / CachyOS KDE Plasma 6 Wayland
 *
 * NOTE on rofi border syntax:
 *   WRONG: border: 1px solid @color;   ← CSS shorthand, rofi rejects @ref here
 *   RIGHT: border: 1px;  +  border-color: @color;  ← always split
 */

/* ── Palette (all #RRGGBBAA 8-digit hex for alpha support) ─────────────── */
* {
    bg-window:      #0d0b12f5;   /* 96% opaque deep-black glass              */
    bg-input:       #18142299;   /* input bar slightly lifted surface         */
    bg-alt-row:     #1e183399;   /* alternate row zebra tint                  */
    bg-selected:    #2c1f4acc;   /* selected row filled bg                    */
    accent:         #9d4edd;     /* Legion purple (Extreme mode LED)           */
    accent-border:  #9d4edd99;   /* accent at ~60% — borders                  */
    accent-sel:     #c77dffcc;   /* accent brighter for selected border        */
    urgent:         #e63946cc;   /* error red                                 */
    fg-primary:     #f0eafb;     /* warm white                                */
    fg-secondary:   #b8a8d4;     /* muted lavender — unselected rows          */
    fg-disabled:    #6b5c8a;     /* placeholder / dim                         */

    background-color:   transparent;
    text-color:         @fg-primary;
    border-color:       @accent-border;
}

/* ── Window ─────────────────────────────────────────────────────────────── */
window {
    font:               "Fira Sans 12";
    background-color:   @bg-window;
    border:             1px;
    border-color:       @accent-border;
    border-radius:      18px;
    width:              480px;
    padding:            0px;
}

/* ── Layout ─────────────────────────────────────────────────────────────── */
mainbox {
    padding:            20px 20px 16px 20px;
    spacing:            12px;
    background-color:   transparent;
    children:           [inputbar, listview];
}

/* ── Search bar ─────────────────────────────────────────────────────────── */
inputbar {
    background-color:   @bg-input;
    border:             1px;
    border-color:       @accent-border;
    border-radius:      12px;
    padding:            10px 14px;
    spacing:            10px;
    children:           [prompt, textbox-prompt-colon, entry];
}

prompt {
    font:               "Fira Sans SemiBold 12";
    text-color:         @accent;
    vertical-align:     0.5;
}

textbox-prompt-colon {
    str:                "│";
    text-color:         @fg-disabled;
    vertical-align:     0.5;
    margin:             0px 2px;
}

entry {
    font:               "Fira Sans 12";
    text-color:         @fg-primary;
    placeholder:        "type to filter…";
    placeholder-color:  @fg-disabled;
    vertical-align:     0.5;
}

/* ── Item list ──────────────────────────────────────────────────────────── */
listview {
    lines:              6;
    columns:            1;
    spacing:            3px;
    padding:            2px 0px;
    background-color:   transparent;
    scrollbar:          false;
    dynamic:            true;
}

/* ── Individual row ─────────────────────────────────────────────────────── */
element {
    background-color:   transparent;
    border-radius:      10px;
    padding:            10px 14px;
    spacing:            8px;
    orientation:        horizontal;
    children:           [element-icon, element-text];
}

element-icon {
    size:               18px;
    vertical-align:     0.5;
}

element-text {
    font:               "Fira Sans 12";
    text-color:         @fg-secondary;
    vertical-align:     0.5;
}

/* Normal rows */
element.normal.normal {
    background-color:   transparent;
}
element.normal.normal element-text {
    text-color:         @fg-secondary;
}

/* Alternate rows — subtle zebra */
element.alternate.normal {
    background-color:   @bg-alt-row;
    border-radius:      10px;
}
element.alternate.normal element-text {
    text-color:         @fg-secondary;
}

/* Selected row */
element.selected.normal {
    background-color:   @bg-selected;
    border:             1px;
    border-color:       @accent-sel;
    border-radius:      10px;
}
element.selected.normal element-text {
    font:               "Fira Sans SemiBold 12";
    text-color:         @fg-primary;
}

/* Urgent rows */
element.normal.urgent,
element.alternate.urgent {
    background-color:   #e6394622;
    border:             1px;
    border-color:       @urgent;
    border-radius:      10px;
}
element.selected.urgent {
    background-color:   #e6394644;
    border:             1px;
    border-color:       @urgent;
    border-radius:      10px;
}
element.selected.urgent element-text,
element.normal.urgent element-text {
    text-color:         #ffffff;
}
